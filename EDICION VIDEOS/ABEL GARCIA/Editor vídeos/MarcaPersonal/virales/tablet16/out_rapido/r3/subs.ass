Dialogue: 0,0:00:00.08,0:00:00.45,B,,0,0,0,,{\pos(540,1415)}Gimnasio
Dialogue: 0,0:00:00.45,0:00:00.92,B,,0,0,0,,{\pos(540,1415)}libros
Dialogue: 0,0:00:00.92,0:00:01.83,B,,0,0,0,,{\pos(540,1415)}meditación y aún
Dialogue: 0,0:00:01.83,0:00:02.62,B,,0,0,0,,{\pos(540,1415)}así sigues vacío
Dialogue: 0,0:00:02.62,0:00:03.18,B,,0,0,0,,{\pos(540,1415)}Tu autoestima es como
Dialogue: 0,0:00:03.18,0:00:04.21,B,,0,0,0,,{\pos(540,1415)}una batería y depende
Dialogue: 0,0:00:04.21,0:00:05.04,B,,0,0,0,,{\pos(540,1415)}de lo que cargas
Dialogue: 0,0:00:05.04,0:00:06.15,B,,0,0,0,,{\pos(540,1415)}y de lo que descargas
Dialogue: 0,0:00:06.15,0:00:06.65,B,,0,0,0,,{\pos(540,1415)}Lo que la carga
Dialogue: 0,0:00:06.65,0:00:07.80,B,,0,0,0,,{\pos(540,1415)}es escuchar lo que sientes
Dialogue: 0,0:00:07.80,0:00:09.10,B,,0,0,0,,{\pos(540,1415)}moverte y hacer ejercicio
Dialogue: 0,0:00:09.10,0:00:10.21,B,,0,0,0,,{\pos(540,1415)}momentos de silencio
Dialogue: 0,0:00:10.21,0:00:11.18,B,,0,0,0,,{\pos(540,1415)}Cumplir con tu palabra
Dialogue: 0,0:00:11.18,0:00:11.98,B,,0,0,0,,{\pos(540,1415)}y lo que te prometes
Dialogue: 0,0:00:11.98,0:00:12.83,B,,0,0,0,,{\pos(540,1415)}y rodearte con gente
Dialogue: 0,0:00:12.83,0:00:13.70,B,,0,0,0,,{\pos(540,1415)}que tenga ambición
Dialogue: 0,0:00:13.70,0:00:14.07,B,,0,0,0,,{\pos(540,1415)}y que te sume
Dialogue: 0,0:00:14.07,0:00:14.76,B,,0,0,0,,{\pos(540,1415)}Y lo que te descarga
Dialogue: 0,0:00:14.76,0:00:16.01,B,,0,0,0,,{\pos(540,1415)}es tapar lo que sientes
Dialogue: 0,0:00:16.01,0:00:17.20,B,,0,0,0,,{\pos(540,1415)}fingir que dices que sí
Dialogue: 0,0:00:17.20,0:00:18.33,B,,0,0,0,,{\pos(540,1415)}cuando realmente quieres decir
Dialogue: 0,0:00:18.33,0:00:18.69,B,,0,0,0,,{\pos(540,1415)}que no
Dialogue: 0,0:00:18.69,0:00:19.89,B,,0,0,0,,{\pos(540,1415)}complacer depender siempre
Dialogue: 0,0:00:19.89,0:00:20.72,B,,0,0,0,,{\pos(540,1415)}de que te elijan
Dialogue: 0,0:00:20.72,0:00:21.36,B,,0,0,0,,{\pos(540,1415)}de que te den likes
Dialogue: 0,0:00:21.36,0:00:22.17,B,,0,0,0,,{\pos(540,1415)}de que te validen
Dialogue: 0,0:00:22.17,0:00:23.39,B,,0,0,0,,{\pos(540,1415)}Compararte con los demás
Dialogue: 0,0:00:23.39,0:00:24.35,B,,0,0,0,,{\pos(540,1415)}Y todo lo que consumes
Dialogue: 0,0:00:24.35,0:00:25.43,B,,0,0,0,,{\pos(540,1415)}que modifica tu pensamiento
Dialogue: 0,0:00:25.43,0:00:26.01,B,,0,0,0,,{\pos(540,1415)}y tu energía
Dialogue: 0,0:00:26.01,0:00:26.84,B,,0,0,0,,{\pos(540,1415)}sin que te des cuenta
Dialogue: 0,0:00:26.84,0:00:27.96,B,,0,0,0,,{\pos(540,1415)}Haces mil cosas para ganar
Dialogue: 0,0:00:27.96,0:00:28.35,B,,0,0,0,,{\pos(540,1415)}energía
Dialogue: 0,0:00:28.35,0:00:29.33,B,,0,0,0,,{\pos(540,1415)}como hacer ejercicio
Dialogue: 0,0:00:29.33,0:00:29.91,B,,0,0,0,,{\pos(540,1415)}meditar
Dialogue: 0,0:00:29.91,0:00:30.75,B,,0,0,0,,{\pos(540,1415)}leer libros
Dialogue: 0,0:00:30.75,0:00:31.97,B,,0,0,0,,{\pos(540,1415)}pero no tapas las fugas
Dialogue: 0,0:00:31.97,0:00:32.65,B,,0,0,0,,{\pos(540,1415)}que te hacen perder esa
Dialogue: 0,0:00:32.65,0:00:33.09,B,,0,0,0,,{\pos(540,1415)}energía
Dialogue: 0,0:00:33.09,0:00:33.89,B,,0,0,0,,{\pos(540,1415)}Y por mucho que eleves
Dialogue: 0,0:00:33.89,0:00:34.47,B,,0,0,0,,{\pos(540,1415)}tu energía
Dialogue: 0,0:00:34.47,0:00:35.94,B,,0,0,0,,{\pos(540,1415)}al final siempre acabas vacío
Dialogue: 0,0:00:35.94,0:00:36.54,B,,0,0,0,,{\pos(540,1415)}Te lo digo como alguien
Dialogue: 0,0:00:36.54,0:00:37.16,B,,0,0,0,,{\pos(540,1415)}que lo perdió todo
Dialogue: 0,0:00:37.16,0:00:38.19,B,,0,0,0,,{\pos(540,1415)}a los 26 años
Dialogue: 0,0:00:38.19,0:00:39.79,B,,0,0,0,,{\pos(540,1415)}así que necesitas dos cosas
Dialogue: 0,0:00:39.79,0:00:40.64,B,,0,0,0,,{\pos(540,1415)}Hacer cosas que te eleven
Dialogue: 0,0:00:40.64,0:00:41.21,B,,0,0,0,,{\pos(540,1415)}la energía
Dialogue: 0,0:00:41.21,0:00:42.00,B,,0,0,0,,{\pos(540,1415)}pero sobre todo y más
Dialogue: 0,0:00:42.00,0:00:42.60,B,,0,0,0,,{\pos(540,1415)}importante
Dialogue: 0,0:00:42.60,0:00:43.75,B,,0,0,0,,{\pos(540,1415)}tapar todas las fugas
Dialogue: 0,0:00:43.75,0:00:44.59,B,,0,0,0,,{\pos(540,1415)}que te quitan esa misma
Dialogue: 0,0:00:44.59,0:00:45.01,B,,0,0,0,,{\pos(540,1415)}Y no hace falta
Dialogue: 0,0:00:45.01,0:00:45.69,B,,0,0,0,,{\pos(540,1415)}que cambies toda tu vida
Dialogue: 0,0:00:45.69,0:00:46.03,B,,0,0,0,,{\pos(540,1415)}de golpe
Dialogue: 0,0:00:46.03,0:00:47.32,B,,0,0,0,,{\pos(540,1415)}simplemente ir tapando
Dialogue: 0,0:00:47.32,0:00:48.45,B,,0,0,0,,{\pos(540,1415)}Una a una las fugas
Dialogue: 0,0:00:48.45,0:00:49.30,B,,0,0,0,,{\pos(540,1415)}que más te cuestan
