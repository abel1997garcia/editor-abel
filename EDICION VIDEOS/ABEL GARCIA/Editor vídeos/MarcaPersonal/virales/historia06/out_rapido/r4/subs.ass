Dialogue: 0,0:00:00.05,0:00:00.98,B,,0,0,0,,{\pos(540,1415)}Siempre te estrellas
Dialogue: 0,0:00:00.98,0:00:02.01,B,,0,0,0,,{\pos(540,1415)}en el mismo sitio
Dialogue: 0,0:00:02.01,0:00:03.06,B,,0,0,0,,{\pos(540,1415)}en lo que ves todo
Dialogue: 0,0:00:03.06,0:00:03.57,B,,0,0,0,,{\pos(540,1415)}el puto día
Dialogue: 0,0:00:03.57,0:00:04.57,B,,0,0,0,,{\pos(540,1415)}Para conseguir lo que quieres
Dialogue: 0,0:00:04.57,0:00:05.77,B,,0,0,0,,{\pos(540,1415)}tienes que ser la persona
Dialogue: 0,0:00:05.77,0:00:06.43,B,,0,0,0,,{\pos(540,1415)}que ya lo tiene
Dialogue: 0,0:00:06.43,0:00:07.36,B,,0,0,0,,{\pos(540,1415)}¿Quieres vivir de tu proyecto?
Dialogue: 0,0:00:07.36,0:00:08.26,B,,0,0,0,,{\pos(540,1415)}Te sientas y dices
Dialogue: 0,0:00:08.26,0:00:09.12,B,,0,0,0,,{\pos(540,1415)}¿cómo me voy a sentir
Dialogue: 0,0:00:09.12,0:00:10.56,B,,0,0,0,,{\pos(540,1415)}bien si tengo 100€
Dialogue: 0,0:00:10.56,0:00:11.55,B,,0,0,0,,{\pos(540,1415)}en la cuenta y estoy
Dialogue: 0,0:00:11.55,0:00:12.83,B,,0,0,0,,{\pos(540,1415)}estresado todo el puto día?
Dialogue: 0,0:00:12.83,0:00:13.25,B,,0,0,0,,{\pos(540,1415)}Y ahí se queda
Dialogue: 0,0:00:13.25,0:00:14.12,B,,0,0,0,,{\pos(540,1415)}la mayoría de gente
Dialogue: 0,0:00:14.12,0:00:15.30,B,,0,0,0,,{\pos(540,1415)}chocando con lo que ve
Dialogue: 0,0:00:15.30,0:00:16.63,B,,0,0,0,,{\pos(540,1415)}en su realidad hoy mismo
Dialogue: 0,0:00:16.63,0:00:17.13,B,,0,0,0,,{\pos(540,1415)}Pero tu vida no
Dialogue: 0,0:00:17.13,0:00:18.00,B,,0,0,0,,{\pos(540,1415)}se crea fuera
Dialogue: 0,0:00:18.00,0:00:18.87,B,,0,0,0,,{\pos(540,1415)}tu vida se crea dentro
Dialogue: 0,0:00:18.87,0:00:19.57,B,,0,0,0,,{\pos(540,1415)}en lo que tú crees
Dialogue: 0,0:00:19.57,0:00:20.22,B,,0,0,0,,{\pos(540,1415)}que mereces
Dialogue: 0,0:00:20.22,0:00:20.91,B,,0,0,0,,{\pos(540,1415)}y en lo que crees
Dialogue: 0,0:00:20.91,0:00:21.58,B,,0,0,0,,{\pos(540,1415)}que eres capaz
Dialogue: 0,0:00:21.58,0:00:22.87,B,,0,0,0,,{\pos(540,1415)}Pregúntate realmente cómo
Dialogue: 0,0:00:22.87,0:00:24.25,B,,0,0,0,,{\pos(540,1415)}serías y cómo te comportarías
Dialogue: 0,0:00:24.25,0:00:25.03,B,,0,0,0,,{\pos(540,1415)}si ya vivieras
Dialogue: 0,0:00:25.03,0:00:25.55,B,,0,0,0,,{\pos(540,1415)}de tu sueño
Dialogue: 0,0:00:25.55,0:00:26.87,B,,0,0,0,,{\pos(540,1415)}Estarías mucho más tranquilo
Dialogue: 0,0:00:26.87,0:00:27.78,B,,0,0,0,,{\pos(540,1415)}te comportarías de otra
Dialogue: 0,0:00:27.78,0:00:28.13,B,,0,0,0,,{\pos(540,1415)}manera
Dialogue: 0,0:00:28.13,0:00:29.38,B,,0,0,0,,{\pos(540,1415)}hablarías de otra manera muy
Dialogue: 0,0:00:29.38,0:00:30.03,B,,0,0,0,,{\pos(540,1415)}distinta
Dialogue: 0,0:00:30.03,0:00:30.93,B,,0,0,0,,{\pos(540,1415)}otra pose
Dialogue: 0,0:00:30.93,0:00:32.12,B,,0,0,0,,{\pos(540,1415)}un gasto de golpe no
Dialogue: 0,0:00:32.12,0:00:33.48,B,,0,0,0,,{\pos(540,1415)}te tocaría los cojones tanto
Dialogue: 0,0:00:33.48,0:00:34.58,B,,0,0,0,,{\pos(540,1415)}¿Pensarías en el siguiente
Dialogue: 0,0:00:34.58,0:00:36.04,B,,0,0,0,,{\pos(540,1415)}proyecto o tendrías un entorno
Dialogue: 0,0:00:36.04,0:00:37.16,B,,0,0,0,,{\pos(540,1415)}que realmente te apoye?
Dialogue: 0,0:00:37.16,0:00:37.93,B,,0,0,0,,{\pos(540,1415)}Y todo eso lo puedes
Dialogue: 0,0:00:37.93,0:00:39.47,B,,0,0,0,,{\pos(540,1415)}hacer hoy mismo gratis
Dialogue: 0,0:00:39.47,0:00:40.49,B,,0,0,0,,{\pos(540,1415)}con todo lo que piensas
Dialogue: 0,0:00:40.49,0:00:41.15,B,,0,0,0,,{\pos(540,1415)}sobre ti
Dialogue: 0,0:00:41.15,0:00:42.30,B,,0,0,0,,{\pos(540,1415)}todo lo que sientes sobre
Dialogue: 0,0:00:42.30,0:00:43.21,B,,0,0,0,,{\pos(540,1415)}ti lo que mereces
Dialogue: 0,0:00:43.21,0:00:43.63,B,,0,0,0,,{\pos(540,1415)}lo que piensas
Dialogue: 0,0:00:43.63,0:00:44.29,B,,0,0,0,,{\pos(540,1415)}de la vida
Dialogue: 0,0:00:44.29,0:00:44.91,B,,0,0,0,,{\pos(540,1415)}Y empezarás a ver
Dialogue: 0,0:00:44.91,0:00:46.02,B,,0,0,0,,{\pos(540,1415)}oportunidades que siempre han
Dialogue: 0,0:00:46.02,0:00:46.56,B,,0,0,0,,{\pos(540,1415)}estado ahí
Dialogue: 0,0:00:46.56,0:00:47.60,B,,0,0,0,,{\pos(540,1415)}pero nunca las veías
Dialogue: 0,0:00:47.60,0:00:48.97,B,,0,0,0,,{\pos(540,1415)}porque solo estabas centrado
Dialogue: 0,0:00:48.97,0:00:49.89,B,,0,0,0,,{\pos(540,1415)}en lo que no tenías
Dialogue: 0,0:00:49.89,0:00:50.74,B,,0,0,0,,{\pos(540,1415)}y en lo que te faltaba
Dialogue: 0,0:00:50.74,0:00:51.18,B,,0,0,0,,{\pos(540,1415)}Así que empieza hoy
Dialogue: 0,0:00:51.18,0:00:52.14,B,,0,0,0,,{\pos(540,1415)}y empieza a actuar como
Dialogue: 0,0:00:52.14,0:00:53.39,B,,0,0,0,,{\pos(540,1415)}lo haría esa mejor versión
Dialogue: 0,0:00:53.39,0:00:53.77,B,,0,0,0,,{\pos(540,1415)}de ti
