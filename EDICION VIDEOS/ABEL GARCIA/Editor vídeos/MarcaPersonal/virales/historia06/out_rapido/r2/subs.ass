Dialogue: 0,0:00:26.40,0:00:27.33,B,,0,0,0,,{\pos(540,1415)}te comportarías de otra
Dialogue: 0,0:00:27.33,0:00:27.67,B,,0,0,0,,{\pos(540,1415)}manera
Dialogue: 0,0:00:27.67,0:00:28.92,B,,0,0,0,,{\pos(540,1415)}hablarías de otra manera muy
Dialogue: 0,0:00:28.92,0:00:29.56,B,,0,0,0,,{\pos(540,1415)}distinta
Dialogue: 0,0:00:29.56,0:00:30.47,B,,0,0,0,,{\pos(540,1415)}otra pose
Dialogue: 0,0:00:30.47,0:00:31.65,B,,0,0,0,,{\pos(540,1415)}un gasto de golpe no
Dialogue: 0,0:00:31.65,0:00:33.01,B,,0,0,0,,{\pos(540,1415)}te tocaría los cojones tanto
Dialogue: 0,0:00:33.01,0:00:34.11,B,,0,0,0,,{\pos(540,1415)}¿Pensarías en el siguiente
Dialogue: 0,0:00:34.11,0:00:35.57,B,,0,0,0,,{\pos(540,1415)}proyecto o tendrías un entorno
Dialogue: 0,0:00:35.57,0:00:36.70,B,,0,0,0,,{\pos(540,1415)}que realmente te apoye?
Dialogue: 0,0:00:36.70,0:00:37.48,B,,0,0,0,,{\pos(540,1415)}Y todo eso lo puedes
Dialogue: 0,0:00:37.48,0:00:39.02,B,,0,0,0,,{\pos(540,1415)}hacer hoy mismo gratis
Dialogue: 0,0:00:39.02,0:00:40.04,B,,0,0,0,,{\pos(540,1415)}con todo lo que piensas
Dialogue: 0,0:00:40.04,0:00:40.70,B,,0,0,0,,{\pos(540,1415)}sobre ti
