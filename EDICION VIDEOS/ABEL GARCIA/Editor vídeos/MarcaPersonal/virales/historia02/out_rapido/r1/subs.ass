Dialogue: 0,0:00:00.01,0:00:01.45,B,,0,0,0,,{\pos(540,1415)}La ley de atracción explicada
Dialogue: 0,0:00:01.45,0:00:02.14,B,,0,0,0,,{\pos(540,1415)}fácilmente
Dialogue: 0,0:00:02.14,0:00:03.02,B,,0,0,0,,{\pos(540,1415)}Atraes lo que eres
Dialogue: 0,0:00:03.02,0:00:03.61,B,,0,0,0,,{\pos(540,1415)}y lo que eres
Dialogue: 0,0:00:03.61,0:00:04.48,B,,0,0,0,,{\pos(540,1415)}es lo que piensas
Dialogue: 0,0:00:04.48,0:00:04.70,B,,0,0,0,,{\pos(540,1415)}de ti
Dialogue: 0,0:00:04.70,0:00:06.12,B,,0,0,0,,{\pos(540,1415)}lo que piensas que mereces
Dialogue: 0,0:00:06.12,0:00:06.87,B,,0,0,0,,{\pos(540,1415)}y lo que has vivido
Dialogue: 0,0:00:06.87,0:00:08.15,B,,0,0,0,,{\pos(540,1415)}Te presento a Fulano
Dialogue: 0,0:00:08.15,0:00:08.80,B,,0,0,0,,{\pos(540,1415)}y a Mengano
Dialogue: 0,0:00:08.80,0:00:09.64,B,,0,0,0,,{\pos(540,1415)}Fulano lo pasó mal
Dialogue: 0,0:00:09.64,0:00:10.97,B,,0,0,0,,{\pos(540,1415)}de pequeño y aprendió
Dialogue: 0,0:00:10.97,0:00:11.99,B,,0,0,0,,{\pos(540,1415)}que para que le quieran
Dialogue: 0,0:00:11.99,0:00:13.23,B,,0,0,0,,{\pos(540,1415)}tenía que dar un montón
Dialogue: 0,0:00:13.23,0:00:13.78,B,,0,0,0,,{\pos(540,1415)}Que su valor está
Dialogue: 0,0:00:13.78,0:00:14.37,B,,0,0,0,,{\pos(540,1415)}en lo que hace
Dialogue: 0,0:00:14.37,0:00:15.27,B,,0,0,0,,{\pos(540,1415)}por otros que tenía
Dialogue: 0,0:00:15.27,0:00:16.38,B,,0,0,0,,{\pos(540,1415)}que esforzarse el doble
Dialogue: 0,0:00:16.38,0:00:17.02,B,,0,0,0,,{\pos(540,1415)}que los demás
Dialogue: 0,0:00:17.02,0:00:18.69,B,,0,0,0,,{\pos(540,1415)}y que lo bueno siempre
Dialogue: 0,0:00:18.69,0:00:19.59,B,,0,0,0,,{\pos(540,1415)}era para otros
Dialogue: 0,0:00:19.59,0:00:20.52,B,,0,0,0,,{\pos(540,1415)}Se lo creyó tanto
Dialogue: 0,0:00:20.52,0:00:21.13,B,,0,0,0,,{\pos(540,1415)}que es lo único
Dialogue: 0,0:00:21.13,0:00:22.13,B,,0,0,0,,{\pos(540,1415)}en lo que se fija
Dialogue: 0,0:00:22.13,0:00:23.22,B,,0,0,0,,{\pos(540,1415)}Y la vida le trae
Dialogue: 0,0:00:23.22,0:00:23.97,B,,0,0,0,,{\pos(540,1415)}justo eso
Dialogue: 0,0:00:23.97,0:00:25.05,B,,0,0,0,,{\pos(540,1415)}gente que no le valora
Dialogue: 0,0:00:25.05,0:00:26.36,B,,0,0,0,,{\pos(540,1415)}parejas que no le eligen
Dialogue: 0,0:00:26.36,0:00:27.13,B,,0,0,0,,{\pos(540,1415)}entorno que se ríe
Dialogue: 0,0:00:27.13,0:00:27.65,B,,0,0,0,,{\pos(540,1415)}de él
Dialogue: 0,0:00:27.65,0:00:28.58,B,,0,0,0,,{\pos(540,1415)}Y esas ideas suyas
Dialogue: 0,0:00:28.58,0:00:29.72,B,,0,0,0,,{\pos(540,1415)}que nunca se ha atrevido
Dialogue: 0,0:00:29.72,0:00:31.15,B,,0,0,0,,{\pos(540,1415)}a enseñar por esa creencia
Dialogue: 0,0:00:31.15,0:00:32.48,B,,0,0,0,,{\pos(540,1415)}interna de quién soy yo
Dialogue: 0,0:00:32.48,0:00:33.85,B,,0,0,0,,{\pos(540,1415)}para decir o enseñar esto
Dialogue: 0,0:00:33.85,0:00:34.96,B,,0,0,0,,{\pos(540,1415)}Mengano vivió exactamente
Dialogue: 0,0:00:34.96,0:00:35.63,B,,0,0,0,,{\pos(540,1415)}lo mismo hasta
Dialogue: 0,0:00:35.63,0:00:36.37,B,,0,0,0,,{\pos(540,1415)}que se dio cuenta
Dialogue: 0,0:00:36.37,0:00:37.22,B,,0,0,0,,{\pos(540,1415)}de que él no tenía
Dialogue: 0,0:00:37.22,0:00:38.14,B,,0,0,0,,{\pos(540,1415)}que ganarse nada
Dialogue: 0,0:00:38.14,0:00:39.26,B,,0,0,0,,{\pos(540,1415)}y que le podían querer
Dialogue: 0,0:00:39.26,0:00:40.20,B,,0,0,0,,{\pos(540,1415)}Tal y como era él
Dialogue: 0,0:00:40.20,0:00:41.05,B,,0,0,0,,{\pos(540,1415)}Y empezó a creérselo poco
Dialogue: 0,0:00:41.05,0:00:41.48,B,,0,0,0,,{\pos(540,1415)}a poco
Dialogue: 0,0:00:41.48,0:00:42.89,B,,0,0,0,,{\pos(540,1415)}empezó a tratarse como alguien
Dialogue: 0,0:00:42.89,0:00:44.10,B,,0,0,0,,{\pos(540,1415)}que realmente se quiere
Dialogue: 0,0:00:44.10,0:00:45.31,B,,0,0,0,,{\pos(540,1415)}empezó a enseñar cosas
Dialogue: 0,0:00:45.31,0:00:46.65,B,,0,0,0,,{\pos(540,1415)}que realmente le gustan
Dialogue: 0,0:00:46.65,0:00:47.62,B,,0,0,0,,{\pos(540,1415)}Y la vida le empezó
Dialogue: 0,0:00:47.62,0:00:49.10,B,,0,0,0,,{\pos(540,1415)}a traer exactamente lo mismo
Dialogue: 0,0:00:49.10,0:00:50.30,B,,0,0,0,,{\pos(540,1415)}personas que le respetan
Dialogue: 0,0:00:50.30,0:00:50.96,B,,0,0,0,,{\pos(540,1415)}que le quieren
Dialogue: 0,0:00:50.96,0:00:51.84,B,,0,0,0,,{\pos(540,1415)}que le valoran
Dialogue: 0,0:00:51.84,0:00:53.13,B,,0,0,0,,{\pos(540,1415)}y que pagan por aquello
Dialogue: 0,0:00:53.13,0:00:53.73,B,,0,0,0,,{\pos(540,1415)}que él sabe
Dialogue: 0,0:00:53.73,0:00:54.74,B,,0,0,0,,{\pos(540,1415)}Los dos atraen igual
Dialogue: 0,0:00:54.74,0:00:54.95,B,,0,0,0,,{\pos(540,1415)}de bien
Dialogue: 0,0:00:54.95,0:00:56.16,B,,0,0,0,,{\pos(540,1415)}la diferencia entre uno
Dialogue: 0,0:00:56.16,0:00:56.44,B,,0,0,0,,{\pos(540,1415)}y otro
Dialogue: 0,0:00:56.44,0:00:57.49,B,,0,0,0,,{\pos(540,1415)}es lo que sienten
Dialogue: 0,0:00:57.49,0:00:58.65,B,,0,0,0,,{\pos(540,1415)}en su corazón que merecen
Dialogue: 0,0:00:58.65,0:00:59.53,B,,0,0,0,,{\pos(540,1415)}Y lo que cada uno
Dialogue: 0,0:00:59.53,0:01:00.72,B,,0,0,0,,{\pos(540,1415)}cree de sí mismo cuando
Dialogue: 0,0:01:00.72,0:01:01.10,B,,0,0,0,,{\pos(540,1415)}está solo
Dialogue: 0,0:01:01.10,0:01:01.87,B,,0,0,0,,{\pos(540,1415)}Así que no cambies
Dialogue: 0,0:01:01.87,0:01:02.56,B,,0,0,0,,{\pos(540,1415)}lo que pides
Dialogue: 0,0:01:02.56,0:01:03.68,B,,0,0,0,,{\pos(540,1415)}cambia lo que crees
Dialogue: 0,0:01:03.68,0:01:04.98,B,,0,0,0,,{\pos(540,1415)}en el fondo que mereces
Dialogue: 0,0:01:04.98,0:01:06.11,B,,0,0,0,,{\pos(540,1415)}Y empieza hoy tratándote como
Dialogue: 0,0:01:06.11,0:01:07.70,B,,0,0,0,,{\pos(540,1415)}alguien que ya es suficiente
Dialogue: 0,0:01:07.70,0:01:08.54,B,,0,0,0,,{\pos(540,1415)}Tenga lo que tenga
Dialogue: 0,0:01:08.54,0:01:09.44,B,,0,0,0,,{\pos(540,1415)}o haga lo que haga
