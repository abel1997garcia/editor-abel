Dialogue: 0,0:00:00.00,0:00:00.82,B,,0,0,0,,{\pos(540,1415)}Por esto te rodeas
Dialogue: 0,0:00:00.82,0:00:01.92,B,,0,0,0,,{\pos(540,1415)}de gente que nunca
Dialogue: 0,0:00:01.92,0:00:02.46,B,,0,0,0,,{\pos(540,1415)}te valora
Dialogue: 0,0:00:02.46,0:00:03.33,B,,0,0,0,,{\pos(540,1415)}Atraes lo que eres
Dialogue: 0,0:00:03.33,0:00:03.93,B,,0,0,0,,{\pos(540,1415)}y lo que eres
Dialogue: 0,0:00:03.93,0:00:04.79,B,,0,0,0,,{\pos(540,1415)}es lo que piensas
Dialogue: 0,0:00:04.79,0:00:05.02,B,,0,0,0,,{\pos(540,1415)}de ti
Dialogue: 0,0:00:05.02,0:00:06.44,B,,0,0,0,,{\pos(540,1415)}lo que piensas que mereces
Dialogue: 0,0:00:06.44,0:00:07.18,B,,0,0,0,,{\pos(540,1415)}y lo que has vivido
Dialogue: 0,0:00:07.18,0:00:08.46,B,,0,0,0,,{\pos(540,1415)}Te presento a Fulano
Dialogue: 0,0:00:08.46,0:00:09.11,B,,0,0,0,,{\pos(540,1415)}y a Mengano
Dialogue: 0,0:00:09.11,0:00:09.95,B,,0,0,0,,{\pos(540,1415)}Fulano lo pasó mal
Dialogue: 0,0:00:09.95,0:00:11.30,B,,0,0,0,,{\pos(540,1415)}de pequeño y aprendió
Dialogue: 0,0:00:11.30,0:00:12.31,B,,0,0,0,,{\pos(540,1415)}que para que le quieran
Dialogue: 0,0:00:12.31,0:00:13.54,B,,0,0,0,,{\pos(540,1415)}tenía que dar un montón
Dialogue: 0,0:00:13.54,0:00:14.10,B,,0,0,0,,{\pos(540,1415)}Que su valor está
Dialogue: 0,0:00:14.10,0:00:14.69,B,,0,0,0,,{\pos(540,1415)}en lo que hace
Dialogue: 0,0:00:14.69,0:00:15.60,B,,0,0,0,,{\pos(540,1415)}por otros que tenía
Dialogue: 0,0:00:15.60,0:00:16.71,B,,0,0,0,,{\pos(540,1415)}que esforzarse el doble
Dialogue: 0,0:00:16.71,0:00:17.35,B,,0,0,0,,{\pos(540,1415)}que los demás
Dialogue: 0,0:00:17.35,0:00:19.02,B,,0,0,0,,{\pos(540,1415)}y que lo bueno siempre
Dialogue: 0,0:00:19.02,0:00:19.93,B,,0,0,0,,{\pos(540,1415)}era para otros
Dialogue: 0,0:00:19.93,0:00:20.85,B,,0,0,0,,{\pos(540,1415)}Se lo creyó tanto
Dialogue: 0,0:00:20.85,0:00:21.46,B,,0,0,0,,{\pos(540,1415)}que es lo único
Dialogue: 0,0:00:21.46,0:00:22.47,B,,0,0,0,,{\pos(540,1415)}en lo que se fija
Dialogue: 0,0:00:22.47,0:00:23.56,B,,0,0,0,,{\pos(540,1415)}Y la vida le trae
Dialogue: 0,0:00:23.56,0:00:24.17,B,,0,0,0,,{\pos(540,1415)}justo eso
Dialogue: 0,0:00:24.17,0:00:25.39,B,,0,0,0,,{\pos(540,1415)}gente que no le valora
Dialogue: 0,0:00:25.39,0:00:26.70,B,,0,0,0,,{\pos(540,1415)}parejas que no le eligen
Dialogue: 0,0:00:26.70,0:00:27.47,B,,0,0,0,,{\pos(540,1415)}entorno que se ríe
Dialogue: 0,0:00:27.47,0:00:27.98,B,,0,0,0,,{\pos(540,1415)}de él
Dialogue: 0,0:00:27.98,0:00:28.91,B,,0,0,0,,{\pos(540,1415)}Y esas ideas suyas
Dialogue: 0,0:00:28.91,0:00:30.05,B,,0,0,0,,{\pos(540,1415)}que nunca se ha atrevido
Dialogue: 0,0:00:30.05,0:00:31.48,B,,0,0,0,,{\pos(540,1415)}a enseñar por esa creencia
Dialogue: 0,0:00:31.48,0:00:32.81,B,,0,0,0,,{\pos(540,1415)}interna de quién soy yo
Dialogue: 0,0:00:32.81,0:00:34.18,B,,0,0,0,,{\pos(540,1415)}para decir o enseñar esto
Dialogue: 0,0:00:34.18,0:00:35.29,B,,0,0,0,,{\pos(540,1415)}Mengano vivió exactamente
Dialogue: 0,0:00:35.29,0:00:35.96,B,,0,0,0,,{\pos(540,1415)}lo mismo hasta
Dialogue: 0,0:00:35.96,0:00:36.70,B,,0,0,0,,{\pos(540,1415)}que se dio cuenta
Dialogue: 0,0:00:36.70,0:00:37.55,B,,0,0,0,,{\pos(540,1415)}de que él no tenía
Dialogue: 0,0:00:37.55,0:00:38.47,B,,0,0,0,,{\pos(540,1415)}que ganarse nada
Dialogue: 0,0:00:38.47,0:00:39.59,B,,0,0,0,,{\pos(540,1415)}y que le podían querer
Dialogue: 0,0:00:39.59,0:00:40.52,B,,0,0,0,,{\pos(540,1415)}Tal y como era él
Dialogue: 0,0:00:40.52,0:00:41.37,B,,0,0,0,,{\pos(540,1415)}Y empezó a creérselo poco
Dialogue: 0,0:00:41.37,0:00:41.79,B,,0,0,0,,{\pos(540,1415)}a poco
Dialogue: 0,0:00:41.79,0:00:43.22,B,,0,0,0,,{\pos(540,1415)}empezó a tratarse como alguien
Dialogue: 0,0:00:43.22,0:00:44.42,B,,0,0,0,,{\pos(540,1415)}que realmente se quiere
Dialogue: 0,0:00:44.42,0:00:45.63,B,,0,0,0,,{\pos(540,1415)}empezó a enseñar cosas
Dialogue: 0,0:00:45.63,0:00:46.96,B,,0,0,0,,{\pos(540,1415)}que realmente le gustan
Dialogue: 0,0:00:46.96,0:00:47.93,B,,0,0,0,,{\pos(540,1415)}Y la vida le empezó
Dialogue: 0,0:00:47.93,0:00:49.42,B,,0,0,0,,{\pos(540,1415)}a traer exactamente lo mismo
Dialogue: 0,0:00:49.42,0:00:50.62,B,,0,0,0,,{\pos(540,1415)}personas que le respetan
Dialogue: 0,0:00:50.62,0:00:51.28,B,,0,0,0,,{\pos(540,1415)}que le quieren
Dialogue: 0,0:00:51.28,0:00:52.16,B,,0,0,0,,{\pos(540,1415)}que le valoran
Dialogue: 0,0:00:52.16,0:00:53.45,B,,0,0,0,,{\pos(540,1415)}y que pagan por aquello
Dialogue: 0,0:00:53.45,0:00:54.05,B,,0,0,0,,{\pos(540,1415)}que él sabe
Dialogue: 0,0:00:54.05,0:00:55.06,B,,0,0,0,,{\pos(540,1415)}Los dos atraen igual
Dialogue: 0,0:00:55.06,0:00:55.26,B,,0,0,0,,{\pos(540,1415)}de bien
Dialogue: 0,0:00:55.26,0:00:56.49,B,,0,0,0,,{\pos(540,1415)}la diferencia entre uno
Dialogue: 0,0:00:56.49,0:00:56.76,B,,0,0,0,,{\pos(540,1415)}y otro
Dialogue: 0,0:00:56.76,0:00:57.79,B,,0,0,0,,{\pos(540,1415)}es lo que sienten
Dialogue: 0,0:00:57.79,0:00:58.97,B,,0,0,0,,{\pos(540,1415)}en su corazón que merecen
Dialogue: 0,0:00:58.97,0:00:59.85,B,,0,0,0,,{\pos(540,1415)}Y lo que cada uno
Dialogue: 0,0:00:59.85,0:01:01.03,B,,0,0,0,,{\pos(540,1415)}cree de sí mismo cuando
Dialogue: 0,0:01:01.03,0:01:01.42,B,,0,0,0,,{\pos(540,1415)}está solo
Dialogue: 0,0:01:01.42,0:01:02.28,B,,0,0,0,,{\pos(540,1415)}Así que no cambies
Dialogue: 0,0:01:02.28,0:01:02.87,B,,0,0,0,,{\pos(540,1415)}lo que pides
Dialogue: 0,0:01:02.87,0:01:03.98,B,,0,0,0,,{\pos(540,1415)}cambia lo que crees
Dialogue: 0,0:01:03.98,0:01:05.29,B,,0,0,0,,{\pos(540,1415)}en el fondo que mereces
Dialogue: 0,0:01:05.29,0:01:06.39,B,,0,0,0,,{\pos(540,1415)}Y empieza hoy tratándote como
Dialogue: 0,0:01:06.39,0:01:08.05,B,,0,0,0,,{\pos(540,1415)}alguien que ya es suficiente
Dialogue: 0,0:01:08.05,0:01:08.88,B,,0,0,0,,{\pos(540,1415)}Tenga lo que tenga
Dialogue: 0,0:01:08.88,0:01:09.79,B,,0,0,0,,{\pos(540,1415)}o haga lo que haga
