Dialogue: 0,0:00:00.01,0:00:00.97,B,,0,0,0,,{\pos(540,1415)}Te dices que nunca tienes
Dialogue: 0,0:00:00.97,0:00:02.20,B,,0,0,0,,{\pos(540,1415)}suerte y te extraña
Dialogue: 0,0:00:02.20,0:00:02.93,B,,0,0,0,,{\pos(540,1415)}de que no venga nada
Dialogue: 0,0:00:02.93,0:00:03.36,B,,0,0,0,,{\pos(540,1415)}a tu vida
Dialogue: 0,0:00:03.36,0:00:04.43,B,,0,0,0,,{\pos(540,1415)}Cynthia stafford ganó 112
Dialogue: 0,0:00:04.43,0:00:05.22,B,,0,0,0,,{\pos(540,1415)}millones de dólares
Dialogue: 0,0:00:05.22,0:00:06.52,B,,0,0,0,,{\pos(540,1415)}y te aseguro que fue
Dialogue: 0,0:00:06.52,0:00:07.62,B,,0,0,0,,{\pos(540,1415)}porque hacía cada día estas
Dialogue: 0,0:00:07.62,0:00:08.58,B,,0,0,0,,{\pos(540,1415)}cuatro cosas
Dialogue: 0,0:00:08.58,0:00:09.13,B,,0,0,0,,{\pos(540,1415)}Punto 1
Dialogue: 0,0:00:09.13,0:00:10.35,B,,0,0,0,,{\pos(540,1415)}Cuando le venía un pensamiento
Dialogue: 0,0:00:10.35,0:00:10.82,B,,0,0,0,,{\pos(540,1415)}negativo
Dialogue: 0,0:00:10.82,0:00:12.08,B,,0,0,0,,{\pos(540,1415)}no se enganchaba y no
Dialogue: 0,0:00:12.08,0:00:13.17,B,,0,0,0,,{\pos(540,1415)}se dejaba llevar por ese
Dialogue: 0,0:00:13.17,0:00:13.82,B,,0,0,0,,{\pos(540,1415)}pensamiento
Dialogue: 0,0:00:13.82,0:00:15.15,B,,0,0,0,,{\pos(540,1415)}Ella había tenido una infancia
Dialogue: 0,0:00:15.15,0:00:16.53,B,,0,0,0,,{\pos(540,1415)}muy dura de pérdidas
Dialogue: 0,0:00:16.53,0:00:17.25,B,,0,0,0,,{\pos(540,1415)}de golpes
Dialogue: 0,0:00:17.25,0:00:18.15,B,,0,0,0,,{\pos(540,1415)}pero no dejaba
Dialogue: 0,0:00:18.15,0:00:19.40,B,,0,0,0,,{\pos(540,1415)}que se enganchara con esas
Dialogue: 0,0:00:19.40,0:00:20.06,B,,0,0,0,,{\pos(540,1415)}experiencias
Dialogue: 0,0:00:20.06,0:00:20.72,B,,0,0,0,,{\pos(540,1415)}Punto 2
Dialogue: 0,0:00:20.72,0:00:21.54,B,,0,0,0,,{\pos(540,1415)}la autoestima
Dialogue: 0,0:00:21.54,0:00:22.87,B,,0,0,0,,{\pos(540,1415)}Ella cada mañana se decía
Dialogue: 0,0:00:22.87,0:00:23.54,B,,0,0,0,,{\pos(540,1415)}que era la persona
Dialogue: 0,0:00:23.54,0:00:24.71,B,,0,0,0,,{\pos(540,1415)}con más suerte del mundo
Dialogue: 0,0:00:24.71,0:00:25.28,B,,0,0,0,,{\pos(540,1415)}Y no solamente
Dialogue: 0,0:00:25.28,0:00:25.82,B,,0,0,0,,{\pos(540,1415)}se lo decía
Dialogue: 0,0:00:25.82,0:00:26.81,B,,0,0,0,,{\pos(540,1415)}sino que también
Dialogue: 0,0:00:26.81,0:00:27.81,B,,0,0,0,,{\pos(540,1415)}y lo más importante
Dialogue: 0,0:00:27.81,0:00:28.48,B,,0,0,0,,{\pos(540,1415)}se lo creía
Dialogue: 0,0:00:28.48,0:00:28.93,B,,0,0,0,,{\pos(540,1415)}Punto 3
Dialogue: 0,0:00:28.93,0:00:29.47,B,,0,0,0,,{\pos(540,1415)}la confianza
Dialogue: 0,0:00:29.47,0:00:30.48,B,,0,0,0,,{\pos(540,1415)}y aquí es donde falla
Dialogue: 0,0:00:30.48,0:00:31.11,B,,0,0,0,,{\pos(540,1415)}todo el mundo
Dialogue: 0,0:00:31.11,0:00:32.87,B,,0,0,0,,{\pos(540,1415)}No estaba esperando algo
Dialogue: 0,0:00:32.87,0:00:33.83,B,,0,0,0,,{\pos(540,1415)}impacientemente
Dialogue: 0,0:00:33.83,0:00:35.37,B,,0,0,0,,{\pos(540,1415)}sino que tenía tanta seguridad
Dialogue: 0,0:00:35.37,0:00:36.02,B,,0,0,0,,{\pos(540,1415)}en que eso iba
Dialogue: 0,0:00:36.02,0:00:36.40,B,,0,0,0,,{\pos(540,1415)}a ocurrir
Dialogue: 0,0:00:36.40,0:00:37.36,B,,0,0,0,,{\pos(540,1415)}Que era cuestión de tiempo
Dialogue: 0,0:00:37.36,0:00:37.90,B,,0,0,0,,{\pos(540,1415)}Punto 4
Dialogue: 0,0:00:37.90,0:00:38.82,B,,0,0,0,,{\pos(540,1415)}lo imaginaba
Dialogue: 0,0:00:38.82,0:00:40.38,B,,0,0,0,,{\pos(540,1415)}ponía cifras por todas partes
Dialogue: 0,0:00:40.38,0:00:41.86,B,,0,0,0,,{\pos(540,1415)}incluso ya tenía la idea
Dialogue: 0,0:00:41.86,0:00:43.11,B,,0,0,0,,{\pos(540,1415)}de en qué se lo iba
Dialogue: 0,0:00:43.11,0:00:43.61,B,,0,0,0,,{\pos(540,1415)}a gastar
Dialogue: 0,0:00:43.61,0:00:45.04,B,,0,0,0,,{\pos(540,1415)}Tú haces justo lo contrario
Dialogue: 0,0:00:45.04,0:00:45.93,B,,0,0,0,,{\pos(540,1415)}te llega un pensamiento
Dialogue: 0,0:00:45.93,0:00:46.49,B,,0,0,0,,{\pos(540,1415)}negativo
Dialogue: 0,0:00:46.49,0:00:47.39,B,,0,0,0,,{\pos(540,1415)}te enganchas
Dialogue: 0,0:00:47.39,0:00:48.51,B,,0,0,0,,{\pos(540,1415)}empiezas a dudar de todo
Dialogue: 0,0:00:48.51,0:00:49.77,B,,0,0,0,,{\pos(540,1415)}y eso mismo te desanima
Dialogue: 0,0:00:49.77,0:00:50.39,B,,0,0,0,,{\pos(540,1415)}Y no hace falta
Dialogue: 0,0:00:50.39,0:00:51.13,B,,0,0,0,,{\pos(540,1415)}que te toque nada
Dialogue: 0,0:00:51.13,0:00:52.51,B,,0,0,0,,{\pos(540,1415)}Empieza por el punto 2
Dialogue: 0,0:00:52.51,0:00:53.07,B,,0,0,0,,{\pos(540,1415)}empieza a trabajar
Dialogue: 0,0:00:53.07,0:00:54.27,B,,0,0,0,,{\pos(540,1415)}tu autoestima y te aseguro
Dialogue: 0,0:00:54.27,0:00:55.29,B,,0,0,0,,{\pos(540,1415)}de que con el tiempo
Dialogue: 0,0:00:55.29,0:00:56.48,B,,0,0,0,,{\pos(540,1415)}vas a creerte merecedor
Dialogue: 0,0:00:56.48,0:00:57.21,B,,0,0,0,,{\pos(540,1415)}de mucho más
