Dialogue: 0,0:00:00.08,0:00:01.18,B,,0,0,0,,{\pos(540,1415)}Lo que esta chica millonaria
Dialogue: 0,0:00:01.18,0:00:01.99,B,,0,0,0,,{\pos(540,1415)}hace cada día
Dialogue: 0,0:00:01.99,0:00:02.42,B,,0,0,0,,{\pos(540,1415)}es lo opuesto
Dialogue: 0,0:00:02.42,0:00:03.05,B,,0,0,0,,{\pos(540,1415)}a lo que haces tú
Dialogue: 0,0:00:03.05,0:00:04.11,B,,0,0,0,,{\pos(540,1415)}Cynthia stafford ganó 112
Dialogue: 0,0:00:04.11,0:00:04.91,B,,0,0,0,,{\pos(540,1415)}millones de dólares
Dialogue: 0,0:00:04.91,0:00:06.21,B,,0,0,0,,{\pos(540,1415)}y te aseguro que fue
Dialogue: 0,0:00:06.21,0:00:07.31,B,,0,0,0,,{\pos(540,1415)}porque hacía cada día estas
Dialogue: 0,0:00:07.31,0:00:08.26,B,,0,0,0,,{\pos(540,1415)}cuatro cosas
Dialogue: 0,0:00:08.26,0:00:08.82,B,,0,0,0,,{\pos(540,1415)}Punto 1
Dialogue: 0,0:00:08.82,0:00:10.03,B,,0,0,0,,{\pos(540,1415)}Cuando le venía un pensamiento
Dialogue: 0,0:00:10.03,0:00:10.51,B,,0,0,0,,{\pos(540,1415)}negativo
Dialogue: 0,0:00:10.51,0:00:11.76,B,,0,0,0,,{\pos(540,1415)}no se enganchaba y no
Dialogue: 0,0:00:11.76,0:00:12.86,B,,0,0,0,,{\pos(540,1415)}se dejaba llevar por ese
Dialogue: 0,0:00:12.86,0:00:13.51,B,,0,0,0,,{\pos(540,1415)}pensamiento
Dialogue: 0,0:00:13.51,0:00:14.83,B,,0,0,0,,{\pos(540,1415)}Ella había tenido una infancia
Dialogue: 0,0:00:14.83,0:00:16.21,B,,0,0,0,,{\pos(540,1415)}muy dura de pérdidas
Dialogue: 0,0:00:16.21,0:00:16.94,B,,0,0,0,,{\pos(540,1415)}de golpes
Dialogue: 0,0:00:16.94,0:00:17.83,B,,0,0,0,,{\pos(540,1415)}pero no dejaba
Dialogue: 0,0:00:17.83,0:00:19.08,B,,0,0,0,,{\pos(540,1415)}que se enganchara con esas
Dialogue: 0,0:00:19.08,0:00:19.75,B,,0,0,0,,{\pos(540,1415)}experiencias
Dialogue: 0,0:00:19.75,0:00:20.40,B,,0,0,0,,{\pos(540,1415)}Punto 2
Dialogue: 0,0:00:20.40,0:00:21.22,B,,0,0,0,,{\pos(540,1415)}la autoestima
Dialogue: 0,0:00:21.22,0:00:22.56,B,,0,0,0,,{\pos(540,1415)}Ella cada mañana se decía
Dialogue: 0,0:00:22.56,0:00:23.23,B,,0,0,0,,{\pos(540,1415)}que era la persona
Dialogue: 0,0:00:23.23,0:00:24.39,B,,0,0,0,,{\pos(540,1415)}con más suerte del mundo
Dialogue: 0,0:00:24.39,0:00:24.97,B,,0,0,0,,{\pos(540,1415)}Y no solamente
Dialogue: 0,0:00:24.97,0:00:25.50,B,,0,0,0,,{\pos(540,1415)}se lo decía
Dialogue: 0,0:00:25.50,0:00:26.50,B,,0,0,0,,{\pos(540,1415)}sino que también
Dialogue: 0,0:00:26.50,0:00:27.56,B,,0,0,0,,{\pos(540,1415)}y lo más importante
Dialogue: 0,0:00:27.56,0:00:28.24,B,,0,0,0,,{\pos(540,1415)}se lo creía
Dialogue: 0,0:00:28.24,0:00:28.69,B,,0,0,0,,{\pos(540,1415)}Punto 3
Dialogue: 0,0:00:28.69,0:00:29.24,B,,0,0,0,,{\pos(540,1415)}la confianza
Dialogue: 0,0:00:29.24,0:00:30.24,B,,0,0,0,,{\pos(540,1415)}y aquí es donde falla
Dialogue: 0,0:00:30.24,0:00:30.89,B,,0,0,0,,{\pos(540,1415)}todo el mundo
Dialogue: 0,0:00:30.89,0:00:32.64,B,,0,0,0,,{\pos(540,1415)}No estaba esperando algo
Dialogue: 0,0:00:32.64,0:00:33.60,B,,0,0,0,,{\pos(540,1415)}impacientemente
Dialogue: 0,0:00:33.60,0:00:35.14,B,,0,0,0,,{\pos(540,1415)}sino que tenía tanta seguridad
Dialogue: 0,0:00:35.14,0:00:35.78,B,,0,0,0,,{\pos(540,1415)}en que eso iba
Dialogue: 0,0:00:35.78,0:00:36.17,B,,0,0,0,,{\pos(540,1415)}a ocurrir
Dialogue: 0,0:00:36.17,0:00:37.13,B,,0,0,0,,{\pos(540,1415)}Que era cuestión de tiempo
Dialogue: 0,0:00:37.13,0:00:37.67,B,,0,0,0,,{\pos(540,1415)}Punto 4
Dialogue: 0,0:00:37.67,0:00:38.59,B,,0,0,0,,{\pos(540,1415)}lo imaginaba
Dialogue: 0,0:00:38.59,0:00:40.14,B,,0,0,0,,{\pos(540,1415)}ponía cifras por todas partes
Dialogue: 0,0:00:40.14,0:00:41.63,B,,0,0,0,,{\pos(540,1415)}incluso ya tenía la idea
Dialogue: 0,0:00:41.63,0:00:42.90,B,,0,0,0,,{\pos(540,1415)}de en qué se lo iba
Dialogue: 0,0:00:42.90,0:00:43.38,B,,0,0,0,,{\pos(540,1415)}a gastar
Dialogue: 0,0:00:43.38,0:00:44.80,B,,0,0,0,,{\pos(540,1415)}Tú haces justo lo contrario
Dialogue: 0,0:00:44.80,0:00:45.69,B,,0,0,0,,{\pos(540,1415)}te llega un pensamiento
Dialogue: 0,0:00:45.69,0:00:46.25,B,,0,0,0,,{\pos(540,1415)}negativo
Dialogue: 0,0:00:46.25,0:00:47.15,B,,0,0,0,,{\pos(540,1415)}te enganchas
Dialogue: 0,0:00:47.15,0:00:48.28,B,,0,0,0,,{\pos(540,1415)}empiezas a dudar de todo
Dialogue: 0,0:00:48.28,0:00:49.54,B,,0,0,0,,{\pos(540,1415)}y eso mismo te desanima
Dialogue: 0,0:00:49.54,0:00:50.17,B,,0,0,0,,{\pos(540,1415)}Y no hace falta
Dialogue: 0,0:00:50.17,0:00:51.09,B,,0,0,0,,{\pos(540,1415)}que te toque nada
Dialogue: 0,0:00:51.09,0:00:52.28,B,,0,0,0,,{\pos(540,1415)}Empieza por el punto 2
Dialogue: 0,0:00:52.28,0:00:52.84,B,,0,0,0,,{\pos(540,1415)}empieza a trabajar
Dialogue: 0,0:00:52.84,0:00:54.19,B,,0,0,0,,{\pos(540,1415)}tu autoestima y te aseguro
Dialogue: 0,0:00:54.19,0:00:55.05,B,,0,0,0,,{\pos(540,1415)}de que con el tiempo
Dialogue: 0,0:00:55.05,0:00:56.24,B,,0,0,0,,{\pos(540,1415)}vas a creerte merecedor
Dialogue: 0,0:00:56.24,0:00:56.97,B,,0,0,0,,{\pos(540,1415)}de mucho más
