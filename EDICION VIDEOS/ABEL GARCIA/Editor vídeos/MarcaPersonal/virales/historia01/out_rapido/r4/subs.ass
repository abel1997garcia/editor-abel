Dialogue: 0,0:00:00.00,0:00:00.72,B,,0,0,0,,{\pos(540,1415)}Con todo lo que yo
Dialogue: 0,0:00:00.72,0:00:01.53,B,,0,0,0,,{\pos(540,1415)}hago por ellos
Dialogue: 0,0:00:01.53,0:00:02.48,B,,0,0,0,,{\pos(540,1415)}ese es tu puto problema
Dialogue: 0,0:00:02.48,0:00:03.04,B,,0,0,0,,{\pos(540,1415)}A lo mejor eres
Dialogue: 0,0:00:03.04,0:00:04.04,B,,0,0,0,,{\pos(540,1415)}la persona que más da
Dialogue: 0,0:00:04.04,0:00:04.73,B,,0,0,0,,{\pos(540,1415)}la que siempre está
Dialogue: 0,0:00:04.73,0:00:05.70,B,,0,0,0,,{\pos(540,1415)}la que nunca se queja
Dialogue: 0,0:00:05.70,0:00:06.59,B,,0,0,0,,{\pos(540,1415)}la que siempre dice
Dialogue: 0,0:00:06.59,0:00:07.56,B,,0,0,0,,{\pos(540,1415)}que sí cuando quiere decir
Dialogue: 0,0:00:07.56,0:00:07.92,B,,0,0,0,,{\pos(540,1415)}que no
Dialogue: 0,0:00:07.92,0:00:08.65,B,,0,0,0,,{\pos(540,1415)}Y nada de eso hace
Dialogue: 0,0:00:08.65,0:00:09.00,B,,0,0,0,,{\pos(540,1415)}que te elijan
Dialogue: 0,0:00:09.00,0:00:09.75,B,,0,0,0,,{\pos(540,1415)}y que te respeten
Dialogue: 0,0:00:09.75,0:00:10.45,B,,0,0,0,,{\pos(540,1415)}porque se nota
Dialogue: 0,0:00:10.45,0:00:11.15,B,,0,0,0,,{\pos(540,1415)}que lo estás haciendo
Dialogue: 0,0:00:11.15,0:00:11.89,B,,0,0,0,,{\pos(540,1415)}para que te quieran
Dialogue: 0,0:00:11.89,0:00:12.63,B,,0,0,0,,{\pos(540,1415)}Y por eso la persona
Dialogue: 0,0:00:12.63,0:00:13.67,B,,0,0,0,,{\pos(540,1415)}que menos da a veces
Dialogue: 0,0:00:13.67,0:00:14.47,B,,0,0,0,,{\pos(540,1415)}es la más valorada
Dialogue: 0,0:00:14.47,0:00:15.03,B,,0,0,0,,{\pos(540,1415)}Y tú que lo das
Dialogue: 0,0:00:15.03,0:00:15.38,B,,0,0,0,,{\pos(540,1415)}todo
Dialogue: 0,0:00:15.38,0:00:16.42,B,,0,0,0,,{\pos(540,1415)}acabas sintiendo que nunca
Dialogue: 0,0:00:16.42,0:00:17.22,B,,0,0,0,,{\pos(540,1415)}es suficiente
Dialogue: 0,0:00:17.22,0:00:17.53,B,,0,0,0,,{\pos(540,1415)}Entonces
Dialogue: 0,0:00:17.53,0:00:18.04,B,,0,0,0,,{\pos(540,1415)}¿qué cambia?
Dialogue: 0,0:00:18.04,0:00:18.76,B,,0,0,0,,{\pos(540,1415)}Dos cosas
Dialogue: 0,0:00:18.76,0:00:19.54,B,,0,0,0,,{\pos(540,1415)}La primera es que cuando
Dialogue: 0,0:00:19.54,0:00:20.69,B,,0,0,0,,{\pos(540,1415)}dices que sí queriendo decir
Dialogue: 0,0:00:20.69,0:00:21.03,B,,0,0,0,,{\pos(540,1415)}que no
Dialogue: 0,0:00:21.03,0:00:22.22,B,,0,0,0,,{\pos(540,1415)}te estás traicionando y eso
Dialogue: 0,0:00:22.22,0:00:23.63,B,,0,0,0,,{\pos(540,1415)}te hace bajar tu energía
Dialogue: 0,0:00:23.63,0:00:24.04,B,,0,0,0,,{\pos(540,1415)}y por tanto
Dialogue: 0,0:00:24.04,0:00:24.60,B,,0,0,0,,{\pos(540,1415)}tu autoestima
Dialogue: 0,0:00:24.60,0:00:25.54,B,,0,0,0,,{\pos(540,1415)}Y la gente lo nota
Dialogue: 0,0:00:25.54,0:00:26.61,B,,0,0,0,,{\pos(540,1415)}aunque no sepa explicarlo
Dialogue: 0,0:00:26.61,0:00:27.22,B,,0,0,0,,{\pos(540,1415)}Y la segunda
Dialogue: 0,0:00:27.22,0:00:28.25,B,,0,0,0,,{\pos(540,1415)}es que no te eliges
Dialogue: 0,0:00:28.25,0:00:28.75,B,,0,0,0,,{\pos(540,1415)}tú primero
Dialogue: 0,0:00:28.75,0:00:29.63,B,,0,0,0,,{\pos(540,1415)}Y no desde el orgullo
Dialogue: 0,0:00:29.63,0:00:30.48,B,,0,0,0,,{\pos(540,1415)}sino el respeto
Dialogue: 0,0:00:30.48,0:00:31.19,B,,0,0,0,,{\pos(540,1415)}y piénsalo bien
Dialogue: 0,0:00:31.19,0:00:31.77,B,,0,0,0,,{\pos(540,1415)}nadie se va a quedar
Dialogue: 0,0:00:31.77,0:00:32.42,B,,0,0,0,,{\pos(540,1415)}al lado ni va
Dialogue: 0,0:00:32.42,0:00:33.16,B,,0,0,0,,{\pos(540,1415)}a respetar a nadie
Dialogue: 0,0:00:33.16,0:00:33.97,B,,0,0,0,,{\pos(540,1415)}que no se respeta
Dialogue: 0,0:00:33.97,0:00:35.11,B,,0,0,0,,{\pos(540,1415)}Yo llegué a ganar 17.000
Dialogue: 0,0:00:35.11,0:00:35.69,B,,0,0,0,,{\pos(540,1415)}euros en un mes
Dialogue: 0,0:00:35.69,0:00:35.95,B,,0,0,0,,{\pos(540,1415)}y aún
Dialogue: 0,0:00:35.95,0:00:36.76,B,,0,0,0,,{\pos(540,1415)}así me sentía vacío
Dialogue: 0,0:00:36.76,0:00:37.63,B,,0,0,0,,{\pos(540,1415)}porque estaba buscando
Dialogue: 0,0:00:37.63,0:00:38.99,B,,0,0,0,,{\pos(540,1415)}que todo mi valor proveniera
Dialogue: 0,0:00:38.99,0:00:39.77,B,,0,0,0,,{\pos(540,1415)}de lo externo
Dialogue: 0,0:00:39.77,0:00:40.65,B,,0,0,0,,{\pos(540,1415)}Así que deja de darlo
Dialogue: 0,0:00:40.65,0:00:41.68,B,,0,0,0,,{\pos(540,1415)}todo para que te quieran
Dialogue: 0,0:00:41.68,0:00:42.75,B,,0,0,0,,{\pos(540,1415)}y empieza a dártelo tú
Dialogue: 0,0:00:42.75,0:00:43.37,B,,0,0,0,,{\pos(540,1415)}Porque cuando elevas
Dialogue: 0,0:00:43.37,0:00:44.24,B,,0,0,0,,{\pos(540,1415)}tu energía y mejoras
Dialogue: 0,0:00:44.24,0:00:44.89,B,,0,0,0,,{\pos(540,1415)}tu autoestima
Dialogue: 0,0:00:44.89,0:00:45.69,B,,0,0,0,,{\pos(540,1415)}la gente que te quiere
Dialogue: 0,0:00:45.69,0:00:46.80,B,,0,0,0,,{\pos(540,1415)}y te valora llega sola
