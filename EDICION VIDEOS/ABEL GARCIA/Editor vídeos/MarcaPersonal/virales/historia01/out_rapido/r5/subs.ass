Dialogue: 0,0:00:00.01,0:00:00.65,B,,0,0,0,,{\pos(540,1415)}Nadie se va a quedar
Dialogue: 0,0:00:00.65,0:00:01.30,B,,0,0,0,,{\pos(540,1415)}al lado de alguien
Dialogue: 0,0:00:01.30,0:00:01.82,B,,0,0,0,,{\pos(540,1415)}que no se queda
Dialogue: 0,0:00:01.82,0:00:02.46,B,,0,0,0,,{\pos(540,1415)}a su propio lado
Dialogue: 0,0:00:02.46,0:00:03.02,B,,0,0,0,,{\pos(540,1415)}A lo mejor eres
Dialogue: 0,0:00:03.02,0:00:04.03,B,,0,0,0,,{\pos(540,1415)}la persona que más da
Dialogue: 0,0:00:04.03,0:00:04.71,B,,0,0,0,,{\pos(540,1415)}la que siempre está
Dialogue: 0,0:00:04.71,0:00:05.68,B,,0,0,0,,{\pos(540,1415)}la que nunca se queja
Dialogue: 0,0:00:05.68,0:00:06.59,B,,0,0,0,,{\pos(540,1415)}la que siempre dice
Dialogue: 0,0:00:06.59,0:00:07.54,B,,0,0,0,,{\pos(540,1415)}que sí cuando quiere decir
Dialogue: 0,0:00:07.54,0:00:07.90,B,,0,0,0,,{\pos(540,1415)}que no
Dialogue: 0,0:00:07.90,0:00:08.63,B,,0,0,0,,{\pos(540,1415)}Y nada de eso hace
Dialogue: 0,0:00:08.63,0:00:08.99,B,,0,0,0,,{\pos(540,1415)}que te elijan
Dialogue: 0,0:00:08.99,0:00:09.73,B,,0,0,0,,{\pos(540,1415)}y que te respeten
Dialogue: 0,0:00:09.73,0:00:10.43,B,,0,0,0,,{\pos(540,1415)}porque se nota
Dialogue: 0,0:00:10.43,0:00:11.13,B,,0,0,0,,{\pos(540,1415)}que lo estás haciendo
Dialogue: 0,0:00:11.13,0:00:11.88,B,,0,0,0,,{\pos(540,1415)}para que te quieran
Dialogue: 0,0:00:11.88,0:00:12.61,B,,0,0,0,,{\pos(540,1415)}Y por eso la persona
Dialogue: 0,0:00:12.61,0:00:13.75,B,,0,0,0,,{\pos(540,1415)}que menos da a veces
Dialogue: 0,0:00:13.75,0:00:14.46,B,,0,0,0,,{\pos(540,1415)}es la más valorada
Dialogue: 0,0:00:14.46,0:00:15.02,B,,0,0,0,,{\pos(540,1415)}Y tú que lo das
Dialogue: 0,0:00:15.02,0:00:15.34,B,,0,0,0,,{\pos(540,1415)}todo
Dialogue: 0,0:00:15.34,0:00:16.40,B,,0,0,0,,{\pos(540,1415)}acabas sintiendo que nunca
Dialogue: 0,0:00:16.40,0:00:17.20,B,,0,0,0,,{\pos(540,1415)}es suficiente
Dialogue: 0,0:00:17.20,0:00:17.52,B,,0,0,0,,{\pos(540,1415)}Entonces
Dialogue: 0,0:00:17.52,0:00:18.03,B,,0,0,0,,{\pos(540,1415)}¿qué cambia?
Dialogue: 0,0:00:18.03,0:00:18.74,B,,0,0,0,,{\pos(540,1415)}Dos cosas
Dialogue: 0,0:00:18.74,0:00:19.53,B,,0,0,0,,{\pos(540,1415)}La primera es que cuando
Dialogue: 0,0:00:19.53,0:00:20.67,B,,0,0,0,,{\pos(540,1415)}dices que sí queriendo decir
Dialogue: 0,0:00:20.67,0:00:21.01,B,,0,0,0,,{\pos(540,1415)}que no
Dialogue: 0,0:00:21.01,0:00:22.21,B,,0,0,0,,{\pos(540,1415)}te estás traicionando y eso
Dialogue: 0,0:00:22.21,0:00:23.61,B,,0,0,0,,{\pos(540,1415)}te hace bajar tu energía
Dialogue: 0,0:00:23.61,0:00:24.02,B,,0,0,0,,{\pos(540,1415)}y por tanto
Dialogue: 0,0:00:24.02,0:00:24.56,B,,0,0,0,,{\pos(540,1415)}tu autoestima
Dialogue: 0,0:00:24.56,0:00:25.51,B,,0,0,0,,{\pos(540,1415)}Y la gente lo nota
Dialogue: 0,0:00:25.51,0:00:26.58,B,,0,0,0,,{\pos(540,1415)}aunque no sepa explicarlo
Dialogue: 0,0:00:26.58,0:00:27.19,B,,0,0,0,,{\pos(540,1415)}Y la segunda
Dialogue: 0,0:00:27.19,0:00:28.21,B,,0,0,0,,{\pos(540,1415)}es que no te eliges
Dialogue: 0,0:00:28.21,0:00:28.71,B,,0,0,0,,{\pos(540,1415)}tú primero
Dialogue: 0,0:00:28.71,0:00:29.59,B,,0,0,0,,{\pos(540,1415)}Y no desde el orgullo
Dialogue: 0,0:00:29.59,0:00:30.51,B,,0,0,0,,{\pos(540,1415)}sino el respeto
Dialogue: 0,0:00:30.51,0:00:31.66,B,,0,0,0,,{\pos(540,1415)}yo llegué a ganar 17.000
Dialogue: 0,0:00:31.66,0:00:32.23,B,,0,0,0,,{\pos(540,1415)}euros en un mes
Dialogue: 0,0:00:32.23,0:00:32.38,B,,0,0,0,,{\pos(540,1415)}y aún
Dialogue: 0,0:00:32.38,0:00:33.30,B,,0,0,0,,{\pos(540,1415)}así me sentía vacío
Dialogue: 0,0:00:33.30,0:00:34.17,B,,0,0,0,,{\pos(540,1415)}porque estaba buscando
Dialogue: 0,0:00:34.17,0:00:35.53,B,,0,0,0,,{\pos(540,1415)}que todo mi valor proveniera
Dialogue: 0,0:00:35.53,0:00:36.31,B,,0,0,0,,{\pos(540,1415)}de lo externo
Dialogue: 0,0:00:36.31,0:00:37.20,B,,0,0,0,,{\pos(540,1415)}Así que deja de darlo
Dialogue: 0,0:00:37.20,0:00:38.22,B,,0,0,0,,{\pos(540,1415)}todo para que te quieran
Dialogue: 0,0:00:38.22,0:00:39.30,B,,0,0,0,,{\pos(540,1415)}y empieza a dártelo tú
Dialogue: 0,0:00:39.30,0:00:39.91,B,,0,0,0,,{\pos(540,1415)}Porque cuando elevas
Dialogue: 0,0:00:39.91,0:00:40.80,B,,0,0,0,,{\pos(540,1415)}tu energía y mejoras
Dialogue: 0,0:00:40.80,0:00:41.42,B,,0,0,0,,{\pos(540,1415)}tu autoestima
Dialogue: 0,0:00:41.42,0:00:42.27,B,,0,0,0,,{\pos(540,1415)}la gente que te quiere
Dialogue: 0,0:00:42.27,0:00:43.34,B,,0,0,0,,{\pos(540,1415)}y te valora llega sola
