Dialogue: 0,0:00:00.00,0:00:00.78,B,,0,0,0,,{\pos(540,1415)}Lo das todo y justo
Dialogue: 0,0:00:00.78,0:00:01.61,B,,0,0,0,,{\pos(540,1415)}por eso no te valoran
Dialogue: 0,0:00:01.61,0:00:02.17,B,,0,0,0,,{\pos(540,1415)}A lo mejor eres
Dialogue: 0,0:00:02.17,0:00:03.17,B,,0,0,0,,{\pos(540,1415)}la persona que más da
Dialogue: 0,0:00:03.17,0:00:03.86,B,,0,0,0,,{\pos(540,1415)}la que siempre está
Dialogue: 0,0:00:03.86,0:00:05.16,B,,0,0,0,,{\pos(540,1415)}la que nunca se queja
Dialogue: 0,0:00:05.16,0:00:05.74,B,,0,0,0,,{\pos(540,1415)}la que siempre dice
Dialogue: 0,0:00:05.74,0:00:06.69,B,,0,0,0,,{\pos(540,1415)}que sí cuando quiere decir
Dialogue: 0,0:00:06.69,0:00:07.05,B,,0,0,0,,{\pos(540,1415)}que no
Dialogue: 0,0:00:07.05,0:00:07.78,B,,0,0,0,,{\pos(540,1415)}Y nada de eso hace
Dialogue: 0,0:00:07.78,0:00:08.14,B,,0,0,0,,{\pos(540,1415)}que te elijan
Dialogue: 0,0:00:08.14,0:00:08.88,B,,0,0,0,,{\pos(540,1415)}y que te respeten
Dialogue: 0,0:00:08.88,0:00:09.58,B,,0,0,0,,{\pos(540,1415)}porque se nota
Dialogue: 0,0:00:09.58,0:00:10.28,B,,0,0,0,,{\pos(540,1415)}que lo estás haciendo
Dialogue: 0,0:00:10.28,0:00:11.02,B,,0,0,0,,{\pos(540,1415)}para que te quieran
Dialogue: 0,0:00:11.02,0:00:11.76,B,,0,0,0,,{\pos(540,1415)}Y por eso la persona
Dialogue: 0,0:00:11.76,0:00:12.90,B,,0,0,0,,{\pos(540,1415)}que menos da a veces
Dialogue: 0,0:00:12.90,0:00:13.61,B,,0,0,0,,{\pos(540,1415)}es la más valorada
Dialogue: 0,0:00:13.61,0:00:14.17,B,,0,0,0,,{\pos(540,1415)}Y tú que lo das
Dialogue: 0,0:00:14.17,0:00:14.51,B,,0,0,0,,{\pos(540,1415)}todo
Dialogue: 0,0:00:14.51,0:00:15.55,B,,0,0,0,,{\pos(540,1415)}acabas sintiendo que nunca
Dialogue: 0,0:00:15.55,0:00:16.35,B,,0,0,0,,{\pos(540,1415)}es suficiente
Dialogue: 0,0:00:16.35,0:00:16.67,B,,0,0,0,,{\pos(540,1415)}Entonces
Dialogue: 0,0:00:16.67,0:00:17.17,B,,0,0,0,,{\pos(540,1415)}¿qué cambia?
Dialogue: 0,0:00:17.17,0:00:17.90,B,,0,0,0,,{\pos(540,1415)}Dos cosas
Dialogue: 0,0:00:17.90,0:00:18.68,B,,0,0,0,,{\pos(540,1415)}La primera es que cuando
Dialogue: 0,0:00:18.68,0:00:19.82,B,,0,0,0,,{\pos(540,1415)}dices que sí queriendo decir
Dialogue: 0,0:00:19.82,0:00:20.16,B,,0,0,0,,{\pos(540,1415)}que no
Dialogue: 0,0:00:20.16,0:00:21.36,B,,0,0,0,,{\pos(540,1415)}te estás traicionando y eso
Dialogue: 0,0:00:21.36,0:00:22.77,B,,0,0,0,,{\pos(540,1415)}te hace bajar tu energía
Dialogue: 0,0:00:22.77,0:00:23.17,B,,0,0,0,,{\pos(540,1415)}y por tanto
Dialogue: 0,0:00:23.17,0:00:23.73,B,,0,0,0,,{\pos(540,1415)}tu autoestima
Dialogue: 0,0:00:23.73,0:00:24.67,B,,0,0,0,,{\pos(540,1415)}Y la gente lo nota
Dialogue: 0,0:00:24.67,0:00:25.75,B,,0,0,0,,{\pos(540,1415)}aunque no sepa explicarlo
Dialogue: 0,0:00:25.75,0:00:26.36,B,,0,0,0,,{\pos(540,1415)}Y la segunda
Dialogue: 0,0:00:26.36,0:00:27.38,B,,0,0,0,,{\pos(540,1415)}es que no te eliges
Dialogue: 0,0:00:27.38,0:00:27.87,B,,0,0,0,,{\pos(540,1415)}tú primero
Dialogue: 0,0:00:27.87,0:00:28.86,B,,0,0,0,,{\pos(540,1415)}Y no desde el orgullo
Dialogue: 0,0:00:28.86,0:00:29.61,B,,0,0,0,,{\pos(540,1415)}sino el respeto
Dialogue: 0,0:00:29.61,0:00:30.33,B,,0,0,0,,{\pos(540,1415)}y piénsalo bien
Dialogue: 0,0:00:30.33,0:00:30.91,B,,0,0,0,,{\pos(540,1415)}nadie se va a quedar
Dialogue: 0,0:00:30.91,0:00:31.60,B,,0,0,0,,{\pos(540,1415)}al lado ni va
Dialogue: 0,0:00:31.60,0:00:32.29,B,,0,0,0,,{\pos(540,1415)}a respetar a nadie
Dialogue: 0,0:00:32.29,0:00:33.10,B,,0,0,0,,{\pos(540,1415)}que no se respeta
Dialogue: 0,0:00:33.10,0:00:34.25,B,,0,0,0,,{\pos(540,1415)}Yo llegué a ganar 17.000
Dialogue: 0,0:00:34.25,0:00:34.82,B,,0,0,0,,{\pos(540,1415)}euros en un mes
Dialogue: 0,0:00:34.82,0:00:35.08,B,,0,0,0,,{\pos(540,1415)}y aún
Dialogue: 0,0:00:35.08,0:00:35.89,B,,0,0,0,,{\pos(540,1415)}así me sentía vacío
Dialogue: 0,0:00:35.89,0:00:36.76,B,,0,0,0,,{\pos(540,1415)}porque estaba buscando
Dialogue: 0,0:00:36.76,0:00:38.12,B,,0,0,0,,{\pos(540,1415)}que todo mi valor proveniera
Dialogue: 0,0:00:38.12,0:00:38.90,B,,0,0,0,,{\pos(540,1415)}de lo externo
Dialogue: 0,0:00:38.90,0:00:39.78,B,,0,0,0,,{\pos(540,1415)}Así que deja de darlo
Dialogue: 0,0:00:39.78,0:00:40.81,B,,0,0,0,,{\pos(540,1415)}todo para que te quieran
Dialogue: 0,0:00:40.81,0:00:41.89,B,,0,0,0,,{\pos(540,1415)}y empieza a dártelo tú
Dialogue: 0,0:00:41.89,0:00:42.50,B,,0,0,0,,{\pos(540,1415)}Porque cuando elevas
Dialogue: 0,0:00:42.50,0:00:43.39,B,,0,0,0,,{\pos(540,1415)}tu energía y mejoras
Dialogue: 0,0:00:43.39,0:00:44.03,B,,0,0,0,,{\pos(540,1415)}tu autoestima
Dialogue: 0,0:00:44.03,0:00:44.85,B,,0,0,0,,{\pos(540,1415)}la gente que te quiere
Dialogue: 0,0:00:44.85,0:00:45.93,B,,0,0,0,,{\pos(540,1415)}y te valora llega sola
