Dialogue: 0,0:00:00.00,0:00:00.91,B,,0,0,0,,{\pos(540,1415)}La persona que menos da
Dialogue: 0,0:00:00.91,0:00:01.46,B,,0,0,0,,{\pos(540,1415)}a veces es la más
Dialogue: 0,0:00:01.46,0:00:01.90,B,,0,0,0,,{\pos(540,1415)}valorada
Dialogue: 0,0:00:01.90,0:00:02.65,B,,0,0,0,,{\pos(540,1415)}y tú lo sabes
Dialogue: 0,0:00:02.65,0:00:03.20,B,,0,0,0,,{\pos(540,1415)}A lo mejor eres
Dialogue: 0,0:00:03.20,0:00:04.20,B,,0,0,0,,{\pos(540,1415)}la persona que más da
Dialogue: 0,0:00:04.20,0:00:04.89,B,,0,0,0,,{\pos(540,1415)}la que siempre está
Dialogue: 0,0:00:04.89,0:00:06.19,B,,0,0,0,,{\pos(540,1415)}la que nunca se queja
Dialogue: 0,0:00:06.19,0:00:06.77,B,,0,0,0,,{\pos(540,1415)}la que siempre dice
Dialogue: 0,0:00:06.77,0:00:07.73,B,,0,0,0,,{\pos(540,1415)}que sí cuando quiere decir
Dialogue: 0,0:00:07.73,0:00:08.08,B,,0,0,0,,{\pos(540,1415)}que no
Dialogue: 0,0:00:08.08,0:00:08.81,B,,0,0,0,,{\pos(540,1415)}Y nada de eso hace
Dialogue: 0,0:00:08.81,0:00:09.18,B,,0,0,0,,{\pos(540,1415)}que te elijan
Dialogue: 0,0:00:09.18,0:00:09.91,B,,0,0,0,,{\pos(540,1415)}y que te respeten
Dialogue: 0,0:00:09.91,0:00:10.62,B,,0,0,0,,{\pos(540,1415)}porque se nota
Dialogue: 0,0:00:10.62,0:00:11.31,B,,0,0,0,,{\pos(540,1415)}que lo estás haciendo
Dialogue: 0,0:00:11.31,0:00:12.06,B,,0,0,0,,{\pos(540,1415)}para que te quieran
Dialogue: 0,0:00:12.06,0:00:12.62,B,,0,0,0,,{\pos(540,1415)}Y tú que lo das
Dialogue: 0,0:00:12.62,0:00:12.96,B,,0,0,0,,{\pos(540,1415)}todo
Dialogue: 0,0:00:12.96,0:00:14.00,B,,0,0,0,,{\pos(540,1415)}acabas sintiendo que nunca
Dialogue: 0,0:00:14.00,0:00:14.80,B,,0,0,0,,{\pos(540,1415)}es suficiente
Dialogue: 0,0:00:14.80,0:00:15.12,B,,0,0,0,,{\pos(540,1415)}Entonces
Dialogue: 0,0:00:15.12,0:00:15.63,B,,0,0,0,,{\pos(540,1415)}¿qué cambia?
Dialogue: 0,0:00:15.63,0:00:16.35,B,,0,0,0,,{\pos(540,1415)}Dos cosas
Dialogue: 0,0:00:16.35,0:00:17.12,B,,0,0,0,,{\pos(540,1415)}La primera es que cuando
Dialogue: 0,0:00:17.12,0:00:18.27,B,,0,0,0,,{\pos(540,1415)}dices que sí queriendo decir
Dialogue: 0,0:00:18.27,0:00:18.61,B,,0,0,0,,{\pos(540,1415)}que no
Dialogue: 0,0:00:18.61,0:00:19.80,B,,0,0,0,,{\pos(540,1415)}te estás traicionando y eso
Dialogue: 0,0:00:19.80,0:00:21.21,B,,0,0,0,,{\pos(540,1415)}te hace bajar tu energía
Dialogue: 0,0:00:21.21,0:00:21.62,B,,0,0,0,,{\pos(540,1415)}y por tanto
Dialogue: 0,0:00:21.62,0:00:22.17,B,,0,0,0,,{\pos(540,1415)}tu autoestima
Dialogue: 0,0:00:22.17,0:00:23.12,B,,0,0,0,,{\pos(540,1415)}Y la gente lo nota
Dialogue: 0,0:00:23.12,0:00:24.20,B,,0,0,0,,{\pos(540,1415)}aunque no sepa explicarlo
Dialogue: 0,0:00:24.20,0:00:24.81,B,,0,0,0,,{\pos(540,1415)}Y la segunda
Dialogue: 0,0:00:24.81,0:00:25.83,B,,0,0,0,,{\pos(540,1415)}es que no te eliges
Dialogue: 0,0:00:25.83,0:00:26.32,B,,0,0,0,,{\pos(540,1415)}tú primero
Dialogue: 0,0:00:26.32,0:00:27.21,B,,0,0,0,,{\pos(540,1415)}Y no desde el orgullo
Dialogue: 0,0:00:27.21,0:00:28.06,B,,0,0,0,,{\pos(540,1415)}sino el respeto
Dialogue: 0,0:00:28.06,0:00:28.78,B,,0,0,0,,{\pos(540,1415)}y piénsalo bien
Dialogue: 0,0:00:28.78,0:00:29.36,B,,0,0,0,,{\pos(540,1415)}nadie se va a quedar
Dialogue: 0,0:00:29.36,0:00:30.05,B,,0,0,0,,{\pos(540,1415)}al lado ni va
Dialogue: 0,0:00:30.05,0:00:30.74,B,,0,0,0,,{\pos(540,1415)}a respetar a nadie
Dialogue: 0,0:00:30.74,0:00:31.54,B,,0,0,0,,{\pos(540,1415)}que no se respeta
Dialogue: 0,0:00:31.54,0:00:32.69,B,,0,0,0,,{\pos(540,1415)}Yo llegué a ganar 17.000
Dialogue: 0,0:00:32.69,0:00:33.27,B,,0,0,0,,{\pos(540,1415)}euros en un mes
Dialogue: 0,0:00:33.27,0:00:33.53,B,,0,0,0,,{\pos(540,1415)}y aún
Dialogue: 0,0:00:33.53,0:00:34.34,B,,0,0,0,,{\pos(540,1415)}así me sentía vacío
Dialogue: 0,0:00:34.34,0:00:35.21,B,,0,0,0,,{\pos(540,1415)}porque estaba buscando
Dialogue: 0,0:00:35.21,0:00:36.57,B,,0,0,0,,{\pos(540,1415)}que todo mi valor proveniera
Dialogue: 0,0:00:36.57,0:00:37.34,B,,0,0,0,,{\pos(540,1415)}de lo externo
Dialogue: 0,0:00:37.34,0:00:38.23,B,,0,0,0,,{\pos(540,1415)}Así que deja de darlo
Dialogue: 0,0:00:38.23,0:00:39.26,B,,0,0,0,,{\pos(540,1415)}todo para que te quieran
Dialogue: 0,0:00:39.26,0:00:40.34,B,,0,0,0,,{\pos(540,1415)}y empieza a dártelo tú
Dialogue: 0,0:00:40.34,0:00:40.95,B,,0,0,0,,{\pos(540,1415)}Porque cuando elevas
Dialogue: 0,0:00:40.95,0:00:41.84,B,,0,0,0,,{\pos(540,1415)}tu energía y mejoras
Dialogue: 0,0:00:41.84,0:00:42.48,B,,0,0,0,,{\pos(540,1415)}tu autoestima
Dialogue: 0,0:00:42.48,0:00:43.30,B,,0,0,0,,{\pos(540,1415)}la gente que te quiere
Dialogue: 0,0:00:43.30,0:00:44.38,B,,0,0,0,,{\pos(540,1415)}y te valora llega sola
