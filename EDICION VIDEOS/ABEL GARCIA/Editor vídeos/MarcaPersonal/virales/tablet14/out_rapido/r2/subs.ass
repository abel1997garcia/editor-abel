Dialogue: 0,0:00:00.00,0:00:00.91,B,,0,0,0,,{\pos(540,1415)}No te falta quererte
Dialogue: 0,0:00:00.91,0:00:01.92,B,,0,0,0,,{\pos(540,1415)}te sobra todo esto
Dialogue: 0,0:00:01.92,0:00:02.66,B,,0,0,0,,{\pos(540,1415)}Dices que sí a todo
Dialogue: 0,0:00:02.66,0:00:03.66,B,,0,0,0,,{\pos(540,1415)}para que nadie se enfade
Dialogue: 0,0:00:03.66,0:00:04.09,B,,0,0,0,,{\pos(540,1415)}contigo
Dialogue: 0,0:00:04.09,0:00:04.96,B,,0,0,0,,{\pos(540,1415)}Te comparas con la vida
Dialogue: 0,0:00:04.96,0:00:05.88,B,,0,0,0,,{\pos(540,1415)}que los demás enseñan
Dialogue: 0,0:00:05.88,0:00:06.89,B,,0,0,0,,{\pos(540,1415)}por redes y que sabes
Dialogue: 0,0:00:06.89,0:00:07.40,B,,0,0,0,,{\pos(540,1415)}que es falsa
Dialogue: 0,0:00:07.40,0:00:08.67,B,,0,0,0,,{\pos(540,1415)}Te prometes cosas que luego
Dialogue: 0,0:00:08.67,0:00:09.23,B,,0,0,0,,{\pos(540,1415)}no cumples
Dialogue: 0,0:00:09.23,0:00:10.06,B,,0,0,0,,{\pos(540,1415)}Necesitas que alguien
Dialogue: 0,0:00:10.06,0:00:10.97,B,,0,0,0,,{\pos(540,1415)}te valide para sentir
Dialogue: 0,0:00:10.97,0:00:11.53,B,,0,0,0,,{\pos(540,1415)}que vales
Dialogue: 0,0:00:11.53,0:00:12.19,B,,0,0,0,,{\pos(540,1415)}Tapas lo que sientes
Dialogue: 0,0:00:12.19,0:00:12.78,B,,0,0,0,,{\pos(540,1415)}con el móvil
Dialogue: 0,0:00:12.78,0:00:13.44,B,,0,0,0,,{\pos(540,1415)}con la fiesta
Dialogue: 0,0:00:13.44,0:00:14.34,B,,0,0,0,,{\pos(540,1415)}con los videojuegos
Dialogue: 0,0:00:14.34,0:00:14.93,B,,0,0,0,,{\pos(540,1415)}o con el alcohol
Dialogue: 0,0:00:14.93,0:00:16.25,B,,0,0,0,,{\pos(540,1415)}Consumes cada día justo
Dialogue: 0,0:00:16.25,0:00:16.68,B,,0,0,0,,{\pos(540,1415)}lo que te baja
Dialogue: 0,0:00:16.68,0:00:17.24,B,,0,0,0,,{\pos(540,1415)}la energía
Dialogue: 0,0:00:17.24,0:00:18.54,B,,0,0,0,,{\pos(540,1415)}Hablas desde la queja todo
Dialogue: 0,0:00:18.54,0:00:19.10,B,,0,0,0,,{\pos(540,1415)}el puto día
Dialogue: 0,0:00:19.10,0:00:19.76,B,,0,0,0,,{\pos(540,1415)}Te rodeas de gente
Dialogue: 0,0:00:19.76,0:00:20.43,B,,0,0,0,,{\pos(540,1415)}que te resta
Dialogue: 0,0:00:20.43,0:00:21.19,B,,0,0,0,,{\pos(540,1415)}y que no tiene ambición
Dialogue: 0,0:00:21.19,0:00:22.00,B,,0,0,0,,{\pos(540,1415)}Nunca te paras a estar
Dialogue: 0,0:00:22.00,0:00:22.85,B,,0,0,0,,{\pos(540,1415)}en silencio y a escuchar
Dialogue: 0,0:00:22.85,0:00:23.71,B,,0,0,0,,{\pos(540,1415)}lo que sientes
Dialogue: 0,0:00:23.71,0:00:24.58,B,,0,0,0,,{\pos(540,1415)}Y vives en tu cabeza
Dialogue: 0,0:00:24.58,0:00:25.85,B,,0,0,0,,{\pos(540,1415)}pensando sin parar y nunca
Dialogue: 0,0:00:25.85,0:00:26.69,B,,0,0,0,,{\pos(540,1415)}te has parado a mirar
Dialogue: 0,0:00:26.69,0:00:27.80,B,,0,0,0,,{\pos(540,1415)}de dónde viene todo eso
Dialogue: 0,0:00:27.80,0:00:28.72,B,,0,0,0,,{\pos(540,1415)}que es de lo que viviste
Dialogue: 0,0:00:28.72,0:00:29.10,B,,0,0,0,,{\pos(540,1415)}de pequeño
Dialogue: 0,0:00:29.10,0:00:29.67,B,,0,0,0,,{\pos(540,1415)}Así que no te hace
Dialogue: 0,0:00:29.67,0:00:30.34,B,,0,0,0,,{\pos(540,1415)}falta quererte
Dialogue: 0,0:00:30.34,0:00:30.78,B,,0,0,0,,{\pos(540,1415)}te sobra todo
Dialogue: 0,0:00:30.78,0:00:31.95,B,,0,0,0,,{\pos(540,1415)}lo que te quita energía
Dialogue: 0,0:00:31.95,0:00:32.68,B,,0,0,0,,{\pos(540,1415)}Empieza por una
Dialogue: 0,0:00:32.68,0:00:33.17,B,,0,0,0,,{\pos(540,1415)}la que más te ha
Dialogue: 0,0:00:33.17,0:00:34.17,B,,0,0,0,,{\pos(540,1415)}dolido escucharla
Dialogue: 0,0:00:34.17,0:00:35.23,B,,0,0,0,,{\pos(540,1415)}y verás cómo cambia todo
