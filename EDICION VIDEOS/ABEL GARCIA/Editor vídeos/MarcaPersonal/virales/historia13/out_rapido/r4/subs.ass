Dialogue: 0,0:00:00.01,0:00:01.31,B,,0,0,0,,{\pos(540,1415)}Tus frases bonitas siempre
Dialogue: 0,0:00:01.31,0:00:02.59,B,,0,0,0,,{\pos(540,1415)}pierden contra tu mala hostia
Dialogue: 0,0:00:02.59,0:00:03.33,B,,0,0,0,,{\pos(540,1415)}La ley de atracción no
Dialogue: 0,0:00:03.33,0:00:03.84,B,,0,0,0,,{\pos(540,1415)}funciona
Dialogue: 0,0:00:03.84,0:00:04.74,B,,0,0,0,,{\pos(540,1415)}pienso en positivo y no
Dialogue: 0,0:00:04.74,0:00:05.34,B,,0,0,0,,{\pos(540,1415)}cambia nada
Dialogue: 0,0:00:05.34,0:00:06.41,B,,0,0,0,,{\pos(540,1415)}No atraes lo que piensas
Dialogue: 0,0:00:06.41,0:00:06.74,B,,0,0,0,,{\pos(540,1415)}si no
Dialogue: 0,0:00:06.74,0:00:07.83,B,,0,0,0,,{\pos(540,1415)}pensarías en un dragón
Dialogue: 0,0:00:07.83,0:00:09.26,B,,0,0,0,,{\pos(540,1415)}y ese dragón automáticamente
Dialogue: 0,0:00:09.26,0:00:10.46,B,,0,0,0,,{\pos(540,1415)}aparecería en el sofá
Dialogue: 0,0:00:10.46,0:00:10.79,B,,0,0,0,,{\pos(540,1415)}de tu casa
Dialogue: 0,0:00:10.79,0:00:11.66,B,,0,0,0,,{\pos(540,1415)}Atraes lo que eres
Dialogue: 0,0:00:11.66,0:00:12.58,B,,0,0,0,,{\pos(540,1415)}y eso lo llevas durante
Dialogue: 0,0:00:12.58,0:00:13.91,B,,0,0,0,,{\pos(540,1415)}tanto tiempo que se queda
Dialogue: 0,0:00:13.91,0:00:14.66,B,,0,0,0,,{\pos(540,1415)}dentro de ti como
Dialogue: 0,0:00:14.66,0:00:15.54,B,,0,0,0,,{\pos(540,1415)}una verdad absoluta
Dialogue: 0,0:00:15.54,0:00:16.49,B,,0,0,0,,{\pos(540,1415)}Si durante 5 minutos
Dialogue: 0,0:00:16.49,0:00:17.17,B,,0,0,0,,{\pos(540,1415)}al día te dices
Dialogue: 0,0:00:17.17,0:00:18.04,B,,0,0,0,,{\pos(540,1415)}que vales mucho
Dialogue: 0,0:00:18.04,0:00:18.89,B,,0,0,0,,{\pos(540,1415)}y que te quieres mucho
Dialogue: 0,0:00:18.89,0:00:20.08,B,,0,0,0,,{\pos(540,1415)}pero durante todo tu día
Dialogue: 0,0:00:20.08,0:00:21.00,B,,0,0,0,,{\pos(540,1415)}estás pensando que esto
Dialogue: 0,0:00:21.00,0:00:21.65,B,,0,0,0,,{\pos(540,1415)}es una mierda
Dialogue: 0,0:00:21.65,0:00:22.73,B,,0,0,0,,{\pos(540,1415)}quejándote etc
Dialogue: 0,0:00:22.73,0:00:23.83,B,,0,0,0,,{\pos(540,1415)}Siempre gana tu cabeza
Dialogue: 0,0:00:23.83,0:00:25.28,B,,0,0,0,,{\pos(540,1415)}Te repites tus frases bonitas
Dialogue: 0,0:00:25.28,0:00:25.95,B,,0,0,0,,{\pos(540,1415)}por la mañana
