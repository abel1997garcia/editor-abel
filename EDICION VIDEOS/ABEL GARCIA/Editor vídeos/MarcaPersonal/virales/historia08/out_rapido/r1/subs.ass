Dialogue: 0,0:00:00.13,0:00:00.79,B,,0,0,0,,{\pos(540,1415)}No puedes conseguir
Dialogue: 0,0:00:00.79,0:00:01.55,B,,0,0,0,,{\pos(540,1415)}lo que en el fondo
Dialogue: 0,0:00:01.55,0:00:02.55,B,,0,0,0,,{\pos(540,1415)}crees que es imposible
Dialogue: 0,0:00:02.55,0:00:03.18,B,,0,0,0,,{\pos(540,1415)}¿Quieres una pareja
Dialogue: 0,0:00:03.18,0:00:04.21,B,,0,0,0,,{\pos(540,1415)}que te quiera de verdad
Dialogue: 0,0:00:04.21,0:00:05.23,B,,0,0,0,,{\pos(540,1415)}vivir de tu negocio
Dialogue: 0,0:00:05.23,0:00:06.10,B,,0,0,0,,{\pos(540,1415)}tener libertad
Dialogue: 0,0:00:06.10,0:00:07.42,B,,0,0,0,,{\pos(540,1415)}y cuando piensas en eso?
Dialogue: 0,0:00:07.42,0:00:08.13,B,,0,0,0,,{\pos(540,1415)}Hay una parte de ti
Dialogue: 0,0:00:08.13,0:00:08.60,B,,0,0,0,,{\pos(540,1415)}que dice
Dialogue: 0,0:00:08.60,0:00:09.19,B,,0,0,0,,{\pos(540,1415)}Ojalá
Dialogue: 0,0:00:09.19,0:00:09.94,B,,0,0,0,,{\pos(540,1415)}algún día
Dialogue: 0,0:00:09.94,0:00:10.67,B,,0,0,0,,{\pos(540,1415)}ya veremos
Dialogue: 0,0:00:10.67,0:00:11.70,B,,0,0,0,,{\pos(540,1415)}Ahí ya lo estás alejando
Dialogue: 0,0:00:11.70,0:00:12.89,B,,0,0,0,,{\pos(540,1415)}porque en el fondo piensas
Dialogue: 0,0:00:12.89,0:00:13.83,B,,0,0,0,,{\pos(540,1415)}que tú no tienes
Dialogue: 0,0:00:13.83,0:00:15.23,B,,0,0,0,,{\pos(540,1415)}la capacidad de merecer eso
Dialogue: 0,0:00:15.23,0:00:15.78,B,,0,0,0,,{\pos(540,1415)}y que solo
Dialogue: 0,0:00:15.78,0:00:16.54,B,,0,0,0,,{\pos(540,1415)}es para los otros
Dialogue: 0,0:00:16.54,0:00:17.48,B,,0,0,0,,{\pos(540,1415)}Si tu cabeza pone algo
Dialogue: 0,0:00:17.48,0:00:18.36,B,,0,0,0,,{\pos(540,1415)}en un pedestal
Dialogue: 0,0:00:18.36,0:00:19.58,B,,0,0,0,,{\pos(540,1415)}algo que no alcanzas
Dialogue: 0,0:00:19.58,0:00:20.50,B,,0,0,0,,{\pos(540,1415)}jamás te va a llegar
Dialogue: 0,0:00:20.50,0:00:21.18,B,,0,0,0,,{\pos(540,1415)}Porque no atraes
Dialogue: 0,0:00:21.18,0:00:21.89,B,,0,0,0,,{\pos(540,1415)}lo que quieres
Dialogue: 0,0:00:21.89,0:00:22.30,B,,0,0,0,,{\pos(540,1415)}atraes
Dialogue: 0,0:00:22.30,0:00:23.24,B,,0,0,0,,{\pos(540,1415)}lo que en el fondo
Dialogue: 0,0:00:23.24,0:00:24.29,B,,0,0,0,,{\pos(540,1415)}crees que mereces
Dialogue: 0,0:00:24.29,0:00:25.03,B,,0,0,0,,{\pos(540,1415)}Y tienes que hacerlo tan
Dialogue: 0,0:00:25.03,0:00:25.89,B,,0,0,0,,{\pos(540,1415)}normal como si fueras
Dialogue: 0,0:00:25.89,0:00:26.90,B,,0,0,0,,{\pos(540,1415)}a un bar y pidieras
Dialogue: 0,0:00:26.90,0:00:27.34,B,,0,0,0,,{\pos(540,1415)}un café
Dialogue: 0,0:00:27.34,0:00:28.08,B,,0,0,0,,{\pos(540,1415)}Y esto se entrena
Dialogue: 0,0:00:28.08,0:00:28.88,B,,0,0,0,,{\pos(540,1415)}con lo pequeño
Dialogue: 0,0:00:28.88,0:00:29.84,B,,0,0,0,,{\pos(540,1415)}Imagínate cuando te llega
Dialogue: 0,0:00:29.84,0:00:30.96,B,,0,0,0,,{\pos(540,1415)}la factura de la luz
Dialogue: 0,0:00:30.96,0:00:32.27,B,,0,0,0,,{\pos(540,1415)}que hay como ese miedo
Dialogue: 0,0:00:32.27,0:00:33.49,B,,0,0,0,,{\pos(540,1415)}o esa insuficiencia
Dialogue: 0,0:00:33.49,0:00:33.94,B,,0,0,0,,{\pos(540,1415)}de decir
Dialogue: 0,0:00:33.94,0:00:34.35,B,,0,0,0,,{\pos(540,1415)}Joder
Dialogue: 0,0:00:34.35,0:00:35.26,B,,0,0,0,,{\pos(540,1415)}ya me han quitado otra
Dialogue: 0,0:00:35.26,0:00:36.13,B,,0,0,0,,{\pos(540,1415)}vez ese dinero
Dialogue: 0,0:00:36.13,0:00:36.88,B,,0,0,0,,{\pos(540,1415)}La persona que tiene
Dialogue: 0,0:00:36.88,0:00:37.93,B,,0,0,0,,{\pos(540,1415)}la vida que quieres actúa
Dialogue: 0,0:00:37.93,0:00:39.04,B,,0,0,0,,{\pos(540,1415)}de forma completamente
Dialogue: 0,0:00:39.04,0:00:39.69,B,,0,0,0,,{\pos(540,1415)}diferente
Dialogue: 0,0:00:39.69,0:00:40.35,B,,0,0,0,,{\pos(540,1415)}La paga
Dialogue: 0,0:00:40.35,0:00:41.21,B,,0,0,0,,{\pos(540,1415)}se siente abundante
Dialogue: 0,0:00:41.21,0:00:42.28,B,,0,0,0,,{\pos(540,1415)}y lo agradece y sigue
Dialogue: 0,0:00:42.28,0:00:42.81,B,,0,0,0,,{\pos(540,1415)}con su día
Dialogue: 0,0:00:42.81,0:00:43.56,B,,0,0,0,,{\pos(540,1415)}Esa es la persona
Dialogue: 0,0:00:43.56,0:00:44.24,B,,0,0,0,,{\pos(540,1415)}que tienes que empezar
Dialogue: 0,0:00:44.24,0:00:44.59,B,,0,0,0,,{\pos(540,1415)}a ser
Dialogue: 0,0:00:44.59,0:00:45.74,B,,0,0,0,,{\pos(540,1415)}en cómo reaccionas
Dialogue: 0,0:00:45.74,0:00:46.80,B,,0,0,0,,{\pos(540,1415)}y en cómo te comportas
Dialogue: 0,0:00:46.80,0:00:47.56,B,,0,0,0,,{\pos(540,1415)}no por lo que no
Dialogue: 0,0:00:47.56,0:00:48.03,B,,0,0,0,,{\pos(540,1415)}tienes
Dialogue: 0,0:00:48.03,0:00:48.90,B,,0,0,0,,{\pos(540,1415)}La próxima vez que algo
Dialogue: 0,0:00:48.90,0:00:49.65,B,,0,0,0,,{\pos(540,1415)}se tuerza
Dialogue: 0,0:00:49.65,0:00:51.01,B,,0,0,0,,{\pos(540,1415)}piensa en cómo actuaría esa
Dialogue: 0,0:00:51.01,0:00:52.22,B,,0,0,0,,{\pos(540,1415)}mejor versión de ti
Dialogue: 0,0:00:52.22,0:00:52.94,B,,0,0,0,,{\pos(540,1415)}que ya tiene
Dialogue: 0,0:00:52.94,0:00:53.40,B,,0,0,0,,{\pos(540,1415)}lo que quiere
Dialogue: 0,0:00:53.40,0:00:54.19,B,,0,0,0,,{\pos(540,1415)}y que vive la vida
Dialogue: 0,0:00:54.19,0:00:54.62,B,,0,0,0,,{\pos(540,1415)}soñada
Dialogue: 0,0:00:54.62,0:00:55.24,B,,0,0,0,,{\pos(540,1415)}Y haz. eso
