Dialogue: 0,0:00:00.00,0:00:00.73,B,,0,0,0,,{\pos(540,1415)}Si piensas
Dialogue: 0,0:00:00.73,0:00:01.82,B,,0,0,0,,{\pos(540,1415)}ojalá algún día
Dialogue: 0,0:00:01.82,0:00:02.54,B,,0,0,0,,{\pos(540,1415)}Ya lo has perdido
Dialogue: 0,0:00:02.54,0:00:03.14,B,,0,0,0,,{\pos(540,1415)}para siempre
Dialogue: 0,0:00:03.14,0:00:03.76,B,,0,0,0,,{\pos(540,1415)}¿Quieres una pareja
Dialogue: 0,0:00:03.76,0:00:04.80,B,,0,0,0,,{\pos(540,1415)}que te quiera de verdad
Dialogue: 0,0:00:04.80,0:00:05.82,B,,0,0,0,,{\pos(540,1415)}vivir de tu negocio
Dialogue: 0,0:00:05.82,0:00:06.69,B,,0,0,0,,{\pos(540,1415)}tener libertad
Dialogue: 0,0:00:06.69,0:00:08.01,B,,0,0,0,,{\pos(540,1415)}y cuando piensas en eso?
Dialogue: 0,0:00:08.01,0:00:08.72,B,,0,0,0,,{\pos(540,1415)}Hay una parte de ti
Dialogue: 0,0:00:08.72,0:00:09.17,B,,0,0,0,,{\pos(540,1415)}que dice
Dialogue: 0,0:00:09.17,0:00:09.77,B,,0,0,0,,{\pos(540,1415)}Ojalá
Dialogue: 0,0:00:09.77,0:00:10.52,B,,0,0,0,,{\pos(540,1415)}algún día
Dialogue: 0,0:00:10.52,0:00:11.25,B,,0,0,0,,{\pos(540,1415)}ya veremos
Dialogue: 0,0:00:11.25,0:00:12.28,B,,0,0,0,,{\pos(540,1415)}Ahí ya lo estás alejando
Dialogue: 0,0:00:12.28,0:00:13.47,B,,0,0,0,,{\pos(540,1415)}porque en el fondo piensas
Dialogue: 0,0:00:13.47,0:00:14.41,B,,0,0,0,,{\pos(540,1415)}que tú no tienes
Dialogue: 0,0:00:14.41,0:00:15.81,B,,0,0,0,,{\pos(540,1415)}la capacidad de merecer eso
Dialogue: 0,0:00:15.81,0:00:16.36,B,,0,0,0,,{\pos(540,1415)}y que solo
Dialogue: 0,0:00:16.36,0:00:17.12,B,,0,0,0,,{\pos(540,1415)}es para los otros
Dialogue: 0,0:00:17.12,0:00:18.07,B,,0,0,0,,{\pos(540,1415)}Si tu cabeza pone algo
Dialogue: 0,0:00:18.07,0:00:18.94,B,,0,0,0,,{\pos(540,1415)}en un pedestal
Dialogue: 0,0:00:18.94,0:00:20.17,B,,0,0,0,,{\pos(540,1415)}algo que no alcanzas
Dialogue: 0,0:00:20.17,0:00:21.08,B,,0,0,0,,{\pos(540,1415)}jamás te va a llegar
Dialogue: 0,0:00:21.08,0:00:21.76,B,,0,0,0,,{\pos(540,1415)}Porque no atraes
Dialogue: 0,0:00:21.76,0:00:22.47,B,,0,0,0,,{\pos(540,1415)}lo que quieres
Dialogue: 0,0:00:22.47,0:00:23.05,B,,0,0,0,,{\pos(540,1415)}atraes
Dialogue: 0,0:00:23.05,0:00:23.83,B,,0,0,0,,{\pos(540,1415)}lo que en el fondo
Dialogue: 0,0:00:23.83,0:00:24.88,B,,0,0,0,,{\pos(540,1415)}crees que mereces
Dialogue: 0,0:00:24.88,0:00:25.61,B,,0,0,0,,{\pos(540,1415)}Y tienes que hacerlo tan
Dialogue: 0,0:00:25.61,0:00:26.48,B,,0,0,0,,{\pos(540,1415)}normal como si fueras
Dialogue: 0,0:00:26.48,0:00:27.48,B,,0,0,0,,{\pos(540,1415)}a un bar y pidieras
Dialogue: 0,0:00:27.48,0:00:27.92,B,,0,0,0,,{\pos(540,1415)}un café
Dialogue: 0,0:00:27.92,0:00:28.67,B,,0,0,0,,{\pos(540,1415)}Y esto se entrena
Dialogue: 0,0:00:28.67,0:00:29.46,B,,0,0,0,,{\pos(540,1415)}con lo pequeño
Dialogue: 0,0:00:29.46,0:00:30.52,B,,0,0,0,,{\pos(540,1415)}Imagínate cuando te llega
Dialogue: 0,0:00:30.52,0:00:31.55,B,,0,0,0,,{\pos(540,1415)}la factura de la luz
Dialogue: 0,0:00:31.55,0:00:32.88,B,,0,0,0,,{\pos(540,1415)}que hay como ese miedo
Dialogue: 0,0:00:32.88,0:00:34.08,B,,0,0,0,,{\pos(540,1415)}o esa insuficiencia
Dialogue: 0,0:00:34.08,0:00:34.53,B,,0,0,0,,{\pos(540,1415)}de decir
Dialogue: 0,0:00:34.53,0:00:34.94,B,,0,0,0,,{\pos(540,1415)}Joder
Dialogue: 0,0:00:34.94,0:00:35.85,B,,0,0,0,,{\pos(540,1415)}ya me han quitado otra
Dialogue: 0,0:00:35.85,0:00:36.72,B,,0,0,0,,{\pos(540,1415)}vez ese dinero
Dialogue: 0,0:00:36.72,0:00:37.46,B,,0,0,0,,{\pos(540,1415)}La persona que tiene
Dialogue: 0,0:00:37.46,0:00:38.51,B,,0,0,0,,{\pos(540,1415)}la vida que quieres actúa
Dialogue: 0,0:00:38.51,0:00:39.62,B,,0,0,0,,{\pos(540,1415)}de forma completamente
Dialogue: 0,0:00:39.62,0:00:40.28,B,,0,0,0,,{\pos(540,1415)}diferente
Dialogue: 0,0:00:40.28,0:00:40.81,B,,0,0,0,,{\pos(540,1415)}La paga
Dialogue: 0,0:00:40.81,0:00:41.80,B,,0,0,0,,{\pos(540,1415)}se siente abundante
Dialogue: 0,0:00:41.80,0:00:42.86,B,,0,0,0,,{\pos(540,1415)}y lo agradece y sigue
Dialogue: 0,0:00:42.86,0:00:43.40,B,,0,0,0,,{\pos(540,1415)}con su día
Dialogue: 0,0:00:43.40,0:00:44.15,B,,0,0,0,,{\pos(540,1415)}Esa es la persona
Dialogue: 0,0:00:44.15,0:00:44.83,B,,0,0,0,,{\pos(540,1415)}que tienes que empezar
Dialogue: 0,0:00:44.83,0:00:45.18,B,,0,0,0,,{\pos(540,1415)}a ser
Dialogue: 0,0:00:45.18,0:00:46.32,B,,0,0,0,,{\pos(540,1415)}en cómo reaccionas
Dialogue: 0,0:00:46.32,0:00:47.39,B,,0,0,0,,{\pos(540,1415)}y en cómo te comportas
Dialogue: 0,0:00:47.39,0:00:48.14,B,,0,0,0,,{\pos(540,1415)}no por lo que no
Dialogue: 0,0:00:48.14,0:00:48.62,B,,0,0,0,,{\pos(540,1415)}tienes
Dialogue: 0,0:00:48.62,0:00:49.49,B,,0,0,0,,{\pos(540,1415)}La próxima vez que algo
Dialogue: 0,0:00:49.49,0:00:50.24,B,,0,0,0,,{\pos(540,1415)}se tuerza
Dialogue: 0,0:00:50.24,0:00:51.59,B,,0,0,0,,{\pos(540,1415)}piensa en cómo actuaría esa
Dialogue: 0,0:00:51.59,0:00:52.81,B,,0,0,0,,{\pos(540,1415)}mejor versión de ti
Dialogue: 0,0:00:52.81,0:00:53.53,B,,0,0,0,,{\pos(540,1415)}que ya tiene
Dialogue: 0,0:00:53.53,0:00:53.99,B,,0,0,0,,{\pos(540,1415)}lo que quiere
Dialogue: 0,0:00:53.99,0:00:54.67,B,,0,0,0,,{\pos(540,1415)}y que vive la vida
Dialogue: 0,0:00:54.67,0:00:55.19,B,,0,0,0,,{\pos(540,1415)}soñada
Dialogue: 0,0:00:55.19,0:00:55.81,B,,0,0,0,,{\pos(540,1415)}Y haz. eso
