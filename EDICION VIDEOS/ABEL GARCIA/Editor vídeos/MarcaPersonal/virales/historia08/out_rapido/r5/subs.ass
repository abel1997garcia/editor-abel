Dialogue: 0,0:00:00.00,0:00:01.22,B,,0,0,0,,{\pos(540,1415)}Cada vez que dices ojalá
Dialogue: 0,0:00:01.22,0:00:01.65,B,,0,0,0,,{\pos(540,1415)}Te alejas
Dialogue: 0,0:00:01.65,0:00:02.28,B,,0,0,0,,{\pos(540,1415)}de lo que quieres
Dialogue: 0,0:00:02.28,0:00:02.91,B,,0,0,0,,{\pos(540,1415)}¿Quieres una pareja
Dialogue: 0,0:00:02.91,0:00:03.94,B,,0,0,0,,{\pos(540,1415)}que te quiera de verdad
Dialogue: 0,0:00:03.94,0:00:04.96,B,,0,0,0,,{\pos(540,1415)}vivir de tu negocio
Dialogue: 0,0:00:04.96,0:00:05.84,B,,0,0,0,,{\pos(540,1415)}tener libertad
Dialogue: 0,0:00:05.84,0:00:07.12,B,,0,0,0,,{\pos(540,1415)}y cuando piensas en eso?
Dialogue: 0,0:00:07.12,0:00:07.83,B,,0,0,0,,{\pos(540,1415)}Hay una parte de ti
Dialogue: 0,0:00:07.83,0:00:08.28,B,,0,0,0,,{\pos(540,1415)}que dice
Dialogue: 0,0:00:08.28,0:00:08.88,B,,0,0,0,,{\pos(540,1415)}Ojalá
Dialogue: 0,0:00:08.88,0:00:09.64,B,,0,0,0,,{\pos(540,1415)}algún día
Dialogue: 0,0:00:09.64,0:00:10.36,B,,0,0,0,,{\pos(540,1415)}ya veremos
Dialogue: 0,0:00:10.36,0:00:11.40,B,,0,0,0,,{\pos(540,1415)}Ahí ya lo estás alejando
Dialogue: 0,0:00:11.40,0:00:12.59,B,,0,0,0,,{\pos(540,1415)}porque en el fondo piensas
Dialogue: 0,0:00:12.59,0:00:13.53,B,,0,0,0,,{\pos(540,1415)}que tú no tienes
Dialogue: 0,0:00:13.53,0:00:14.93,B,,0,0,0,,{\pos(540,1415)}la capacidad de merecer eso
Dialogue: 0,0:00:14.93,0:00:15.48,B,,0,0,0,,{\pos(540,1415)}y que solo
Dialogue: 0,0:00:15.48,0:00:16.24,B,,0,0,0,,{\pos(540,1415)}es para los otros
Dialogue: 0,0:00:16.24,0:00:17.18,B,,0,0,0,,{\pos(540,1415)}Si tu cabeza pone algo
Dialogue: 0,0:00:17.18,0:00:18.06,B,,0,0,0,,{\pos(540,1415)}en un pedestal
Dialogue: 0,0:00:18.06,0:00:19.28,B,,0,0,0,,{\pos(540,1415)}algo que no alcanzas
Dialogue: 0,0:00:19.28,0:00:20.19,B,,0,0,0,,{\pos(540,1415)}jamás te va a llegar
Dialogue: 0,0:00:20.19,0:00:20.89,B,,0,0,0,,{\pos(540,1415)}Porque no atraes
Dialogue: 0,0:00:20.89,0:00:21.55,B,,0,0,0,,{\pos(540,1415)}lo que quieres
Dialogue: 0,0:00:21.55,0:00:22.00,B,,0,0,0,,{\pos(540,1415)}atraes
Dialogue: 0,0:00:22.00,0:00:22.94,B,,0,0,0,,{\pos(540,1415)}lo que en el fondo
Dialogue: 0,0:00:22.94,0:00:23.99,B,,0,0,0,,{\pos(540,1415)}crees que mereces
Dialogue: 0,0:00:23.99,0:00:24.73,B,,0,0,0,,{\pos(540,1415)}Y tienes que hacerlo tan
Dialogue: 0,0:00:24.73,0:00:25.59,B,,0,0,0,,{\pos(540,1415)}normal como si fueras
Dialogue: 0,0:00:25.59,0:00:26.60,B,,0,0,0,,{\pos(540,1415)}a un bar y pidieras
Dialogue: 0,0:00:26.60,0:00:27.04,B,,0,0,0,,{\pos(540,1415)}un café
Dialogue: 0,0:00:27.04,0:00:27.78,B,,0,0,0,,{\pos(540,1415)}Y esto se entrena
Dialogue: 0,0:00:27.78,0:00:28.57,B,,0,0,0,,{\pos(540,1415)}con lo pequeño
Dialogue: 0,0:00:28.57,0:00:29.53,B,,0,0,0,,{\pos(540,1415)}Imagínate cuando te llega
Dialogue: 0,0:00:29.53,0:00:30.66,B,,0,0,0,,{\pos(540,1415)}la factura de la luz
Dialogue: 0,0:00:30.66,0:00:31.97,B,,0,0,0,,{\pos(540,1415)}que hay como ese miedo
Dialogue: 0,0:00:31.97,0:00:33.20,B,,0,0,0,,{\pos(540,1415)}o esa insuficiencia
Dialogue: 0,0:00:33.20,0:00:33.64,B,,0,0,0,,{\pos(540,1415)}de decir
Dialogue: 0,0:00:33.64,0:00:34.06,B,,0,0,0,,{\pos(540,1415)}Joder
Dialogue: 0,0:00:34.06,0:00:34.97,B,,0,0,0,,{\pos(540,1415)}ya me han quitado otra
Dialogue: 0,0:00:34.97,0:00:35.83,B,,0,0,0,,{\pos(540,1415)}vez ese dinero
Dialogue: 0,0:00:35.83,0:00:36.57,B,,0,0,0,,{\pos(540,1415)}La persona que tiene
Dialogue: 0,0:00:36.57,0:00:37.63,B,,0,0,0,,{\pos(540,1415)}la vida que quieres actúa
Dialogue: 0,0:00:37.63,0:00:38.74,B,,0,0,0,,{\pos(540,1415)}de forma completamente
Dialogue: 0,0:00:38.74,0:00:39.39,B,,0,0,0,,{\pos(540,1415)}diferente
Dialogue: 0,0:00:39.39,0:00:40.05,B,,0,0,0,,{\pos(540,1415)}La paga
Dialogue: 0,0:00:40.05,0:00:40.91,B,,0,0,0,,{\pos(540,1415)}se siente abundante
Dialogue: 0,0:00:40.91,0:00:41.98,B,,0,0,0,,{\pos(540,1415)}y lo agradece y sigue
Dialogue: 0,0:00:41.98,0:00:42.50,B,,0,0,0,,{\pos(540,1415)}con su día
Dialogue: 0,0:00:42.50,0:00:43.26,B,,0,0,0,,{\pos(540,1415)}Esa es la persona
Dialogue: 0,0:00:43.26,0:00:43.95,B,,0,0,0,,{\pos(540,1415)}que tienes que empezar
Dialogue: 0,0:00:43.95,0:00:44.29,B,,0,0,0,,{\pos(540,1415)}a ser
Dialogue: 0,0:00:44.29,0:00:45.34,B,,0,0,0,,{\pos(540,1415)}en cómo reaccionas
Dialogue: 0,0:00:45.34,0:00:46.50,B,,0,0,0,,{\pos(540,1415)}y en cómo te comportas
Dialogue: 0,0:00:46.50,0:00:47.26,B,,0,0,0,,{\pos(540,1415)}no por lo que no
Dialogue: 0,0:00:47.26,0:00:47.73,B,,0,0,0,,{\pos(540,1415)}tienes
Dialogue: 0,0:00:47.73,0:00:48.60,B,,0,0,0,,{\pos(540,1415)}La próxima vez que algo
Dialogue: 0,0:00:48.60,0:00:49.35,B,,0,0,0,,{\pos(540,1415)}se tuerza
Dialogue: 0,0:00:49.35,0:00:50.68,B,,0,0,0,,{\pos(540,1415)}piensa en cómo actuaría esa
Dialogue: 0,0:00:50.68,0:00:51.92,B,,0,0,0,,{\pos(540,1415)}mejor versión de ti
Dialogue: 0,0:00:51.92,0:00:52.65,B,,0,0,0,,{\pos(540,1415)}que ya tiene
Dialogue: 0,0:00:52.65,0:00:53.11,B,,0,0,0,,{\pos(540,1415)}lo que quiere
Dialogue: 0,0:00:53.11,0:00:53.79,B,,0,0,0,,{\pos(540,1415)}y que vive la vida
Dialogue: 0,0:00:53.79,0:00:54.32,B,,0,0,0,,{\pos(540,1415)}soñada
Dialogue: 0,0:00:54.32,0:00:54.94,B,,0,0,0,,{\pos(540,1415)}Y haz. eso
