Dialogue: 0,0:00:00.03,0:00:00.72,B,,0,0,0,,{\pos(540,1415)}Eso no es algo
Dialogue: 0,0:00:00.72,0:00:01.75,B,,0,0,0,,{\pos(540,1415)}para alguien como yo
Dialogue: 0,0:00:01.75,0:00:03.01,B,,0,0,0,,{\pos(540,1415)}Por eso nunca te llega
Dialogue: 0,0:00:03.01,0:00:03.63,B,,0,0,0,,{\pos(540,1415)}¿Quieres una pareja
Dialogue: 0,0:00:03.63,0:00:04.67,B,,0,0,0,,{\pos(540,1415)}que te quiera de verdad
Dialogue: 0,0:00:04.67,0:00:05.68,B,,0,0,0,,{\pos(540,1415)}vivir de tu negocio
Dialogue: 0,0:00:05.68,0:00:06.56,B,,0,0,0,,{\pos(540,1415)}tener libertad
Dialogue: 0,0:00:06.56,0:00:07.88,B,,0,0,0,,{\pos(540,1415)}y cuando piensas en eso?
Dialogue: 0,0:00:07.88,0:00:08.58,B,,0,0,0,,{\pos(540,1415)}Hay una parte de ti
Dialogue: 0,0:00:08.58,0:00:09.10,B,,0,0,0,,{\pos(540,1415)}que dice
Dialogue: 0,0:00:09.10,0:00:09.68,B,,0,0,0,,{\pos(540,1415)}Ojalá
Dialogue: 0,0:00:09.68,0:00:10.44,B,,0,0,0,,{\pos(540,1415)}algún día
Dialogue: 0,0:00:10.44,0:00:11.16,B,,0,0,0,,{\pos(540,1415)}ya veremos
Dialogue: 0,0:00:11.16,0:00:12.22,B,,0,0,0,,{\pos(540,1415)}Ahí ya lo estás alejando
Dialogue: 0,0:00:12.22,0:00:13.39,B,,0,0,0,,{\pos(540,1415)}porque en el fondo piensas
Dialogue: 0,0:00:13.39,0:00:14.33,B,,0,0,0,,{\pos(540,1415)}que tú no tienes
Dialogue: 0,0:00:14.33,0:00:15.73,B,,0,0,0,,{\pos(540,1415)}la capacidad de merecer eso
Dialogue: 0,0:00:15.73,0:00:16.28,B,,0,0,0,,{\pos(540,1415)}y que solo
Dialogue: 0,0:00:16.28,0:00:17.04,B,,0,0,0,,{\pos(540,1415)}es para los otros
Dialogue: 0,0:00:17.04,0:00:17.98,B,,0,0,0,,{\pos(540,1415)}Si tu cabeza pone algo
Dialogue: 0,0:00:17.98,0:00:18.86,B,,0,0,0,,{\pos(540,1415)}en un pedestal
Dialogue: 0,0:00:18.86,0:00:20.08,B,,0,0,0,,{\pos(540,1415)}algo que no alcanzas
Dialogue: 0,0:00:20.08,0:00:21.00,B,,0,0,0,,{\pos(540,1415)}jamás te va a llegar
Dialogue: 0,0:00:21.00,0:00:21.80,B,,0,0,0,,{\pos(540,1415)}Porque no atraes
Dialogue: 0,0:00:21.80,0:00:22.39,B,,0,0,0,,{\pos(540,1415)}lo que quieres
Dialogue: 0,0:00:22.39,0:00:22.80,B,,0,0,0,,{\pos(540,1415)}atraes
Dialogue: 0,0:00:22.80,0:00:23.75,B,,0,0,0,,{\pos(540,1415)}lo que en el fondo
Dialogue: 0,0:00:23.75,0:00:24.80,B,,0,0,0,,{\pos(540,1415)}crees que mereces
Dialogue: 0,0:00:24.80,0:00:25.53,B,,0,0,0,,{\pos(540,1415)}Y tienes que hacerlo tan
Dialogue: 0,0:00:25.53,0:00:26.39,B,,0,0,0,,{\pos(540,1415)}normal como si fueras
Dialogue: 0,0:00:26.39,0:00:27.40,B,,0,0,0,,{\pos(540,1415)}a un bar y pidieras
Dialogue: 0,0:00:27.40,0:00:27.83,B,,0,0,0,,{\pos(540,1415)}un café
Dialogue: 0,0:00:27.83,0:00:28.58,B,,0,0,0,,{\pos(540,1415)}Y esto se entrena
Dialogue: 0,0:00:28.58,0:00:29.38,B,,0,0,0,,{\pos(540,1415)}con lo pequeño
Dialogue: 0,0:00:29.38,0:00:30.33,B,,0,0,0,,{\pos(540,1415)}Imagínate cuando te llega
Dialogue: 0,0:00:30.33,0:00:31.46,B,,0,0,0,,{\pos(540,1415)}la factura de la luz
Dialogue: 0,0:00:31.46,0:00:32.77,B,,0,0,0,,{\pos(540,1415)}que hay como ese miedo
Dialogue: 0,0:00:32.77,0:00:33.99,B,,0,0,0,,{\pos(540,1415)}o esa insuficiencia
Dialogue: 0,0:00:33.99,0:00:34.45,B,,0,0,0,,{\pos(540,1415)}de decir
Dialogue: 0,0:00:34.45,0:00:34.86,B,,0,0,0,,{\pos(540,1415)}Joder
Dialogue: 0,0:00:34.86,0:00:35.76,B,,0,0,0,,{\pos(540,1415)}ya me han quitado otra
Dialogue: 0,0:00:35.76,0:00:36.63,B,,0,0,0,,{\pos(540,1415)}vez ese dinero
Dialogue: 0,0:00:36.63,0:00:37.20,B,,0,0,0,,{\pos(540,1415)}La persona que tiene
Dialogue: 0,0:00:37.20,0:00:38.43,B,,0,0,0,,{\pos(540,1415)}la vida que quieres actúa
Dialogue: 0,0:00:38.43,0:00:39.54,B,,0,0,0,,{\pos(540,1415)}de forma completamente
Dialogue: 0,0:00:39.54,0:00:40.19,B,,0,0,0,,{\pos(540,1415)}diferente
Dialogue: 0,0:00:40.19,0:00:40.86,B,,0,0,0,,{\pos(540,1415)}La paga
Dialogue: 0,0:00:40.86,0:00:41.72,B,,0,0,0,,{\pos(540,1415)}se siente abundante
Dialogue: 0,0:00:41.72,0:00:42.80,B,,0,0,0,,{\pos(540,1415)}y lo agradece y sigue
Dialogue: 0,0:00:42.80,0:00:43.31,B,,0,0,0,,{\pos(540,1415)}con su día
Dialogue: 0,0:00:43.31,0:00:44.06,B,,0,0,0,,{\pos(540,1415)}Esa es la persona
Dialogue: 0,0:00:44.06,0:00:44.75,B,,0,0,0,,{\pos(540,1415)}que tienes que empezar
Dialogue: 0,0:00:44.75,0:00:45.09,B,,0,0,0,,{\pos(540,1415)}a ser
Dialogue: 0,0:00:45.09,0:00:46.14,B,,0,0,0,,{\pos(540,1415)}en cómo reaccionas
Dialogue: 0,0:00:46.14,0:00:47.31,B,,0,0,0,,{\pos(540,1415)}y en cómo te comportas
Dialogue: 0,0:00:47.31,0:00:48.06,B,,0,0,0,,{\pos(540,1415)}no por lo que no
Dialogue: 0,0:00:48.06,0:00:48.53,B,,0,0,0,,{\pos(540,1415)}tienes
Dialogue: 0,0:00:48.53,0:00:49.40,B,,0,0,0,,{\pos(540,1415)}La próxima vez que algo
Dialogue: 0,0:00:49.40,0:00:50.15,B,,0,0,0,,{\pos(540,1415)}se tuerza
Dialogue: 0,0:00:50.15,0:00:51.48,B,,0,0,0,,{\pos(540,1415)}piensa en cómo actuaría esa
Dialogue: 0,0:00:51.48,0:00:52.72,B,,0,0,0,,{\pos(540,1415)}mejor versión de ti
Dialogue: 0,0:00:52.72,0:00:53.44,B,,0,0,0,,{\pos(540,1415)}que ya tiene
Dialogue: 0,0:00:53.44,0:00:53.91,B,,0,0,0,,{\pos(540,1415)}lo que quiere
Dialogue: 0,0:00:53.91,0:00:54.59,B,,0,0,0,,{\pos(540,1415)}y que vive la vida
Dialogue: 0,0:00:54.59,0:00:55.11,B,,0,0,0,,{\pos(540,1415)}soñada
Dialogue: 0,0:00:55.11,0:00:55.72,B,,0,0,0,,{\pos(540,1415)}Y haz. eso
