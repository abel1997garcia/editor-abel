Dialogue: 0,0:00:00.01,0:00:00.48,B,,0,0,0,,{\pos(540,1415)}Lo que pones
Dialogue: 0,0:00:00.48,0:00:01.51,B,,0,0,0,,{\pos(540,1415)}en un pedestal nunca
Dialogue: 0,0:00:01.51,0:00:02.42,B,,0,0,0,,{\pos(540,1415)}te llega y nunca
Dialogue: 0,0:00:02.42,0:00:02.93,B,,0,0,0,,{\pos(540,1415)}te va a llenar
Dialogue: 0,0:00:02.93,0:00:03.56,B,,0,0,0,,{\pos(540,1415)}¿Quieres una pareja
Dialogue: 0,0:00:03.56,0:00:04.59,B,,0,0,0,,{\pos(540,1415)}que te quiera de verdad
Dialogue: 0,0:00:04.59,0:00:05.61,B,,0,0,0,,{\pos(540,1415)}vivir de tu negocio
Dialogue: 0,0:00:05.61,0:00:06.49,B,,0,0,0,,{\pos(540,1415)}tener libertad
Dialogue: 0,0:00:06.49,0:00:07.79,B,,0,0,0,,{\pos(540,1415)}y cuando piensas en eso?
Dialogue: 0,0:00:07.79,0:00:08.46,B,,0,0,0,,{\pos(540,1415)}Hay una parte de ti
Dialogue: 0,0:00:08.46,0:00:08.98,B,,0,0,0,,{\pos(540,1415)}que dice
Dialogue: 0,0:00:08.98,0:00:09.57,B,,0,0,0,,{\pos(540,1415)}Ojalá
Dialogue: 0,0:00:09.57,0:00:10.33,B,,0,0,0,,{\pos(540,1415)}algún día
Dialogue: 0,0:00:10.33,0:00:11.05,B,,0,0,0,,{\pos(540,1415)}ya veremos
Dialogue: 0,0:00:11.05,0:00:12.08,B,,0,0,0,,{\pos(540,1415)}Ahí ya lo estás alejando
Dialogue: 0,0:00:12.08,0:00:13.27,B,,0,0,0,,{\pos(540,1415)}porque en el fondo piensas
Dialogue: 0,0:00:13.27,0:00:14.21,B,,0,0,0,,{\pos(540,1415)}que tú no tienes
Dialogue: 0,0:00:14.21,0:00:15.61,B,,0,0,0,,{\pos(540,1415)}la capacidad de merecer eso
Dialogue: 0,0:00:15.61,0:00:16.16,B,,0,0,0,,{\pos(540,1415)}y que solo
Dialogue: 0,0:00:16.16,0:00:16.93,B,,0,0,0,,{\pos(540,1415)}es para los otros
Dialogue: 0,0:00:16.93,0:00:17.87,B,,0,0,0,,{\pos(540,1415)}Si tu cabeza pone algo
Dialogue: 0,0:00:17.87,0:00:18.74,B,,0,0,0,,{\pos(540,1415)}en un pedestal
Dialogue: 0,0:00:18.74,0:00:19.97,B,,0,0,0,,{\pos(540,1415)}algo que no alcanzas
Dialogue: 0,0:00:19.97,0:00:20.88,B,,0,0,0,,{\pos(540,1415)}jamás te va a llegar
Dialogue: 0,0:00:20.88,0:00:21.56,B,,0,0,0,,{\pos(540,1415)}Porque no atraes
Dialogue: 0,0:00:21.56,0:00:22.27,B,,0,0,0,,{\pos(540,1415)}lo que quieres
Dialogue: 0,0:00:22.27,0:00:22.85,B,,0,0,0,,{\pos(540,1415)}atraes
Dialogue: 0,0:00:22.85,0:00:23.63,B,,0,0,0,,{\pos(540,1415)}lo que en el fondo
Dialogue: 0,0:00:23.63,0:00:24.68,B,,0,0,0,,{\pos(540,1415)}crees que mereces
Dialogue: 0,0:00:24.68,0:00:25.41,B,,0,0,0,,{\pos(540,1415)}Y tienes que hacerlo tan
Dialogue: 0,0:00:25.41,0:00:26.28,B,,0,0,0,,{\pos(540,1415)}normal como si fueras
Dialogue: 0,0:00:26.28,0:00:27.42,B,,0,0,0,,{\pos(540,1415)}a un bar y pidieras
Dialogue: 0,0:00:27.42,0:00:27.74,B,,0,0,0,,{\pos(540,1415)}un café
Dialogue: 0,0:00:27.74,0:00:28.48,B,,0,0,0,,{\pos(540,1415)}Y esto se entrena
Dialogue: 0,0:00:28.48,0:00:29.28,B,,0,0,0,,{\pos(540,1415)}con lo pequeño
Dialogue: 0,0:00:29.28,0:00:30.23,B,,0,0,0,,{\pos(540,1415)}Imagínate cuando te llega
Dialogue: 0,0:00:30.23,0:00:31.36,B,,0,0,0,,{\pos(540,1415)}la factura de la luz
Dialogue: 0,0:00:31.36,0:00:32.67,B,,0,0,0,,{\pos(540,1415)}que hay como ese miedo
Dialogue: 0,0:00:32.67,0:00:33.90,B,,0,0,0,,{\pos(540,1415)}o esa insuficiencia
Dialogue: 0,0:00:33.90,0:00:34.34,B,,0,0,0,,{\pos(540,1415)}de decir
Dialogue: 0,0:00:34.34,0:00:34.76,B,,0,0,0,,{\pos(540,1415)}Joder
Dialogue: 0,0:00:34.76,0:00:35.67,B,,0,0,0,,{\pos(540,1415)}ya me han quitado otra
Dialogue: 0,0:00:35.67,0:00:36.53,B,,0,0,0,,{\pos(540,1415)}vez ese dinero
Dialogue: 0,0:00:36.53,0:00:37.09,B,,0,0,0,,{\pos(540,1415)}La persona que tiene
Dialogue: 0,0:00:37.09,0:00:38.33,B,,0,0,0,,{\pos(540,1415)}la vida que quieres actúa
Dialogue: 0,0:00:38.33,0:00:39.44,B,,0,0,0,,{\pos(540,1415)}de forma completamente
Dialogue: 0,0:00:39.44,0:00:40.09,B,,0,0,0,,{\pos(540,1415)}diferente
Dialogue: 0,0:00:40.09,0:00:40.75,B,,0,0,0,,{\pos(540,1415)}La paga
Dialogue: 0,0:00:40.75,0:00:41.61,B,,0,0,0,,{\pos(540,1415)}se siente abundante
Dialogue: 0,0:00:41.61,0:00:42.68,B,,0,0,0,,{\pos(540,1415)}y lo agradece y sigue
Dialogue: 0,0:00:42.68,0:00:43.21,B,,0,0,0,,{\pos(540,1415)}con su día
Dialogue: 0,0:00:43.21,0:00:43.96,B,,0,0,0,,{\pos(540,1415)}Esa es la persona
Dialogue: 0,0:00:43.96,0:00:44.65,B,,0,0,0,,{\pos(540,1415)}que tienes que empezar
Dialogue: 0,0:00:44.65,0:00:44.99,B,,0,0,0,,{\pos(540,1415)}a ser
Dialogue: 0,0:00:44.99,0:00:46.04,B,,0,0,0,,{\pos(540,1415)}en cómo reaccionas
Dialogue: 0,0:00:46.04,0:00:47.20,B,,0,0,0,,{\pos(540,1415)}y en cómo te comportas
Dialogue: 0,0:00:47.20,0:00:47.96,B,,0,0,0,,{\pos(540,1415)}no por lo que no
Dialogue: 0,0:00:47.96,0:00:48.43,B,,0,0,0,,{\pos(540,1415)}tienes
Dialogue: 0,0:00:48.43,0:00:49.30,B,,0,0,0,,{\pos(540,1415)}La próxima vez que algo
Dialogue: 0,0:00:49.30,0:00:50.05,B,,0,0,0,,{\pos(540,1415)}se tuerza
Dialogue: 0,0:00:50.05,0:00:51.41,B,,0,0,0,,{\pos(540,1415)}piensa en cómo actuaría esa
Dialogue: 0,0:00:51.41,0:00:52.62,B,,0,0,0,,{\pos(540,1415)}mejor versión de ti
Dialogue: 0,0:00:52.62,0:00:53.34,B,,0,0,0,,{\pos(540,1415)}que ya tiene
Dialogue: 0,0:00:53.34,0:00:53.80,B,,0,0,0,,{\pos(540,1415)}lo que quiere
Dialogue: 0,0:00:53.80,0:00:54.59,B,,0,0,0,,{\pos(540,1415)}y que vive la vida
Dialogue: 0,0:00:54.59,0:00:55.02,B,,0,0,0,,{\pos(540,1415)}soñada
Dialogue: 0,0:00:55.02,0:00:55.62,B,,0,0,0,,{\pos(540,1415)}Y haz. eso
