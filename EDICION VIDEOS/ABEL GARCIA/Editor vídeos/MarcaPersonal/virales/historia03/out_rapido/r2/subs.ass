Dialogue: 0,0:00:00.00,0:00:00.77,B,,0,0,0,,{\pos(540,1415)}Cuanto más persigas
Dialogue: 0,0:00:00.77,0:00:01.56,B,,0,0,0,,{\pos(540,1415)}que te quieran
Dialogue: 0,0:00:01.56,0:00:02.54,B,,0,0,0,,{\pos(540,1415)}menos te van a querer
Dialogue: 0,0:00:02.54,0:00:03.57,B,,0,0,0,,{\pos(540,1415)}Cuando dices o piensas
Dialogue: 0,0:00:03.57,0:00:05.09,B,,0,0,0,,{\pos(540,1415)}necesito que me quieran
Dialogue: 0,0:00:05.09,0:00:06.28,B,,0,0,0,,{\pos(540,1415)}tu cabeza automáticamente está
Dialogue: 0,0:00:06.28,0:00:07.63,B,,0,0,0,,{\pos(540,1415)}poniendo el foco en todo
Dialogue: 0,0:00:07.63,0:00:08.24,B,,0,0,0,,{\pos(540,1415)}lo que le falta
Dialogue: 0,0:00:08.24,0:00:08.77,B,,0,0,0,,{\pos(540,1415)}Y no puedes tener
Dialogue: 0,0:00:08.77,0:00:09.40,B,,0,0,0,,{\pos(540,1415)}lo que quieres
Dialogue: 0,0:00:09.40,0:00:10.48,B,,0,0,0,,{\pos(540,1415)}Tienes lo que crees
Dialogue: 0,0:00:10.48,0:00:11.19,B,,0,0,0,,{\pos(540,1415)}que mereces
Dialogue: 0,0:00:11.19,0:00:12.01,B,,0,0,0,,{\pos(540,1415)}Fulano se pasa todo
Dialogue: 0,0:00:12.01,0:00:12.95,B,,0,0,0,,{\pos(540,1415)}el día persiguiendo
Dialogue: 0,0:00:12.95,0:00:14.11,B,,0,0,0,,{\pos(540,1415)}que su pareja le escriba
Dialogue: 0,0:00:14.11,0:00:14.83,B,,0,0,0,,{\pos(540,1415)}que su jefe le diga
Dialogue: 0,0:00:14.83,0:00:15.56,B,,0,0,0,,{\pos(540,1415)}lo que hace bien
Dialogue: 0,0:00:15.56,0:00:16.64,B,,0,0,0,,{\pos(540,1415)}que lo que publica tenga
Dialogue: 0,0:00:16.64,0:00:17.57,B,,0,0,0,,{\pos(540,1415)}un montón de likes
Dialogue: 0,0:00:17.57,0:00:18.28,B,,0,0,0,,{\pos(540,1415)}y seguidores
Dialogue: 0,0:00:18.28,0:00:19.69,B,,0,0,0,,{\pos(540,1415)}Pero cuanto más lo persigue
Dialogue: 0,0:00:19.69,0:00:20.47,B,,0,0,0,,{\pos(540,1415)}con ansiedad
Dialogue: 0,0:00:20.47,0:00:21.35,B,,0,0,0,,{\pos(540,1415)}más lo aleja
Dialogue: 0,0:00:21.35,0:00:22.09,B,,0,0,0,,{\pos(540,1415)}Es como si persiguieras
Dialogue: 0,0:00:22.09,0:00:22.55,B,,0,0,0,,{\pos(540,1415)}un gato
Dialogue: 0,0:00:22.55,0:00:23.26,B,,0,0,0,,{\pos(540,1415)}si corres detrás
Dialogue: 0,0:00:23.26,0:00:24.25,B,,0,0,0,,{\pos(540,1415)}de él para cogerlo
Dialogue: 0,0:00:24.25,0:00:24.98,B,,0,0,0,,{\pos(540,1415)}el gato se va
Dialogue: 0,0:00:24.98,0:00:25.64,B,,0,0,0,,{\pos(540,1415)}Pero si tú te sientas
Dialogue: 0,0:00:25.64,0:00:26.34,B,,0,0,0,,{\pos(540,1415)}tranquilo
Dialogue: 0,0:00:26.34,0:00:27.35,B,,0,0,0,,{\pos(540,1415)}es muy probable que ese
Dialogue: 0,0:00:27.35,0:00:28.18,B,,0,0,0,,{\pos(540,1415)}gato venga a ti
Dialogue: 0,0:00:28.18,0:00:28.77,B,,0,0,0,,{\pos(540,1415)}sin forzarlo
Dialogue: 0,0:00:28.77,0:00:29.47,B,,0,0,0,,{\pos(540,1415)}Así que Mengano pilló
Dialogue: 0,0:00:29.47,0:00:30.33,B,,0,0,0,,{\pos(540,1415)}el truco
Dialogue: 0,0:00:30.33,0:00:31.80,B,,0,0,0,,{\pos(540,1415)}no empieza por la necesidad
Dialogue: 0,0:00:31.80,0:00:33.16,B,,0,0,0,,{\pos(540,1415)}y vive como si ya
Dialogue: 0,0:00:33.16,0:00:34.12,B,,0,0,0,,{\pos(540,1415)}fuera suficiente
Dialogue: 0,0:00:34.12,0:00:34.84,B,,0,0,0,,{\pos(540,1415)}Y hace lo que tiene
Dialogue: 0,0:00:34.84,0:00:35.67,B,,0,0,0,,{\pos(540,1415)}que hacer igualmente
Dialogue: 0,0:00:35.67,0:00:36.40,B,,0,0,0,,{\pos(540,1415)}tanto si le escriben
Dialogue: 0,0:00:36.40,0:00:37.26,B,,0,0,0,,{\pos(540,1415)}o le dan likes
Dialogue: 0,0:00:37.26,0:00:37.94,B,,0,0,0,,{\pos(540,1415)}No espera
Dialogue: 0,0:00:37.94,0:00:38.73,B,,0,0,0,,{\pos(540,1415)}no se agobia
Dialogue: 0,0:00:38.73,0:00:39.37,B,,0,0,0,,{\pos(540,1415)}no persigue
Dialogue: 0,0:00:39.37,0:00:40.05,B,,0,0,0,,{\pos(540,1415)}no tiene ese miedo
Dialogue: 0,0:00:40.05,0:00:40.96,B,,0,0,0,,{\pos(540,1415)}de que no suceda
Dialogue: 0,0:00:40.96,0:00:41.87,B,,0,0,0,,{\pos(540,1415)}y como no está actuando
Dialogue: 0,0:00:41.87,0:00:42.89,B,,0,0,0,,{\pos(540,1415)}desde la ansiedad
Dialogue: 0,0:00:42.89,0:00:43.82,B,,0,0,0,,{\pos(540,1415)}y la necesidad
Dialogue: 0,0:00:43.82,0:00:44.85,B,,0,0,0,,{\pos(540,1415)}Eso lo atrae
Dialogue: 0,0:00:44.85,0:00:45.83,B,,0,0,0,,{\pos(540,1415)}Si persigues siempre
Dialogue: 0,0:00:45.83,0:00:47.12,B,,0,0,0,,{\pos(540,1415)}con ansiedad que te quieran
Dialogue: 0,0:00:47.12,0:00:48.32,B,,0,0,0,,{\pos(540,1415)}siempre se van a alejar
Dialogue: 0,0:00:48.32,0:00:49.49,B,,0,0,0,,{\pos(540,1415)}Si te conviertes en alguien
Dialogue: 0,0:00:49.49,0:00:50.36,B,,0,0,0,,{\pos(540,1415)}que ya se quiere
Dialogue: 0,0:00:50.36,0:00:51.60,B,,0,0,0,,{\pos(540,1415)}y actúas en consecuencia
Dialogue: 0,0:00:51.60,0:00:53.01,B,,0,0,0,,{\pos(540,1415)}Todo eso también lo vas
Dialogue: 0,0:00:53.01,0:00:53.31,B,,0,0,0,,{\pos(540,1415)}a atraer
Dialogue: 0,0:00:53.31,0:00:54.24,B,,0,0,0,,{\pos(540,1415)}Así que la próxima vez
Dialogue: 0,0:00:54.24,0:00:54.90,B,,0,0,0,,{\pos(540,1415)}que estés con el móvil
Dialogue: 0,0:00:54.90,0:00:56.00,B,,0,0,0,,{\pos(540,1415)}esperando un mensaje
Dialogue: 0,0:00:56.00,0:00:56.96,B,,0,0,0,,{\pos(540,1415)}ponte a hacer el trabajo
Dialogue: 0,0:00:56.96,0:00:57.89,B,,0,0,0,,{\pos(540,1415)}y olvídate de eso
