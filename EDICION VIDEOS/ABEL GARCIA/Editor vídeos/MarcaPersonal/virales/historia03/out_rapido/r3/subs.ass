Dialogue: 0,0:00:00.01,0:00:00.53,B,,0,0,0,,{\pos(540,1415)}Por esto la gente
Dialogue: 0,0:00:00.53,0:00:01.95,B,,0,0,0,,{\pos(540,1415)}se aleja justo cuanto más
Dialogue: 0,0:00:01.95,0:00:02.82,B,,0,0,0,,{\pos(540,1415)}las necesitas
Dialogue: 0,0:00:02.82,0:00:03.89,B,,0,0,0,,{\pos(540,1415)}Cuando dices o piensas
Dialogue: 0,0:00:03.89,0:00:05.37,B,,0,0,0,,{\pos(540,1415)}necesito que me quieran
Dialogue: 0,0:00:05.37,0:00:06.56,B,,0,0,0,,{\pos(540,1415)}tu cabeza automáticamente está
Dialogue: 0,0:00:06.56,0:00:07.92,B,,0,0,0,,{\pos(540,1415)}poniendo el foco en todo
Dialogue: 0,0:00:07.92,0:00:08.53,B,,0,0,0,,{\pos(540,1415)}lo que le falta
Dialogue: 0,0:00:08.53,0:00:09.03,B,,0,0,0,,{\pos(540,1415)}Y no puedes tener
Dialogue: 0,0:00:09.03,0:00:09.68,B,,0,0,0,,{\pos(540,1415)}lo que quieres
Dialogue: 0,0:00:09.68,0:00:10.76,B,,0,0,0,,{\pos(540,1415)}Tienes lo que crees
Dialogue: 0,0:00:10.76,0:00:11.47,B,,0,0,0,,{\pos(540,1415)}que mereces
Dialogue: 0,0:00:11.47,0:00:12.29,B,,0,0,0,,{\pos(540,1415)}Fulano se pasa todo
Dialogue: 0,0:00:12.29,0:00:13.23,B,,0,0,0,,{\pos(540,1415)}el día persiguiendo
Dialogue: 0,0:00:13.23,0:00:14.41,B,,0,0,0,,{\pos(540,1415)}que su pareja le escriba
Dialogue: 0,0:00:14.41,0:00:15.13,B,,0,0,0,,{\pos(540,1415)}que su jefe le diga
Dialogue: 0,0:00:15.13,0:00:15.86,B,,0,0,0,,{\pos(540,1415)}lo que hace bien
Dialogue: 0,0:00:15.86,0:00:16.94,B,,0,0,0,,{\pos(540,1415)}que lo que publica tenga
Dialogue: 0,0:00:16.94,0:00:17.86,B,,0,0,0,,{\pos(540,1415)}un montón de likes
Dialogue: 0,0:00:17.86,0:00:18.56,B,,0,0,0,,{\pos(540,1415)}y seguidores
Dialogue: 0,0:00:18.56,0:00:19.94,B,,0,0,0,,{\pos(540,1415)}Pero cuanto más lo persigue
Dialogue: 0,0:00:19.94,0:00:20.74,B,,0,0,0,,{\pos(540,1415)}con ansiedad
Dialogue: 0,0:00:20.74,0:00:21.64,B,,0,0,0,,{\pos(540,1415)}más lo aleja
Dialogue: 0,0:00:21.64,0:00:22.38,B,,0,0,0,,{\pos(540,1415)}Es como si persiguieras
Dialogue: 0,0:00:22.38,0:00:22.83,B,,0,0,0,,{\pos(540,1415)}un gato
Dialogue: 0,0:00:22.83,0:00:23.54,B,,0,0,0,,{\pos(540,1415)}si corres detrás
Dialogue: 0,0:00:23.54,0:00:24.53,B,,0,0,0,,{\pos(540,1415)}de él para cogerlo
Dialogue: 0,0:00:24.53,0:00:25.27,B,,0,0,0,,{\pos(540,1415)}el gato se va
Dialogue: 0,0:00:25.27,0:00:26.09,B,,0,0,0,,{\pos(540,1415)}Pero si tú te sientas
Dialogue: 0,0:00:26.09,0:00:26.62,B,,0,0,0,,{\pos(540,1415)}tranquilo
Dialogue: 0,0:00:26.62,0:00:27.64,B,,0,0,0,,{\pos(540,1415)}es muy probable que ese
Dialogue: 0,0:00:27.64,0:00:28.47,B,,0,0,0,,{\pos(540,1415)}gato venga a ti
Dialogue: 0,0:00:28.47,0:00:29.05,B,,0,0,0,,{\pos(540,1415)}sin forzarlo
Dialogue: 0,0:00:29.05,0:00:29.76,B,,0,0,0,,{\pos(540,1415)}Así que Mengano pilló
Dialogue: 0,0:00:29.76,0:00:30.62,B,,0,0,0,,{\pos(540,1415)}el truco
Dialogue: 0,0:00:30.62,0:00:32.09,B,,0,0,0,,{\pos(540,1415)}no empieza por la necesidad
Dialogue: 0,0:00:32.09,0:00:33.45,B,,0,0,0,,{\pos(540,1415)}y vive como si ya
Dialogue: 0,0:00:33.45,0:00:34.40,B,,0,0,0,,{\pos(540,1415)}fuera suficiente
Dialogue: 0,0:00:34.40,0:00:35.12,B,,0,0,0,,{\pos(540,1415)}Y hace lo que tiene
Dialogue: 0,0:00:35.12,0:00:35.95,B,,0,0,0,,{\pos(540,1415)}que hacer igualmente
Dialogue: 0,0:00:35.95,0:00:36.69,B,,0,0,0,,{\pos(540,1415)}tanto si le escriben
Dialogue: 0,0:00:36.69,0:00:37.53,B,,0,0,0,,{\pos(540,1415)}o le dan likes
Dialogue: 0,0:00:37.53,0:00:38.19,B,,0,0,0,,{\pos(540,1415)}No espera
Dialogue: 0,0:00:38.19,0:00:39.03,B,,0,0,0,,{\pos(540,1415)}no se agobia
Dialogue: 0,0:00:39.03,0:00:39.64,B,,0,0,0,,{\pos(540,1415)}no persigue
Dialogue: 0,0:00:39.64,0:00:40.33,B,,0,0,0,,{\pos(540,1415)}no tiene ese miedo
Dialogue: 0,0:00:40.33,0:00:41.23,B,,0,0,0,,{\pos(540,1415)}de que no suceda
Dialogue: 0,0:00:41.23,0:00:42.14,B,,0,0,0,,{\pos(540,1415)}y como no está actuando
Dialogue: 0,0:00:42.14,0:00:43.16,B,,0,0,0,,{\pos(540,1415)}desde la ansiedad
Dialogue: 0,0:00:43.16,0:00:44.08,B,,0,0,0,,{\pos(540,1415)}y la necesidad
Dialogue: 0,0:00:44.08,0:00:45.12,B,,0,0,0,,{\pos(540,1415)}Eso lo atrae
Dialogue: 0,0:00:45.12,0:00:46.10,B,,0,0,0,,{\pos(540,1415)}Si persigues siempre
Dialogue: 0,0:00:46.10,0:00:47.39,B,,0,0,0,,{\pos(540,1415)}con ansiedad que te quieran
Dialogue: 0,0:00:47.39,0:00:48.57,B,,0,0,0,,{\pos(540,1415)}siempre se van a alejar
Dialogue: 0,0:00:48.57,0:00:49.74,B,,0,0,0,,{\pos(540,1415)}Si te conviertes en alguien
Dialogue: 0,0:00:49.74,0:00:50.61,B,,0,0,0,,{\pos(540,1415)}que ya se quiere
Dialogue: 0,0:00:50.61,0:00:51.86,B,,0,0,0,,{\pos(540,1415)}y actúas en consecuencia
Dialogue: 0,0:00:51.86,0:00:53.24,B,,0,0,0,,{\pos(540,1415)}Todo eso también lo vas
Dialogue: 0,0:00:53.24,0:00:53.55,B,,0,0,0,,{\pos(540,1415)}a atraer
Dialogue: 0,0:00:53.55,0:00:54.49,B,,0,0,0,,{\pos(540,1415)}Así que la próxima vez
Dialogue: 0,0:00:54.49,0:00:55.15,B,,0,0,0,,{\pos(540,1415)}que estés con el móvil
Dialogue: 0,0:00:55.15,0:00:56.26,B,,0,0,0,,{\pos(540,1415)}esperando un mensaje
Dialogue: 0,0:00:56.26,0:00:57.21,B,,0,0,0,,{\pos(540,1415)}ponte a hacer el trabajo
Dialogue: 0,0:00:57.21,0:00:58.14,B,,0,0,0,,{\pos(540,1415)}y olvídate de eso
