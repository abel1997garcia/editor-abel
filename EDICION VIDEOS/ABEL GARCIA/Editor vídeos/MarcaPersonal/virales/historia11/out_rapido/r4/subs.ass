Dialogue: 0,0:00:00.07,0:00:00.84,B,,0,0,0,,{\pos(540,1415)}Si dudas cada día
Dialogue: 0,0:00:00.84,0:00:01.10,B,,0,0,0,,{\pos(540,1415)}de ti
Dialogue: 0,0:00:01.10,0:00:02.06,B,,0,0,0,,{\pos(540,1415)}es como si le dijeras
Dialogue: 0,0:00:02.06,0:00:03.63,B,,0,0,0,,{\pos(540,1415)}al repartidor que ese pedido
Dialogue: 0,0:00:03.63,0:00:04.27,B,,0,0,0,,{\pos(540,1415)}no te lo diera
Dialogue: 0,0:00:04.27,0:00:04.68,B,,0,0,0,,{\pos(540,1415)}Lo que quieres
Dialogue: 0,0:00:04.68,0:00:05.42,B,,0,0,0,,{\pos(540,1415)}para tu vida es como
Dialogue: 0,0:00:05.42,0:00:06.64,B,,0,0,0,,{\pos(540,1415)}si hicieras un pedido online
Dialogue: 0,0:00:06.64,0:00:07.26,B,,0,0,0,,{\pos(540,1415)}Lo has pagado
Dialogue: 0,0:00:07.26,0:00:08.11,B,,0,0,0,,{\pos(540,1415)}todavía no lo tienes
Dialogue: 0,0:00:08.11,0:00:08.61,B,,0,0,0,,{\pos(540,1415)}en la mano
Dialogue: 0,0:00:08.61,0:00:10.04,B,,0,0,0,,{\pos(540,1415)}pero sabes que existe
Dialogue: 0,0:00:10.04,0:00:11.00,B,,0,0,0,,{\pos(540,1415)}y que está en camino
Dialogue: 0,0:00:11.00,0:00:11.69,B,,0,0,0,,{\pos(540,1415)}¿No te pasas el día
Dialogue: 0,0:00:11.69,0:00:13.29,B,,0,0,0,,{\pos(540,1415)}en la ventana súper preocupado
Dialogue: 0,0:00:13.29,0:00:13.96,B,,0,0,0,,{\pos(540,1415)}que si puse bien
Dialogue: 0,0:00:13.96,0:00:15.35,B,,0,0,0,,{\pos(540,1415)}la dirección lo habrán
Dialogue: 0,0:00:15.35,0:00:16.62,B,,0,0,0,,{\pos(540,1415)}entendido lo que yo quiero?
Dialogue: 0,0:00:16.62,0:00:17.87,B,,0,0,0,,{\pos(540,1415)}¿Realmente me va a llegar?
Dialogue: 0,0:00:17.87,0:00:18.81,B,,0,0,0,,{\pos(540,1415)}Haces el pedido
Dialogue: 0,0:00:18.81,0:00:19.77,B,,0,0,0,,{\pos(540,1415)}sabes que va a llegar
Dialogue: 0,0:00:19.77,0:00:21.27,B,,0,0,0,,{\pos(540,1415)}y entonces coges y tranquilo
Dialogue: 0,0:00:21.27,0:00:22.04,B,,0,0,0,,{\pos(540,1415)}sigues con tu vida
Dialogue: 0,0:00:22.04,0:00:22.82,B,,0,0,0,,{\pos(540,1415)}Con lo que quieres pasa
Dialogue: 0,0:00:22.82,0:00:23.28,B,,0,0,0,,{\pos(540,1415)}igual
Dialogue: 0,0:00:23.28,0:00:24.43,B,,0,0,0,,{\pos(540,1415)}Decides quererte
Dialogue: 0,0:00:24.43,0:00:25.44,B,,0,0,0,,{\pos(540,1415)}empezar lo tuyo
Dialogue: 0,0:00:25.44,0:00:26.48,B,,0,0,0,,{\pos(540,1415)}empiezas a emprender
Dialogue: 0,0:00:26.48,0:00:27.55,B,,0,0,0,,{\pos(540,1415)}empiezas a tomar acción
Dialogue: 0,0:00:27.55,0:00:28.32,B,,0,0,0,,{\pos(540,1415)}Y sigues con tu vida
Dialogue: 0,0:00:28.32,0:00:29.57,B,,0,0,0,,{\pos(540,1415)}tranquilo sabiendo que eso
Dialogue: 0,0:00:29.57,0:00:30.28,B,,0,0,0,,{\pos(540,1415)}viene en camino
Dialogue: 0,0:00:30.28,0:00:31.62,B,,0,0,0,,{\pos(540,1415)}Ahora imagínate tú con tus
Dialogue: 0,0:00:31.62,0:00:32.98,B,,0,0,0,,{\pos(540,1415)}dudas que llega el repartidor
Dialogue: 0,0:00:32.98,0:00:33.62,B,,0,0,0,,{\pos(540,1415)}y te dice
Dialogue: 0,0:00:33.62,0:00:34.16,B,,0,0,0,,{\pos(540,1415)}No bueno
Dialogue: 0,0:00:34.16,0:00:34.99,B,,0,0,0,,{\pos(540,1415)}es que no
Dialogue: 0,0:00:34.99,0:00:35.93,B,,0,0,0,,{\pos(540,1415)}porque no lo merezco
Dialogue: 0,0:00:35.93,0:00:36.15,B,,0,0,0,,{\pos(540,1415)}Bueno
Dialogue: 0,0:00:36.15,0:00:36.86,B,,0,0,0,,{\pos(540,1415)}quédatelo
Dialogue: 0,0:00:36.86,0:00:37.05,B,,0,0,0,,{\pos(540,1415)}Bueno
Dialogue: 0,0:00:37.05,0:00:37.69,B,,0,0,0,,{\pos(540,1415)}mejor sí
Dialogue: 0,0:00:37.69,0:00:38.12,B,,0,0,0,,{\pos(540,1415)}Hoy no
Dialogue: 0,0:00:38.12,0:00:39.17,B,,0,0,0,,{\pos(540,1415)}porque no tengo tiempo
Dialogue: 0,0:00:39.17,0:00:40.77,B,,0,0,0,,{\pos(540,1415)}El repartidor siempre te va
Dialogue: 0,0:00:40.77,0:00:41.89,B,,0,0,0,,{\pos(540,1415)}a hacer caso en todo
Dialogue: 0,0:00:41.89,0:00:42.88,B,,0,0,0,,{\pos(540,1415)}y por eso nunca va
Dialogue: 0,0:00:42.88,0:00:43.31,B,,0,0,0,,{\pos(540,1415)}a llegar
Dialogue: 0,0:00:43.31,0:00:44.12,B,,0,0,0,,{\pos(540,1415)}Así que decide estar
Dialogue: 0,0:00:44.12,0:00:44.63,B,,0,0,0,,{\pos(540,1415)}tranquilo
Dialogue: 0,0:00:44.63,0:00:45.89,B,,0,0,0,,{\pos(540,1415)}deja de mandar mensajes
Dialogue: 0,0:00:45.89,0:00:46.66,B,,0,0,0,,{\pos(540,1415)}preocupado
Dialogue: 0,0:00:46.66,0:00:47.59,B,,0,0,0,,{\pos(540,1415)}buscando siempre
Dialogue: 0,0:00:47.59,0:00:48.36,B,,0,0,0,,{\pos(540,1415)}la confirmación
Dialogue: 0,0:00:48.36,0:00:48.99,B,,0,0,0,,{\pos(540,1415)}Porque cuando estás
Dialogue: 0,0:00:48.99,0:00:50.07,B,,0,0,0,,{\pos(540,1415)}completamente seguro
Dialogue: 0,0:00:50.07,0:00:50.42,B,,0,0,0,,{\pos(540,1415)}de que eso va
Dialogue: 0,0:00:50.42,0:00:50.82,B,,0,0,0,,{\pos(540,1415)}a llegar
Dialogue: 0,0:00:50.82,0:00:51.27,B,,0,0,0,,{\pos(540,1415)}Llega
Dialogue: 0,0:00:51.27,0:00:52.12,B,,0,0,0,,{\pos(540,1415)}Pero no tengas miedo
