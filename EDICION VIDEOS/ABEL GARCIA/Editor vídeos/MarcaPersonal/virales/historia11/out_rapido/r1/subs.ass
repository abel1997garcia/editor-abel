Dialogue: 0,0:00:00.00,0:00:00.41,B,,0,0,0,,{\pos(540,1415)}Lo que quieres
Dialogue: 0,0:00:00.41,0:00:01.14,B,,0,0,0,,{\pos(540,1415)}para tu vida es como
Dialogue: 0,0:00:01.14,0:00:02.38,B,,0,0,0,,{\pos(540,1415)}si hicieras un pedido online
Dialogue: 0,0:00:02.38,0:00:02.99,B,,0,0,0,,{\pos(540,1415)}Lo has pagado
Dialogue: 0,0:00:02.99,0:00:03.84,B,,0,0,0,,{\pos(540,1415)}todavía no lo tienes
Dialogue: 0,0:00:03.84,0:00:04.34,B,,0,0,0,,{\pos(540,1415)}en la mano
Dialogue: 0,0:00:04.34,0:00:05.77,B,,0,0,0,,{\pos(540,1415)}pero sabes que existe
Dialogue: 0,0:00:05.77,0:00:06.73,B,,0,0,0,,{\pos(540,1415)}y que está en camino
Dialogue: 0,0:00:06.73,0:00:07.42,B,,0,0,0,,{\pos(540,1415)}¿No te pasas el día
Dialogue: 0,0:00:07.42,0:00:09.02,B,,0,0,0,,{\pos(540,1415)}en la ventana súper preocupado
Dialogue: 0,0:00:09.02,0:00:09.69,B,,0,0,0,,{\pos(540,1415)}que si puse bien
Dialogue: 0,0:00:09.69,0:00:11.08,B,,0,0,0,,{\pos(540,1415)}la dirección lo habrán
Dialogue: 0,0:00:11.08,0:00:12.35,B,,0,0,0,,{\pos(540,1415)}entendido lo que yo quiero?
Dialogue: 0,0:00:12.35,0:00:13.54,B,,0,0,0,,{\pos(540,1415)}¿Realmente me va a llegar?
Dialogue: 0,0:00:13.54,0:00:14.49,B,,0,0,0,,{\pos(540,1415)}Haces el pedido
Dialogue: 0,0:00:14.49,0:00:15.45,B,,0,0,0,,{\pos(540,1415)}sabes que va a llegar
Dialogue: 0,0:00:15.45,0:00:16.95,B,,0,0,0,,{\pos(540,1415)}y entonces coges y tranquilo
Dialogue: 0,0:00:16.95,0:00:17.71,B,,0,0,0,,{\pos(540,1415)}sigues con tu vida
Dialogue: 0,0:00:17.71,0:00:18.50,B,,0,0,0,,{\pos(540,1415)}Con lo que quieres pasa
Dialogue: 0,0:00:18.50,0:00:18.96,B,,0,0,0,,{\pos(540,1415)}igual
Dialogue: 0,0:00:18.96,0:00:20.11,B,,0,0,0,,{\pos(540,1415)}Decides quererte
Dialogue: 0,0:00:20.11,0:00:21.12,B,,0,0,0,,{\pos(540,1415)}empezar lo tuyo
Dialogue: 0,0:00:21.12,0:00:22.17,B,,0,0,0,,{\pos(540,1415)}empiezas a emprender
Dialogue: 0,0:00:22.17,0:00:23.22,B,,0,0,0,,{\pos(540,1415)}empiezas a tomar acción
Dialogue: 0,0:00:23.22,0:00:24.00,B,,0,0,0,,{\pos(540,1415)}Y sigues con tu vida
Dialogue: 0,0:00:24.00,0:00:25.25,B,,0,0,0,,{\pos(540,1415)}tranquilo sabiendo que eso
Dialogue: 0,0:00:25.25,0:00:25.93,B,,0,0,0,,{\pos(540,1415)}viene en camino
Dialogue: 0,0:00:25.93,0:00:27.30,B,,0,0,0,,{\pos(540,1415)}Ahora imagínate tú con tus
Dialogue: 0,0:00:27.30,0:00:28.66,B,,0,0,0,,{\pos(540,1415)}dudas que llega el repartidor
Dialogue: 0,0:00:28.66,0:00:29.28,B,,0,0,0,,{\pos(540,1415)}y te dice
Dialogue: 0,0:00:29.28,0:00:29.82,B,,0,0,0,,{\pos(540,1415)}No bueno
Dialogue: 0,0:00:29.82,0:00:30.65,B,,0,0,0,,{\pos(540,1415)}es que no
Dialogue: 0,0:00:30.65,0:00:31.60,B,,0,0,0,,{\pos(540,1415)}porque no lo merezco
Dialogue: 0,0:00:31.60,0:00:31.81,B,,0,0,0,,{\pos(540,1415)}Bueno
Dialogue: 0,0:00:31.81,0:00:32.52,B,,0,0,0,,{\pos(540,1415)}quédatelo
Dialogue: 0,0:00:32.52,0:00:32.70,B,,0,0,0,,{\pos(540,1415)}Bueno
Dialogue: 0,0:00:32.70,0:00:33.34,B,,0,0,0,,{\pos(540,1415)}mejor sí
Dialogue: 0,0:00:33.34,0:00:33.91,B,,0,0,0,,{\pos(540,1415)}Hoy no
Dialogue: 0,0:00:33.91,0:00:34.82,B,,0,0,0,,{\pos(540,1415)}porque no tengo tiempo
Dialogue: 0,0:00:34.82,0:00:36.53,B,,0,0,0,,{\pos(540,1415)}El repartidor siempre te va
Dialogue: 0,0:00:36.53,0:00:37.55,B,,0,0,0,,{\pos(540,1415)}a hacer caso en todo
Dialogue: 0,0:00:37.55,0:00:38.54,B,,0,0,0,,{\pos(540,1415)}y por eso nunca va
Dialogue: 0,0:00:38.54,0:00:38.98,B,,0,0,0,,{\pos(540,1415)}a llegar
Dialogue: 0,0:00:38.98,0:00:39.79,B,,0,0,0,,{\pos(540,1415)}Así que decide estar
Dialogue: 0,0:00:39.79,0:00:40.32,B,,0,0,0,,{\pos(540,1415)}tranquilo
Dialogue: 0,0:00:40.32,0:00:41.56,B,,0,0,0,,{\pos(540,1415)}deja de mandar mensajes
Dialogue: 0,0:00:41.56,0:00:42.32,B,,0,0,0,,{\pos(540,1415)}preocupado
Dialogue: 0,0:00:42.32,0:00:43.25,B,,0,0,0,,{\pos(540,1415)}buscando siempre
Dialogue: 0,0:00:43.25,0:00:44.02,B,,0,0,0,,{\pos(540,1415)}la confirmación
Dialogue: 0,0:00:44.02,0:00:44.65,B,,0,0,0,,{\pos(540,1415)}Porque cuando estás
Dialogue: 0,0:00:44.65,0:00:45.73,B,,0,0,0,,{\pos(540,1415)}completamente seguro
Dialogue: 0,0:00:45.73,0:00:46.08,B,,0,0,0,,{\pos(540,1415)}de que eso va
Dialogue: 0,0:00:46.08,0:00:46.51,B,,0,0,0,,{\pos(540,1415)}a llegar
Dialogue: 0,0:00:46.51,0:00:46.94,B,,0,0,0,,{\pos(540,1415)}Llega
Dialogue: 0,0:00:46.94,0:00:47.80,B,,0,0,0,,{\pos(540,1415)}Pero no tengas miedo
