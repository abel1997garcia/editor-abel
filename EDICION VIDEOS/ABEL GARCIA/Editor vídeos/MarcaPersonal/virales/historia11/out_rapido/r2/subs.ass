Dialogue: 0,0:00:00.00,0:00:00.52,B,,0,0,0,,{\pos(540,1415)}Tus dudas son
Dialogue: 0,0:00:00.52,0:00:01.38,B,,0,0,0,,{\pos(540,1415)}las que hacen que no
Dialogue: 0,0:00:01.38,0:00:01.81,B,,0,0,0,,{\pos(540,1415)}te llegue
Dialogue: 0,0:00:01.81,0:00:02.23,B,,0,0,0,,{\pos(540,1415)}Lo que quieres
Dialogue: 0,0:00:02.23,0:00:02.96,B,,0,0,0,,{\pos(540,1415)}para tu vida es como
Dialogue: 0,0:00:02.96,0:00:04.19,B,,0,0,0,,{\pos(540,1415)}si hicieras un pedido online
Dialogue: 0,0:00:04.19,0:00:04.81,B,,0,0,0,,{\pos(540,1415)}Lo has pagado
Dialogue: 0,0:00:04.81,0:00:05.66,B,,0,0,0,,{\pos(540,1415)}todavía no lo tienes
Dialogue: 0,0:00:05.66,0:00:06.16,B,,0,0,0,,{\pos(540,1415)}en la mano
Dialogue: 0,0:00:06.16,0:00:07.58,B,,0,0,0,,{\pos(540,1415)}pero sabes que existe
Dialogue: 0,0:00:07.58,0:00:08.54,B,,0,0,0,,{\pos(540,1415)}y que está en camino
Dialogue: 0,0:00:08.54,0:00:09.24,B,,0,0,0,,{\pos(540,1415)}¿No te pasas el día
Dialogue: 0,0:00:09.24,0:00:10.84,B,,0,0,0,,{\pos(540,1415)}en la ventana súper preocupado
Dialogue: 0,0:00:10.84,0:00:11.51,B,,0,0,0,,{\pos(540,1415)}que si puse bien
Dialogue: 0,0:00:11.51,0:00:12.90,B,,0,0,0,,{\pos(540,1415)}la dirección lo habrán
Dialogue: 0,0:00:12.90,0:00:14.13,B,,0,0,0,,{\pos(540,1415)}entendido lo que yo quiero?
Dialogue: 0,0:00:14.13,0:00:15.36,B,,0,0,0,,{\pos(540,1415)}¿Realmente me va a llegar?
Dialogue: 0,0:00:15.36,0:00:16.31,B,,0,0,0,,{\pos(540,1415)}Haces el pedido
Dialogue: 0,0:00:16.31,0:00:17.27,B,,0,0,0,,{\pos(540,1415)}sabes que va a llegar
Dialogue: 0,0:00:17.27,0:00:18.77,B,,0,0,0,,{\pos(540,1415)}y entonces coges y tranquilo
Dialogue: 0,0:00:18.77,0:00:19.54,B,,0,0,0,,{\pos(540,1415)}sigues con tu vida
Dialogue: 0,0:00:19.54,0:00:20.32,B,,0,0,0,,{\pos(540,1415)}Con lo que quieres pasa
Dialogue: 0,0:00:20.32,0:00:20.79,B,,0,0,0,,{\pos(540,1415)}igual
Dialogue: 0,0:00:20.79,0:00:21.93,B,,0,0,0,,{\pos(540,1415)}Decides quererte
Dialogue: 0,0:00:21.93,0:00:22.95,B,,0,0,0,,{\pos(540,1415)}empezar lo tuyo
Dialogue: 0,0:00:22.95,0:00:23.98,B,,0,0,0,,{\pos(540,1415)}empiezas a emprender
Dialogue: 0,0:00:23.98,0:00:25.05,B,,0,0,0,,{\pos(540,1415)}empiezas a tomar acción
Dialogue: 0,0:00:25.05,0:00:25.82,B,,0,0,0,,{\pos(540,1415)}Y sigues con tu vida
Dialogue: 0,0:00:25.82,0:00:27.07,B,,0,0,0,,{\pos(540,1415)}tranquilo sabiendo que eso
Dialogue: 0,0:00:27.07,0:00:27.76,B,,0,0,0,,{\pos(540,1415)}viene en camino
Dialogue: 0,0:00:27.76,0:00:29.12,B,,0,0,0,,{\pos(540,1415)}Ahora imagínate tú con tus
Dialogue: 0,0:00:29.12,0:00:30.48,B,,0,0,0,,{\pos(540,1415)}dudas que llega el repartidor
Dialogue: 0,0:00:30.48,0:00:31.10,B,,0,0,0,,{\pos(540,1415)}y te dice
Dialogue: 0,0:00:31.10,0:00:31.64,B,,0,0,0,,{\pos(540,1415)}No bueno
Dialogue: 0,0:00:31.64,0:00:32.47,B,,0,0,0,,{\pos(540,1415)}es que no
Dialogue: 0,0:00:32.47,0:00:33.41,B,,0,0,0,,{\pos(540,1415)}porque no lo merezco
Dialogue: 0,0:00:33.41,0:00:33.63,B,,0,0,0,,{\pos(540,1415)}Bueno
Dialogue: 0,0:00:33.63,0:00:34.34,B,,0,0,0,,{\pos(540,1415)}quédatelo
Dialogue: 0,0:00:34.34,0:00:34.53,B,,0,0,0,,{\pos(540,1415)}Bueno
Dialogue: 0,0:00:34.53,0:00:35.17,B,,0,0,0,,{\pos(540,1415)}mejor sí
Dialogue: 0,0:00:35.17,0:00:35.73,B,,0,0,0,,{\pos(540,1415)}Hoy no
Dialogue: 0,0:00:35.73,0:00:36.63,B,,0,0,0,,{\pos(540,1415)}porque no tengo tiempo
Dialogue: 0,0:00:36.63,0:00:38.33,B,,0,0,0,,{\pos(540,1415)}El repartidor siempre te va
Dialogue: 0,0:00:38.33,0:00:39.35,B,,0,0,0,,{\pos(540,1415)}a hacer caso en todo
Dialogue: 0,0:00:39.35,0:00:40.34,B,,0,0,0,,{\pos(540,1415)}y por eso nunca va
Dialogue: 0,0:00:40.34,0:00:40.78,B,,0,0,0,,{\pos(540,1415)}a llegar
Dialogue: 0,0:00:40.78,0:00:41.59,B,,0,0,0,,{\pos(540,1415)}Así que decide estar
Dialogue: 0,0:00:41.59,0:00:42.12,B,,0,0,0,,{\pos(540,1415)}tranquilo
Dialogue: 0,0:00:42.12,0:00:43.36,B,,0,0,0,,{\pos(540,1415)}deja de mandar mensajes
Dialogue: 0,0:00:43.36,0:00:44.12,B,,0,0,0,,{\pos(540,1415)}preocupado
Dialogue: 0,0:00:44.12,0:00:45.05,B,,0,0,0,,{\pos(540,1415)}buscando siempre
Dialogue: 0,0:00:45.05,0:00:45.82,B,,0,0,0,,{\pos(540,1415)}la confirmación
Dialogue: 0,0:00:45.82,0:00:46.45,B,,0,0,0,,{\pos(540,1415)}Porque cuando estás
Dialogue: 0,0:00:46.45,0:00:47.53,B,,0,0,0,,{\pos(540,1415)}completamente seguro
Dialogue: 0,0:00:47.53,0:00:47.88,B,,0,0,0,,{\pos(540,1415)}de que eso va
Dialogue: 0,0:00:47.88,0:00:48.29,B,,0,0,0,,{\pos(540,1415)}a llegar
Dialogue: 0,0:00:48.29,0:00:48.73,B,,0,0,0,,{\pos(540,1415)}Llega
Dialogue: 0,0:00:48.73,0:00:49.58,B,,0,0,0,,{\pos(540,1415)}Pero no tengas miedo
