Dialogue: 0,0:00:00.00,0:00:00.61,B,,0,0,0,,{\pos(540,1415)}Lo que más haces
Dialogue: 0,0:00:00.61,0:00:01.63,B,,0,0,0,,{\pos(540,1415)}para quererte está
Dialogue: 0,0:00:01.63,0:00:02.40,B,,0,0,0,,{\pos(540,1415)}en el último lugar
Dialogue: 0,0:00:02.40,0:00:03.73,B,,0,0,0,,{\pos(540,1415)}Repetirte afirmaciones delante
Dialogue: 0,0:00:03.73,0:00:04.32,B,,0,0,0,,{\pos(540,1415)}del espejo
Dialogue: 0,0:00:04.32,0:00:04.82,B,,0,0,0,,{\pos(540,1415)}Diez
Dialogue: 0,0:00:04.82,0:00:05.45,B,,0,0,0,,{\pos(540,1415)}Si no te lo crees
Dialogue: 0,0:00:05.45,0:00:05.79,B,,0,0,0,,{\pos(540,1415)}por mucho
Dialogue: 0,0:00:05.79,0:00:06.37,B,,0,0,0,,{\pos(540,1415)}que te lo repitas
Dialogue: 0,0:00:06.37,0:00:07.22,B,,0,0,0,,{\pos(540,1415)}tu energía no va
Dialogue: 0,0:00:07.22,0:00:07.64,B,,0,0,0,,{\pos(540,1415)}a cambiar
Dialogue: 0,0:00:07.64,0:00:08.37,B,,0,0,0,,{\pos(540,1415)}Que tu pareja te diga
Dialogue: 0,0:00:08.37,0:00:08.92,B,,0,0,0,,{\pos(540,1415)}que vales
Dialogue: 0,0:00:08.92,0:00:09.54,B,,0,0,0,,{\pos(540,1415)}número 9
Dialogue: 0,0:00:09.54,0:00:10.27,B,,0,0,0,,{\pos(540,1415)}Si tu valor depende
Dialogue: 0,0:00:10.27,0:00:10.81,B,,0,0,0,,{\pos(540,1415)}de lo que te diga
Dialogue: 0,0:00:10.81,0:00:11.37,B,,0,0,0,,{\pos(540,1415)}una persona
Dialogue: 0,0:00:11.37,0:00:12.44,B,,0,0,0,,{\pos(540,1415)}el día que se vaya
Dialogue: 0,0:00:12.44,0:00:13.22,B,,0,0,0,,{\pos(540,1415)}tu valor va a dejar
Dialogue: 0,0:00:13.22,0:00:13.78,B,,0,0,0,,{\pos(540,1415)}de existir
Dialogue: 0,0:00:13.78,0:00:14.92,B,,0,0,0,,{\pos(540,1415)}Leer otro libro de autoestima
Dialogue: 0,0:00:14.92,0:00:15.83,B,,0,0,0,,{\pos(540,1415)}o crecimiento personal
Dialogue: 0,0:00:15.83,0:00:16.37,B,,0,0,0,,{\pos(540,1415)}número 8
Dialogue: 0,0:00:16.37,0:00:17.46,B,,0,0,0,,{\pos(540,1415)}Entenderlo no significa
Dialogue: 0,0:00:17.46,0:00:18.06,B,,0,0,0,,{\pos(540,1415)}que lo cambies
Dialogue: 0,0:00:18.06,0:00:18.74,B,,0,0,0,,{\pos(540,1415)}y tú ya lo entiendes
Dialogue: 0,0:00:18.74,0:00:19.03,B,,0,0,0,,{\pos(540,1415)}todo
Dialogue: 0,0:00:19.03,0:00:19.85,B,,0,0,0,,{\pos(540,1415)}Cambiar tu físico
Dialogue: 0,0:00:19.85,0:00:20.46,B,,0,0,0,,{\pos(540,1415)}o tu ropa
Dialogue: 0,0:00:20.46,0:00:21.08,B,,0,0,0,,{\pos(540,1415)}número 7
Dialogue: 0,0:00:21.08,0:00:21.97,B,,0,0,0,,{\pos(540,1415)}Te ayuda a sentirte mejor
Dialogue: 0,0:00:21.97,0:00:22.78,B,,0,0,0,,{\pos(540,1415)}un rato y te mete
Dialogue: 0,0:00:22.78,0:00:23.60,B,,0,0,0,,{\pos(540,1415)}un chute de dopamina
Dialogue: 0,0:00:23.60,0:00:24.33,B,,0,0,0,,{\pos(540,1415)}pero si por dentro no
Dialogue: 0,0:00:24.33,0:00:25.09,B,,0,0,0,,{\pos(540,1415)}te sientes bien
Dialogue: 0,0:00:25.09,0:00:26.09,B,,0,0,0,,{\pos(540,1415)}cualquier espejo te va
Dialogue: 0,0:00:26.09,0:00:26.97,B,,0,0,0,,{\pos(540,1415)}a recordar la realidad
Dialogue: 0,0:00:26.97,0:00:28.12,B,,0,0,0,,{\pos(540,1415)}Estar en silencio cada día
Dialogue: 0,0:00:28.12,0:00:28.81,B,,0,0,0,,{\pos(540,1415)}número 6
Dialogue: 0,0:00:28.81,0:00:29.71,B,,0,0,0,,{\pos(540,1415)}10 minutos sin ruido
Dialogue: 0,0:00:29.71,0:00:30.22,B,,0,0,0,,{\pos(540,1415)}y sin móvil te va
Dialogue: 0,0:00:30.22,0:00:31.61,B,,0,0,0,,{\pos(540,1415)}a forzar a escuchar realmente
Dialogue: 0,0:00:31.61,0:00:32.41,B,,0,0,0,,{\pos(540,1415)}lo que sientes
Dialogue: 0,0:00:32.41,0:00:33.36,B,,0,0,0,,{\pos(540,1415)}y que durante mucho tiempo
Dialogue: 0,0:00:33.36,0:00:33.71,B,,0,0,0,,{\pos(540,1415)}has tapado
Dialogue: 0,0:00:33.71,0:00:34.62,B,,0,0,0,,{\pos(540,1415)}Lo que consumes
Dialogue: 0,0:00:34.62,0:00:35.25,B,,0,0,0,,{\pos(540,1415)}número 5
Dialogue: 0,0:00:35.25,0:00:35.96,B,,0,0,0,,{\pos(540,1415)}¿No solo lo que comes
Dialogue: 0,0:00:35.96,0:00:37.16,B,,0,0,0,,{\pos(540,1415)}sino cada noticia y cada
Dialogue: 0,0:00:37.16,0:00:37.81,B,,0,0,0,,{\pos(540,1415)}rato que pasas
Dialogue: 0,0:00:37.81,0:00:38.53,B,,0,0,0,,{\pos(540,1415)}en las redes sociales
Dialogue: 0,0:00:38.53,0:00:39.67,B,,0,0,0,,{\pos(540,1415)}comparándote con otros
Dialogue: 0,0:00:39.67,0:00:40.69,B,,0,0,0,,{\pos(540,1415)}y poniendo la atención
Dialogue: 0,0:00:40.69,0:00:41.73,B,,0,0,0,,{\pos(540,1415)}en cosas negativas?
Dialogue: 0,0:00:41.73,0:00:42.94,B,,0,0,0,,{\pos(540,1415)}Hace que tu energía baje
Dialogue: 0,0:00:42.94,0:00:44.19,B,,0,0,0,,{\pos(540,1415)}sin ni siquiera darte cuenta
Dialogue: 0,0:00:44.19,0:00:45.03,B,,0,0,0,,{\pos(540,1415)}Mover tu cuerpo y hacer
Dialogue: 0,0:00:45.03,0:00:46.26,B,,0,0,0,,{\pos(540,1415)}ejercicio número 4
Dialogue: 0,0:00:46.26,0:00:47.12,B,,0,0,0,,{\pos(540,1415)}Cuando la energía se queda
Dialogue: 0,0:00:47.12,0:00:47.56,B,,0,0,0,,{\pos(540,1415)}estancada
Dialogue: 0,0:00:47.56,0:00:48.81,B,,0,0,0,,{\pos(540,1415)}tu autoestima también
Dialogue: 0,0:00:48.81,0:00:49.35,B,,0,0,0,,{\pos(540,1415)}Y mover el cuerpo
Dialogue: 0,0:00:49.35,0:00:50.29,B,,0,0,0,,{\pos(540,1415)}es la forma más rápida
Dialogue: 0,0:00:50.29,0:00:51.15,B,,0,0,0,,{\pos(540,1415)}de mover esa energía
Dialogue: 0,0:00:51.15,0:00:51.84,B,,0,0,0,,{\pos(540,1415)}Poner límites
Dialogue: 0,0:00:51.84,0:00:52.54,B,,0,0,0,,{\pos(540,1415)}número 3
Dialogue: 0,0:00:52.54,0:00:53.20,B,,0,0,0,,{\pos(540,1415)}Cada vez que dices
Dialogue: 0,0:00:53.20,0:00:53.43,B,,0,0,0,,{\pos(540,1415)}que sí
Dialogue: 0,0:00:53.43,0:00:54.57,B,,0,0,0,,{\pos(540,1415)}cuando realmente quieres decir
Dialogue: 0,0:00:54.57,0:00:54.79,B,,0,0,0,,{\pos(540,1415)}que no
Dialogue: 0,0:00:54.79,0:00:55.38,B,,0,0,0,,{\pos(540,1415)}le estás diciendo
Dialogue: 0,0:00:55.38,0:00:56.11,B,,0,0,0,,{\pos(540,1415)}a tu niño interior
Dialogue: 0,0:00:56.11,0:00:56.98,B,,0,0,0,,{\pos(540,1415)}que no vale lo suficiente
Dialogue: 0,0:00:56.98,0:00:58.05,B,,0,0,0,,{\pos(540,1415)}delante de los demás
Dialogue: 0,0:00:58.05,0:00:59.20,B,,0,0,0,,{\pos(540,1415)}Cumplir tu palabra contigo
Dialogue: 0,0:00:59.20,0:00:59.89,B,,0,0,0,,{\pos(540,1415)}número 2
Dialogue: 0,0:00:59.89,0:01:00.66,B,,0,0,0,,{\pos(540,1415)}Si dices algo y luego
Dialogue: 0,0:01:00.66,0:01:01.40,B,,0,0,0,,{\pos(540,1415)}no lo cumples
Dialogue: 0,0:01:01.40,0:01:02.70,B,,0,0,0,,{\pos(540,1415)}hay una incoherencia interna
Dialogue: 0,0:01:02.70,0:01:03.66,B,,0,0,0,,{\pos(540,1415)}que provoca que baje
Dialogue: 0,0:01:03.66,0:01:04.46,B,,0,0,0,,{\pos(540,1415)}tu autoestima y
Dialogue: 0,0:01:04.46,0:01:04.70,B,,0,0,0,,{\pos(540,1415)}por tanto
Dialogue: 0,0:01:04.70,0:01:05.17,B,,0,0,0,,{\pos(540,1415)}tu energía
Dialogue: 0,0:01:05.17,0:01:05.70,B,,0,0,0,,{\pos(540,1415)}Y te aseguro
Dialogue: 0,0:01:05.70,0:01:06.08,B,,0,0,0,,{\pos(540,1415)}de que eso no
Dialogue: 0,0:01:06.08,0:01:07.43,B,,0,0,0,,{\pos(540,1415)}lo arregla ninguna frase
Dialogue: 0,0:01:07.43,0:01:07.86,B,,0,0,0,,{\pos(540,1415)}bonita
Dialogue: 0,0:01:07.86,0:01:08.93,B,,0,0,0,,{\pos(540,1415)}Escuchar lo que sientes
Dialogue: 0,0:01:08.93,0:01:10.26,B,,0,0,0,,{\pos(540,1415)}número uno y más importante
Dialogue: 0,0:01:10.26,0:01:10.62,B,,0,0,0,,{\pos(540,1415)}Lo que sientes
Dialogue: 0,0:01:10.62,0:01:11.43,B,,0,0,0,,{\pos(540,1415)}es lo que manda
Dialogue: 0,0:01:11.43,0:01:12.13,B,,0,0,0,,{\pos(540,1415)}y si lo tapas
Dialogue: 0,0:01:12.13,0:01:12.93,B,,0,0,0,,{\pos(540,1415)}nada de lo anterior
Dialogue: 0,0:01:12.93,0:01:13.57,B,,0,0,0,,{\pos(540,1415)}te va a funcionar
Dialogue: 0,0:01:13.57,0:01:14.30,B,,0,0,0,,{\pos(540,1415)}Porque lo que no quieres
Dialogue: 0,0:01:14.30,0:01:15.15,B,,0,0,0,,{\pos(540,1415)}sentir no se va
Dialogue: 0,0:01:15.15,0:01:15.91,B,,0,0,0,,{\pos(540,1415)}se queda dentro
Dialogue: 0,0:01:15.91,0:01:16.89,B,,0,0,0,,{\pos(540,1415)}y te sigue controlando
Dialogue: 0,0:01:16.89,0:01:17.86,B,,0,0,0,,{\pos(540,1415)}de forma inconsciente
