Dialogue: 0,0:00:00.00,0:00:00.44,B,,0,0,0,,{\pos(540,1415)}Pierdes años
Dialogue: 0,0:00:00.44,0:00:01.37,B,,0,0,0,,{\pos(540,1415)}en lo que no importa
Dialogue: 0,0:00:01.37,0:00:02.08,B,,0,0,0,,{\pos(540,1415)}para quererte
Dialogue: 0,0:00:02.08,0:00:03.36,B,,0,0,0,,{\pos(540,1415)}Repetirte afirmaciones delante
Dialogue: 0,0:00:03.36,0:00:04.06,B,,0,0,0,,{\pos(540,1415)}del espejo
Dialogue: 0,0:00:04.06,0:00:04.55,B,,0,0,0,,{\pos(540,1415)}Diez
Dialogue: 0,0:00:04.55,0:00:05.19,B,,0,0,0,,{\pos(540,1415)}Si no te lo crees
Dialogue: 0,0:00:05.19,0:00:05.53,B,,0,0,0,,{\pos(540,1415)}por mucho
Dialogue: 0,0:00:05.53,0:00:06.11,B,,0,0,0,,{\pos(540,1415)}que te lo repitas
Dialogue: 0,0:00:06.11,0:00:06.96,B,,0,0,0,,{\pos(540,1415)}tu energía no va
Dialogue: 0,0:00:06.96,0:00:07.38,B,,0,0,0,,{\pos(540,1415)}a cambiar
Dialogue: 0,0:00:07.38,0:00:08.10,B,,0,0,0,,{\pos(540,1415)}Que tu pareja te diga
Dialogue: 0,0:00:08.10,0:00:08.65,B,,0,0,0,,{\pos(540,1415)}que vales
Dialogue: 0,0:00:08.65,0:00:09.26,B,,0,0,0,,{\pos(540,1415)}número 9
Dialogue: 0,0:00:09.26,0:00:09.99,B,,0,0,0,,{\pos(540,1415)}Si tu valor depende
Dialogue: 0,0:00:09.99,0:00:10.53,B,,0,0,0,,{\pos(540,1415)}de lo que te diga
Dialogue: 0,0:00:10.53,0:00:11.08,B,,0,0,0,,{\pos(540,1415)}una persona
Dialogue: 0,0:00:11.08,0:00:12.16,B,,0,0,0,,{\pos(540,1415)}el día que se vaya
Dialogue: 0,0:00:12.16,0:00:12.94,B,,0,0,0,,{\pos(540,1415)}tu valor va a dejar
Dialogue: 0,0:00:12.94,0:00:13.49,B,,0,0,0,,{\pos(540,1415)}de existir
Dialogue: 0,0:00:13.49,0:00:14.64,B,,0,0,0,,{\pos(540,1415)}Leer otro libro de autoestima
Dialogue: 0,0:00:14.64,0:00:15.55,B,,0,0,0,,{\pos(540,1415)}o crecimiento personal
Dialogue: 0,0:00:15.55,0:00:16.08,B,,0,0,0,,{\pos(540,1415)}número 8
Dialogue: 0,0:00:16.08,0:00:17.18,B,,0,0,0,,{\pos(540,1415)}Entenderlo no significa
Dialogue: 0,0:00:17.18,0:00:17.77,B,,0,0,0,,{\pos(540,1415)}que lo cambies
Dialogue: 0,0:00:17.77,0:00:18.46,B,,0,0,0,,{\pos(540,1415)}y tú ya lo entiendes
Dialogue: 0,0:00:18.46,0:00:18.76,B,,0,0,0,,{\pos(540,1415)}todo
Dialogue: 0,0:00:18.76,0:00:19.56,B,,0,0,0,,{\pos(540,1415)}Cambiar tu físico
Dialogue: 0,0:00:19.56,0:00:20.17,B,,0,0,0,,{\pos(540,1415)}o tu ropa
Dialogue: 0,0:00:20.17,0:00:20.80,B,,0,0,0,,{\pos(540,1415)}número 7
Dialogue: 0,0:00:20.80,0:00:21.68,B,,0,0,0,,{\pos(540,1415)}Te ayuda a sentirte mejor
Dialogue: 0,0:00:21.68,0:00:22.49,B,,0,0,0,,{\pos(540,1415)}un rato y te mete
Dialogue: 0,0:00:22.49,0:00:23.32,B,,0,0,0,,{\pos(540,1415)}un chute de dopamina
Dialogue: 0,0:00:23.32,0:00:24.05,B,,0,0,0,,{\pos(540,1415)}pero si por dentro no
Dialogue: 0,0:00:24.05,0:00:24.81,B,,0,0,0,,{\pos(540,1415)}te sientes bien
Dialogue: 0,0:00:24.81,0:00:25.81,B,,0,0,0,,{\pos(540,1415)}cualquier espejo te va
Dialogue: 0,0:00:25.81,0:00:26.69,B,,0,0,0,,{\pos(540,1415)}a recordar la realidad
Dialogue: 0,0:00:26.69,0:00:27.83,B,,0,0,0,,{\pos(540,1415)}Estar en silencio cada día
Dialogue: 0,0:00:27.83,0:00:28.51,B,,0,0,0,,{\pos(540,1415)}número 6
Dialogue: 0,0:00:28.51,0:00:29.42,B,,0,0,0,,{\pos(540,1415)}10 minutos sin ruido
Dialogue: 0,0:00:29.42,0:00:29.94,B,,0,0,0,,{\pos(540,1415)}y sin móvil te va
Dialogue: 0,0:00:29.94,0:00:31.39,B,,0,0,0,,{\pos(540,1415)}a forzar a escuchar realmente
Dialogue: 0,0:00:31.39,0:00:32.13,B,,0,0,0,,{\pos(540,1415)}lo que sientes
Dialogue: 0,0:00:32.13,0:00:33.07,B,,0,0,0,,{\pos(540,1415)}y que durante mucho tiempo
Dialogue: 0,0:00:33.07,0:00:33.42,B,,0,0,0,,{\pos(540,1415)}has tapado
Dialogue: 0,0:00:33.42,0:00:34.28,B,,0,0,0,,{\pos(540,1415)}Lo que consumes
Dialogue: 0,0:00:34.28,0:00:34.97,B,,0,0,0,,{\pos(540,1415)}número 5
Dialogue: 0,0:00:34.97,0:00:35.68,B,,0,0,0,,{\pos(540,1415)}¿No solo lo que comes
Dialogue: 0,0:00:35.68,0:00:36.88,B,,0,0,0,,{\pos(540,1415)}sino cada noticia y cada
Dialogue: 0,0:00:36.88,0:00:37.54,B,,0,0,0,,{\pos(540,1415)}rato que pasas
Dialogue: 0,0:00:37.54,0:00:38.25,B,,0,0,0,,{\pos(540,1415)}en las redes sociales
Dialogue: 0,0:00:38.25,0:00:39.39,B,,0,0,0,,{\pos(540,1415)}comparándote con otros
Dialogue: 0,0:00:39.39,0:00:40.41,B,,0,0,0,,{\pos(540,1415)}y poniendo la atención
Dialogue: 0,0:00:40.41,0:00:41.44,B,,0,0,0,,{\pos(540,1415)}en cosas negativas?
Dialogue: 0,0:00:41.44,0:00:42.66,B,,0,0,0,,{\pos(540,1415)}Hace que tu energía baje
Dialogue: 0,0:00:42.66,0:00:43.91,B,,0,0,0,,{\pos(540,1415)}sin ni siquiera darte cuenta
Dialogue: 0,0:00:43.91,0:00:44.57,B,,0,0,0,,{\pos(540,1415)}Mover tu cuerpo y hacer
Dialogue: 0,0:00:44.57,0:00:45.98,B,,0,0,0,,{\pos(540,1415)}ejercicio número 4
Dialogue: 0,0:00:45.98,0:00:46.84,B,,0,0,0,,{\pos(540,1415)}Cuando la energía se queda
Dialogue: 0,0:00:46.84,0:00:47.25,B,,0,0,0,,{\pos(540,1415)}estancada
Dialogue: 0,0:00:47.25,0:00:48.53,B,,0,0,0,,{\pos(540,1415)}tu autoestima también
Dialogue: 0,0:00:48.53,0:00:49.06,B,,0,0,0,,{\pos(540,1415)}Y mover el cuerpo
Dialogue: 0,0:00:49.06,0:00:50.01,B,,0,0,0,,{\pos(540,1415)}es la forma más rápida
Dialogue: 0,0:00:50.01,0:00:50.86,B,,0,0,0,,{\pos(540,1415)}de mover esa energía
Dialogue: 0,0:00:50.86,0:00:51.59,B,,0,0,0,,{\pos(540,1415)}Poner límites
Dialogue: 0,0:00:51.59,0:00:52.25,B,,0,0,0,,{\pos(540,1415)}número 3
Dialogue: 0,0:00:52.25,0:00:52.89,B,,0,0,0,,{\pos(540,1415)}Cada vez que dices
Dialogue: 0,0:00:52.89,0:00:53.14,B,,0,0,0,,{\pos(540,1415)}que sí
Dialogue: 0,0:00:53.14,0:00:54.29,B,,0,0,0,,{\pos(540,1415)}cuando realmente quieres decir
Dialogue: 0,0:00:54.29,0:00:54.51,B,,0,0,0,,{\pos(540,1415)}que no
Dialogue: 0,0:00:54.51,0:00:55.10,B,,0,0,0,,{\pos(540,1415)}le estás diciendo
Dialogue: 0,0:00:55.10,0:00:55.83,B,,0,0,0,,{\pos(540,1415)}a tu niño interior
Dialogue: 0,0:00:55.83,0:00:56.70,B,,0,0,0,,{\pos(540,1415)}que no vale lo suficiente
Dialogue: 0,0:00:56.70,0:00:57.77,B,,0,0,0,,{\pos(540,1415)}delante de los demás
Dialogue: 0,0:00:57.77,0:00:58.92,B,,0,0,0,,{\pos(540,1415)}Cumplir tu palabra contigo
Dialogue: 0,0:00:58.92,0:00:59.60,B,,0,0,0,,{\pos(540,1415)}número 2
Dialogue: 0,0:00:59.60,0:01:00.54,B,,0,0,0,,{\pos(540,1415)}Si dices algo y luego
Dialogue: 0,0:01:00.54,0:01:01.12,B,,0,0,0,,{\pos(540,1415)}no lo cumples
Dialogue: 0,0:01:01.12,0:01:02.42,B,,0,0,0,,{\pos(540,1415)}hay una incoherencia interna
Dialogue: 0,0:01:02.42,0:01:03.36,B,,0,0,0,,{\pos(540,1415)}que provoca que baje
Dialogue: 0,0:01:03.36,0:01:04.04,B,,0,0,0,,{\pos(540,1415)}tu autoestima y
Dialogue: 0,0:01:04.04,0:01:04.41,B,,0,0,0,,{\pos(540,1415)}por tanto
Dialogue: 0,0:01:04.41,0:01:04.88,B,,0,0,0,,{\pos(540,1415)}tu energía
Dialogue: 0,0:01:04.88,0:01:05.41,B,,0,0,0,,{\pos(540,1415)}Y te aseguro
Dialogue: 0,0:01:05.41,0:01:05.79,B,,0,0,0,,{\pos(540,1415)}de que eso no
Dialogue: 0,0:01:05.79,0:01:07.17,B,,0,0,0,,{\pos(540,1415)}lo arregla ninguna frase
Dialogue: 0,0:01:07.17,0:01:07.58,B,,0,0,0,,{\pos(540,1415)}bonita
Dialogue: 0,0:01:07.58,0:01:08.64,B,,0,0,0,,{\pos(540,1415)}Escuchar lo que sientes
Dialogue: 0,0:01:08.64,0:01:09.96,B,,0,0,0,,{\pos(540,1415)}número uno y más importante
Dialogue: 0,0:01:09.96,0:01:10.57,B,,0,0,0,,{\pos(540,1415)}Lo que sientes
Dialogue: 0,0:01:10.57,0:01:11.15,B,,0,0,0,,{\pos(540,1415)}es lo que manda
Dialogue: 0,0:01:11.15,0:01:11.83,B,,0,0,0,,{\pos(540,1415)}y si lo tapas
Dialogue: 0,0:01:11.83,0:01:12.63,B,,0,0,0,,{\pos(540,1415)}nada de lo anterior
Dialogue: 0,0:01:12.63,0:01:13.27,B,,0,0,0,,{\pos(540,1415)}te va a funcionar
Dialogue: 0,0:01:13.27,0:01:14.00,B,,0,0,0,,{\pos(540,1415)}Porque lo que no quieres
Dialogue: 0,0:01:14.00,0:01:14.84,B,,0,0,0,,{\pos(540,1415)}sentir no se va
Dialogue: 0,0:01:14.84,0:01:15.61,B,,0,0,0,,{\pos(540,1415)}se queda dentro
Dialogue: 0,0:01:15.61,0:01:16.45,B,,0,0,0,,{\pos(540,1415)}y te sigue controlando
Dialogue: 0,0:01:16.45,0:01:17.56,B,,0,0,0,,{\pos(540,1415)}de forma inconsciente
