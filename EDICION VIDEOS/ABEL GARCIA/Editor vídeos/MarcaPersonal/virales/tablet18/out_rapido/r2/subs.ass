Dialogue: 0,0:00:00.04,0:00:00.65,B,,0,0,0,,{\pos(540,1415)}De lo que menos
Dialogue: 0,0:00:00.65,0:00:01.30,B,,0,0,0,,{\pos(540,1415)}a lo que más importa
Dialogue: 0,0:00:01.30,0:00:02.50,B,,0,0,0,,{\pos(540,1415)}para recuperar tu autoestima
Dialogue: 0,0:00:02.50,0:00:03.94,B,,0,0,0,,{\pos(540,1415)}Repetirte afirmaciones delante
Dialogue: 0,0:00:03.94,0:00:04.47,B,,0,0,0,,{\pos(540,1415)}del espejo
Dialogue: 0,0:00:04.47,0:00:04.97,B,,0,0,0,,{\pos(540,1415)}Diez
Dialogue: 0,0:00:04.97,0:00:05.60,B,,0,0,0,,{\pos(540,1415)}Si no te lo crees
Dialogue: 0,0:00:05.60,0:00:05.94,B,,0,0,0,,{\pos(540,1415)}por mucho
Dialogue: 0,0:00:05.94,0:00:06.52,B,,0,0,0,,{\pos(540,1415)}que te lo repitas
Dialogue: 0,0:00:06.52,0:00:07.39,B,,0,0,0,,{\pos(540,1415)}tu energía no va
Dialogue: 0,0:00:07.39,0:00:07.78,B,,0,0,0,,{\pos(540,1415)}a cambiar
Dialogue: 0,0:00:07.78,0:00:08.52,B,,0,0,0,,{\pos(540,1415)}Que tu pareja te diga
Dialogue: 0,0:00:08.52,0:00:09.07,B,,0,0,0,,{\pos(540,1415)}que vales
Dialogue: 0,0:00:09.07,0:00:09.69,B,,0,0,0,,{\pos(540,1415)}número 9
Dialogue: 0,0:00:09.69,0:00:10.42,B,,0,0,0,,{\pos(540,1415)}Si tu valor depende
Dialogue: 0,0:00:10.42,0:00:10.96,B,,0,0,0,,{\pos(540,1415)}de lo que te diga
Dialogue: 0,0:00:10.96,0:00:11.52,B,,0,0,0,,{\pos(540,1415)}una persona
Dialogue: 0,0:00:11.52,0:00:12.60,B,,0,0,0,,{\pos(540,1415)}el día que se vaya
Dialogue: 0,0:00:12.60,0:00:13.36,B,,0,0,0,,{\pos(540,1415)}tu valor va a dejar
Dialogue: 0,0:00:13.36,0:00:13.92,B,,0,0,0,,{\pos(540,1415)}de existir
Dialogue: 0,0:00:13.92,0:00:15.07,B,,0,0,0,,{\pos(540,1415)}Leer otro libro de autoestima
Dialogue: 0,0:00:15.07,0:00:15.98,B,,0,0,0,,{\pos(540,1415)}o crecimiento personal
Dialogue: 0,0:00:15.98,0:00:16.52,B,,0,0,0,,{\pos(540,1415)}número 8
Dialogue: 0,0:00:16.52,0:00:17.61,B,,0,0,0,,{\pos(540,1415)}Entenderlo no significa
Dialogue: 0,0:00:17.61,0:00:18.21,B,,0,0,0,,{\pos(540,1415)}que lo cambies
Dialogue: 0,0:00:18.21,0:00:18.89,B,,0,0,0,,{\pos(540,1415)}y tú ya lo entiendes
Dialogue: 0,0:00:18.89,0:00:19.18,B,,0,0,0,,{\pos(540,1415)}todo
Dialogue: 0,0:00:19.18,0:00:20.00,B,,0,0,0,,{\pos(540,1415)}Cambiar tu físico
Dialogue: 0,0:00:20.00,0:00:20.61,B,,0,0,0,,{\pos(540,1415)}o tu ropa
Dialogue: 0,0:00:20.61,0:00:21.23,B,,0,0,0,,{\pos(540,1415)}número 7
Dialogue: 0,0:00:21.23,0:00:22.12,B,,0,0,0,,{\pos(540,1415)}Te ayuda a sentirte mejor
Dialogue: 0,0:00:22.12,0:00:22.93,B,,0,0,0,,{\pos(540,1415)}un rato y te mete
Dialogue: 0,0:00:22.93,0:00:23.75,B,,0,0,0,,{\pos(540,1415)}un chute de dopamina
Dialogue: 0,0:00:23.75,0:00:24.48,B,,0,0,0,,{\pos(540,1415)}pero si por dentro no
Dialogue: 0,0:00:24.48,0:00:25.24,B,,0,0,0,,{\pos(540,1415)}te sientes bien
Dialogue: 0,0:00:25.24,0:00:26.24,B,,0,0,0,,{\pos(540,1415)}cualquier espejo te va
Dialogue: 0,0:00:26.24,0:00:27.12,B,,0,0,0,,{\pos(540,1415)}a recordar la realidad
Dialogue: 0,0:00:27.12,0:00:28.27,B,,0,0,0,,{\pos(540,1415)}Estar en silencio cada día
Dialogue: 0,0:00:28.27,0:00:28.97,B,,0,0,0,,{\pos(540,1415)}número 6
Dialogue: 0,0:00:28.97,0:00:29.87,B,,0,0,0,,{\pos(540,1415)}10 minutos sin ruido
Dialogue: 0,0:00:29.87,0:00:30.39,B,,0,0,0,,{\pos(540,1415)}y sin móvil te va
Dialogue: 0,0:00:30.39,0:00:31.84,B,,0,0,0,,{\pos(540,1415)}a forzar a escuchar realmente
Dialogue: 0,0:00:31.84,0:00:32.58,B,,0,0,0,,{\pos(540,1415)}lo que sientes
Dialogue: 0,0:00:32.58,0:00:33.40,B,,0,0,0,,{\pos(540,1415)}y que durante mucho tiempo
Dialogue: 0,0:00:33.40,0:00:33.87,B,,0,0,0,,{\pos(540,1415)}has tapado
Dialogue: 0,0:00:33.87,0:00:34.74,B,,0,0,0,,{\pos(540,1415)}Lo que consumes
Dialogue: 0,0:00:34.74,0:00:35.41,B,,0,0,0,,{\pos(540,1415)}número 5
Dialogue: 0,0:00:35.41,0:00:36.13,B,,0,0,0,,{\pos(540,1415)}¿No solo lo que comes
Dialogue: 0,0:00:36.13,0:00:37.33,B,,0,0,0,,{\pos(540,1415)}sino cada noticia y cada
Dialogue: 0,0:00:37.33,0:00:37.97,B,,0,0,0,,{\pos(540,1415)}rato que pasas
Dialogue: 0,0:00:37.97,0:00:38.72,B,,0,0,0,,{\pos(540,1415)}en las redes sociales
Dialogue: 0,0:00:38.72,0:00:39.84,B,,0,0,0,,{\pos(540,1415)}comparándote con otros
Dialogue: 0,0:00:39.84,0:00:40.86,B,,0,0,0,,{\pos(540,1415)}y poniendo la atención
Dialogue: 0,0:00:40.86,0:00:41.90,B,,0,0,0,,{\pos(540,1415)}en cosas negativas?
Dialogue: 0,0:00:41.90,0:00:43.11,B,,0,0,0,,{\pos(540,1415)}Hace que tu energía baje
Dialogue: 0,0:00:43.11,0:00:44.35,B,,0,0,0,,{\pos(540,1415)}sin ni siquiera darte cuenta
Dialogue: 0,0:00:44.35,0:00:45.12,B,,0,0,0,,{\pos(540,1415)}Mover tu cuerpo y hacer
Dialogue: 0,0:00:45.12,0:00:46.43,B,,0,0,0,,{\pos(540,1415)}ejercicio número 4
Dialogue: 0,0:00:46.43,0:00:47.29,B,,0,0,0,,{\pos(540,1415)}Cuando la energía se queda
Dialogue: 0,0:00:47.29,0:00:47.70,B,,0,0,0,,{\pos(540,1415)}estancada
Dialogue: 0,0:00:47.70,0:00:48.98,B,,0,0,0,,{\pos(540,1415)}tu autoestima también
Dialogue: 0,0:00:48.98,0:00:49.51,B,,0,0,0,,{\pos(540,1415)}Y mover el cuerpo
Dialogue: 0,0:00:49.51,0:00:50.45,B,,0,0,0,,{\pos(540,1415)}es la forma más rápida
Dialogue: 0,0:00:50.45,0:00:51.31,B,,0,0,0,,{\pos(540,1415)}de mover esa energía
Dialogue: 0,0:00:51.31,0:00:52.00,B,,0,0,0,,{\pos(540,1415)}Poner límites
Dialogue: 0,0:00:52.00,0:00:52.69,B,,0,0,0,,{\pos(540,1415)}número 3
Dialogue: 0,0:00:52.69,0:00:53.35,B,,0,0,0,,{\pos(540,1415)}Cada vez que dices
Dialogue: 0,0:00:53.35,0:00:53.58,B,,0,0,0,,{\pos(540,1415)}que sí
Dialogue: 0,0:00:53.58,0:00:54.72,B,,0,0,0,,{\pos(540,1415)}cuando realmente quieres decir
Dialogue: 0,0:00:54.72,0:00:54.94,B,,0,0,0,,{\pos(540,1415)}que no
Dialogue: 0,0:00:54.94,0:00:55.53,B,,0,0,0,,{\pos(540,1415)}le estás diciendo
Dialogue: 0,0:00:55.53,0:00:56.26,B,,0,0,0,,{\pos(540,1415)}a tu niño interior
Dialogue: 0,0:00:56.26,0:00:57.13,B,,0,0,0,,{\pos(540,1415)}que no vale lo suficiente
Dialogue: 0,0:00:57.13,0:00:58.20,B,,0,0,0,,{\pos(540,1415)}delante de los demás
Dialogue: 0,0:00:58.20,0:00:59.35,B,,0,0,0,,{\pos(540,1415)}Cumplir tu palabra contigo
Dialogue: 0,0:00:59.35,0:01:00.04,B,,0,0,0,,{\pos(540,1415)}número 2
Dialogue: 0,0:01:00.04,0:01:00.98,B,,0,0,0,,{\pos(540,1415)}Si dices algo y luego
Dialogue: 0,0:01:00.98,0:01:01.55,B,,0,0,0,,{\pos(540,1415)}no lo cumples
Dialogue: 0,0:01:01.55,0:01:02.85,B,,0,0,0,,{\pos(540,1415)}hay una incoherencia interna
Dialogue: 0,0:01:02.85,0:01:03.81,B,,0,0,0,,{\pos(540,1415)}que provoca que baje
Dialogue: 0,0:01:03.81,0:01:04.61,B,,0,0,0,,{\pos(540,1415)}tu autoestima y
Dialogue: 0,0:01:04.61,0:01:04.85,B,,0,0,0,,{\pos(540,1415)}por tanto
Dialogue: 0,0:01:04.85,0:01:05.32,B,,0,0,0,,{\pos(540,1415)}tu energía
Dialogue: 0,0:01:05.32,0:01:05.85,B,,0,0,0,,{\pos(540,1415)}Y te aseguro
Dialogue: 0,0:01:05.85,0:01:06.23,B,,0,0,0,,{\pos(540,1415)}de que eso no
Dialogue: 0,0:01:06.23,0:01:07.57,B,,0,0,0,,{\pos(540,1415)}lo arregla ninguna frase
Dialogue: 0,0:01:07.57,0:01:08.01,B,,0,0,0,,{\pos(540,1415)}bonita
Dialogue: 0,0:01:08.01,0:01:09.08,B,,0,0,0,,{\pos(540,1415)}Escuchar lo que sientes
Dialogue: 0,0:01:09.08,0:01:10.41,B,,0,0,0,,{\pos(540,1415)}número uno y más importante
Dialogue: 0,0:01:10.41,0:01:11.02,B,,0,0,0,,{\pos(540,1415)}Lo que sientes
Dialogue: 0,0:01:11.02,0:01:11.60,B,,0,0,0,,{\pos(540,1415)}es lo que manda
Dialogue: 0,0:01:11.60,0:01:12.28,B,,0,0,0,,{\pos(540,1415)}y si lo tapas
Dialogue: 0,0:01:12.28,0:01:13.08,B,,0,0,0,,{\pos(540,1415)}nada de lo anterior
Dialogue: 0,0:01:13.08,0:01:13.72,B,,0,0,0,,{\pos(540,1415)}te va a funcionar
Dialogue: 0,0:01:13.72,0:01:14.45,B,,0,0,0,,{\pos(540,1415)}Porque lo que no quieres
Dialogue: 0,0:01:14.45,0:01:15.29,B,,0,0,0,,{\pos(540,1415)}sentir no se va
Dialogue: 0,0:01:15.29,0:01:16.06,B,,0,0,0,,{\pos(540,1415)}se queda dentro
Dialogue: 0,0:01:16.06,0:01:16.90,B,,0,0,0,,{\pos(540,1415)}y te sigue controlando
Dialogue: 0,0:01:16.90,0:01:18.01,B,,0,0,0,,{\pos(540,1415)}de forma inconsciente
