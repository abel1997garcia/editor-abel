Dialogue: 0,0:00:00.09,0:00:01.24,B,,0,0,0,,{\pos(540,1415)}Las peores y las mejores
Dialogue: 0,0:00:01.24,0:00:02.39,B,,0,0,0,,{\pos(540,1415)}formas de subir tu autoestima
Dialogue: 0,0:00:02.39,0:00:03.59,B,,0,0,0,,{\pos(540,1415)}En el último puesto
Dialogue: 0,0:00:03.59,0:00:04.94,B,,0,0,0,,{\pos(540,1415)}las afirmaciones
Dialogue: 0,0:00:04.94,0:00:06.38,B,,0,0,0,,{\pos(540,1415)}Porque repetir me quiero como
Dialogue: 0,0:00:06.38,0:00:07.51,B,,0,0,0,,{\pos(540,1415)}si fueras un puto robot
Dialogue: 0,0:00:07.51,0:00:09.08,B,,0,0,0,,{\pos(540,1415)}sin creértelo nunca te va
Dialogue: 0,0:00:09.08,0:00:09.50,B,,0,0,0,,{\pos(540,1415)}a servir
Dialogue: 0,0:00:09.50,0:00:10.31,B,,0,0,0,,{\pos(540,1415)}Y encima es peor
Dialogue: 0,0:00:10.31,0:00:11.08,B,,0,0,0,,{\pos(540,1415)}porque dentro de ti
Dialogue: 0,0:00:11.08,0:00:12.33,B,,0,0,0,,{\pos(540,1415)}tu cabeza sabe que eso
Dialogue: 0,0:00:12.33,0:00:13.05,B,,0,0,0,,{\pos(540,1415)}no te lo crees
Dialogue: 0,0:00:13.05,0:00:14.09,B,,0,0,0,,{\pos(540,1415)}Y que estás forzando ser
Dialogue: 0,0:00:14.09,0:00:15.17,B,,0,0,0,,{\pos(540,1415)}alguien que no eres
Dialogue: 0,0:00:15.17,0:00:16.34,B,,0,0,0,,{\pos(540,1415)}En el penúltimo lugar
Dialogue: 0,0:00:16.34,0:00:17.88,B,,0,0,0,,{\pos(540,1415)}los libros y los vision
Dialogue: 0,0:00:17.88,0:00:18.78,B,,0,0,0,,{\pos(540,1415)}boards o los tableros
Dialogue: 0,0:00:18.78,0:00:19.32,B,,0,0,0,,{\pos(540,1415)}de sueño
Dialogue: 0,0:00:19.32,0:00:20.31,B,,0,0,0,,{\pos(540,1415)}Porque te inspiran
Dialogue: 0,0:00:20.31,0:00:21.32,B,,0,0,0,,{\pos(540,1415)}ordenan las ideas
Dialogue: 0,0:00:21.32,0:00:22.15,B,,0,0,0,,{\pos(540,1415)}pero no van a hacer
Dialogue: 0,0:00:22.15,0:00:22.89,B,,0,0,0,,{\pos(540,1415)}el trabajo por ti
Dialogue: 0,0:00:22.89,0:00:23.85,B,,0,0,0,,{\pos(540,1415)}En el segundo lugar
Dialogue: 0,0:00:23.85,0:00:24.73,B,,0,0,0,,{\pos(540,1415)}el silencio
Dialogue: 0,0:00:24.73,0:00:25.66,B,,0,0,0,,{\pos(540,1415)}Apagar la cabeza un rato
Dialogue: 0,0:00:25.66,0:00:26.67,B,,0,0,0,,{\pos(540,1415)}y empezar a centrarte
Dialogue: 0,0:00:26.67,0:00:27.88,B,,0,0,0,,{\pos(540,1415)}en lo que sientes
Dialogue: 0,0:00:27.88,0:00:29.25,B,,0,0,0,,{\pos(540,1415)}Porque ahí es cuando empieza
Dialogue: 0,0:00:29.25,0:00:30.33,B,,0,0,0,,{\pos(540,1415)}poco a poco el cambio
Dialogue: 0,0:00:30.33,0:00:30.74,B,,0,0,0,,{\pos(540,1415)}real
Dialogue: 0,0:00:30.74,0:00:31.37,B,,0,0,0,,{\pos(540,1415)}Y en el primero
Dialogue: 0,0:00:31.37,0:00:32.77,B,,0,0,0,,{\pos(540,1415)}comportarte como la persona
Dialogue: 0,0:00:32.77,0:00:33.76,B,,0,0,0,,{\pos(540,1415)}que ya se quiere
Dialogue: 0,0:00:33.76,0:00:34.33,B,,0,0,0,,{\pos(540,1415)}y que ya lo ha
Dialogue: 0,0:00:34.33,0:00:35.08,B,,0,0,0,,{\pos(540,1415)}logrado todo
Dialogue: 0,0:00:35.08,0:00:35.73,B,,0,0,0,,{\pos(540,1415)}Pensar
Dialogue: 0,0:00:35.73,0:00:37.00,B,,0,0,0,,{\pos(540,1415)}sentir y decidir como
Dialogue: 0,0:00:37.00,0:00:37.96,B,,0,0,0,,{\pos(540,1415)}lo haría ella
Dialogue: 0,0:00:37.96,0:00:38.93,B,,0,0,0,,{\pos(540,1415)}como lo haría tu mejor
Dialogue: 0,0:00:38.93,0:00:39.47,B,,0,0,0,,{\pos(540,1415)}versión
Dialogue: 0,0:00:39.47,0:00:40.77,B,,0,0,0,,{\pos(540,1415)}Porque lo que vive sintiéndolo
Dialogue: 0,0:00:40.77,0:00:41.36,B,,0,0,0,,{\pos(540,1415)}de verdad
Dialogue: 0,0:00:41.36,0:00:42.34,B,,0,0,0,,{\pos(540,1415)}Tu vida no lo distingue
Dialogue: 0,0:00:42.34,0:00:43.32,B,,0,0,0,,{\pos(540,1415)}si es algo real
Dialogue: 0,0:00:43.32,0:00:44.15,B,,0,0,0,,{\pos(540,1415)}o es ficticio
Dialogue: 0,0:00:44.15,0:00:45.43,B,,0,0,0,,{\pos(540,1415)}Así que empieza hoy diciendo
Dialogue: 0,0:00:45.43,0:00:46.34,B,,0,0,0,,{\pos(540,1415)}que no a algo
Dialogue: 0,0:00:46.34,0:00:47.79,B,,0,0,0,,{\pos(540,1415)}que no querías hacer como
Dialogue: 0,0:00:47.79,0:00:48.96,B,,0,0,0,,{\pos(540,1415)}si lo hiciera la mejor
Dialogue: 0,0:00:48.96,0:00:49.49,B,,0,0,0,,{\pos(540,1415)}versión de ti
Dialogue: 0,0:00:49.49,0:00:50.28,B,,0,0,0,,{\pos(540,1415)}que se respeta
