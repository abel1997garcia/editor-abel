Dialogue: 0,0:00:00.03,0:00:00.64,B,,0,0,0,,{\pos(540,1415)}Lo que más haces
Dialogue: 0,0:00:00.64,0:00:01.36,B,,0,0,0,,{\pos(540,1415)}para quererte
Dialogue: 0,0:00:01.36,0:00:02.08,B,,0,0,0,,{\pos(540,1415)}es lo que menos
Dialogue: 0,0:00:02.08,0:00:02.59,B,,0,0,0,,{\pos(540,1415)}te funciona
Dialogue: 0,0:00:02.59,0:00:03.84,B,,0,0,0,,{\pos(540,1415)}Las peores y las mejores
Dialogue: 0,0:00:03.84,0:00:04.99,B,,0,0,0,,{\pos(540,1415)}formas de subir tu autoestima
Dialogue: 0,0:00:04.99,0:00:06.19,B,,0,0,0,,{\pos(540,1415)}En el último puesto
Dialogue: 0,0:00:06.19,0:00:07.53,B,,0,0,0,,{\pos(540,1415)}las afirmaciones
Dialogue: 0,0:00:07.53,0:00:08.97,B,,0,0,0,,{\pos(540,1415)}Porque repetir me quiero como
Dialogue: 0,0:00:08.97,0:00:10.11,B,,0,0,0,,{\pos(540,1415)}si fueras un puto robot
Dialogue: 0,0:00:10.11,0:00:11.66,B,,0,0,0,,{\pos(540,1415)}sin creértelo nunca te va
Dialogue: 0,0:00:11.66,0:00:12.08,B,,0,0,0,,{\pos(540,1415)}a servir
Dialogue: 0,0:00:12.08,0:00:12.89,B,,0,0,0,,{\pos(540,1415)}Y encima es peor
Dialogue: 0,0:00:12.89,0:00:13.67,B,,0,0,0,,{\pos(540,1415)}porque dentro de ti
Dialogue: 0,0:00:13.67,0:00:14.92,B,,0,0,0,,{\pos(540,1415)}tu cabeza sabe que eso
Dialogue: 0,0:00:14.92,0:00:15.64,B,,0,0,0,,{\pos(540,1415)}no te lo crees
Dialogue: 0,0:00:15.64,0:00:16.68,B,,0,0,0,,{\pos(540,1415)}Y que estás forzando ser
Dialogue: 0,0:00:16.68,0:00:17.76,B,,0,0,0,,{\pos(540,1415)}alguien que no eres
Dialogue: 0,0:00:17.76,0:00:18.92,B,,0,0,0,,{\pos(540,1415)}En el penúltimo lugar
Dialogue: 0,0:00:18.92,0:00:20.46,B,,0,0,0,,{\pos(540,1415)}los libros y los vision
Dialogue: 0,0:00:20.46,0:00:21.37,B,,0,0,0,,{\pos(540,1415)}boards o los tableros
Dialogue: 0,0:00:21.37,0:00:21.90,B,,0,0,0,,{\pos(540,1415)}de sueño
Dialogue: 0,0:00:21.90,0:00:22.89,B,,0,0,0,,{\pos(540,1415)}Porque te inspiran
Dialogue: 0,0:00:22.89,0:00:23.90,B,,0,0,0,,{\pos(540,1415)}ordenan las ideas
Dialogue: 0,0:00:23.90,0:00:24.60,B,,0,0,0,,{\pos(540,1415)}pero no van a hacer
Dialogue: 0,0:00:24.60,0:00:25.48,B,,0,0,0,,{\pos(540,1415)}el trabajo por ti
Dialogue: 0,0:00:25.48,0:00:26.44,B,,0,0,0,,{\pos(540,1415)}En el segundo lugar
Dialogue: 0,0:00:26.44,0:00:27.33,B,,0,0,0,,{\pos(540,1415)}el silencio
Dialogue: 0,0:00:27.33,0:00:28.24,B,,0,0,0,,{\pos(540,1415)}Apagar la cabeza un rato
Dialogue: 0,0:00:28.24,0:00:29.26,B,,0,0,0,,{\pos(540,1415)}y empezar a centrarte
Dialogue: 0,0:00:29.26,0:00:30.42,B,,0,0,0,,{\pos(540,1415)}en lo que sientes
Dialogue: 0,0:00:30.42,0:00:31.78,B,,0,0,0,,{\pos(540,1415)}Porque ahí es cuando empieza
Dialogue: 0,0:00:31.78,0:00:32.87,B,,0,0,0,,{\pos(540,1415)}poco a poco el cambio
Dialogue: 0,0:00:32.87,0:00:33.27,B,,0,0,0,,{\pos(540,1415)}real
Dialogue: 0,0:00:33.27,0:00:33.91,B,,0,0,0,,{\pos(540,1415)}Y en el primero
Dialogue: 0,0:00:33.91,0:00:35.30,B,,0,0,0,,{\pos(540,1415)}comportarte como la persona
Dialogue: 0,0:00:35.30,0:00:36.28,B,,0,0,0,,{\pos(540,1415)}que ya se quiere
Dialogue: 0,0:00:36.28,0:00:36.86,B,,0,0,0,,{\pos(540,1415)}y que ya lo ha
Dialogue: 0,0:00:36.86,0:00:37.62,B,,0,0,0,,{\pos(540,1415)}logrado todo
Dialogue: 0,0:00:37.62,0:00:38.27,B,,0,0,0,,{\pos(540,1415)}Pensar
Dialogue: 0,0:00:38.27,0:00:39.53,B,,0,0,0,,{\pos(540,1415)}sentir y decidir como
Dialogue: 0,0:00:39.53,0:00:40.49,B,,0,0,0,,{\pos(540,1415)}lo haría ella
Dialogue: 0,0:00:40.49,0:00:41.48,B,,0,0,0,,{\pos(540,1415)}como lo haría tu mejor
Dialogue: 0,0:00:41.48,0:00:42.00,B,,0,0,0,,{\pos(540,1415)}versión
Dialogue: 0,0:00:42.00,0:00:43.31,B,,0,0,0,,{\pos(540,1415)}Porque lo que vive sintiéndolo
Dialogue: 0,0:00:43.31,0:00:43.89,B,,0,0,0,,{\pos(540,1415)}de verdad
Dialogue: 0,0:00:43.89,0:00:44.87,B,,0,0,0,,{\pos(540,1415)}Tu vida no lo distingue
Dialogue: 0,0:00:44.87,0:00:45.87,B,,0,0,0,,{\pos(540,1415)}si es algo real
Dialogue: 0,0:00:45.87,0:00:46.68,B,,0,0,0,,{\pos(540,1415)}o es ficticio
Dialogue: 0,0:00:46.68,0:00:47.96,B,,0,0,0,,{\pos(540,1415)}Así que empieza hoy diciendo
Dialogue: 0,0:00:47.96,0:00:48.88,B,,0,0,0,,{\pos(540,1415)}que no a algo
Dialogue: 0,0:00:48.88,0:00:50.32,B,,0,0,0,,{\pos(540,1415)}que no querías hacer como
Dialogue: 0,0:00:50.32,0:00:51.48,B,,0,0,0,,{\pos(540,1415)}si lo hiciera la mejor
Dialogue: 0,0:00:51.48,0:00:52.02,B,,0,0,0,,{\pos(540,1415)}versión de ti
Dialogue: 0,0:00:52.02,0:00:52.82,B,,0,0,0,,{\pos(540,1415)}que se respeta
