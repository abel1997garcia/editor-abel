Dialogue: 0,0:00:00.06,0:00:01.37,B,,0,0,0,,{\pos(540,1415)}Repetir me quiero frente
Dialogue: 0,0:00:01.37,0:00:02.82,B,,0,0,0,,{\pos(540,1415)}al espejo te puede hundir
Dialogue: 0,0:00:02.82,0:00:03.49,B,,0,0,0,,{\pos(540,1415)}todavía más
Dialogue: 0,0:00:03.49,0:00:04.72,B,,0,0,0,,{\pos(540,1415)}Las peores y las mejores
Dialogue: 0,0:00:04.72,0:00:05.87,B,,0,0,0,,{\pos(540,1415)}formas de subir tu autoestima
Dialogue: 0,0:00:05.87,0:00:07.08,B,,0,0,0,,{\pos(540,1415)}En el último puesto
Dialogue: 0,0:00:07.08,0:00:08.38,B,,0,0,0,,{\pos(540,1415)}las afirmaciones
Dialogue: 0,0:00:08.38,0:00:09.82,B,,0,0,0,,{\pos(540,1415)}Porque repetir me quiero como
Dialogue: 0,0:00:09.82,0:00:10.95,B,,0,0,0,,{\pos(540,1415)}si fueras un puto robot
Dialogue: 0,0:00:10.95,0:00:12.52,B,,0,0,0,,{\pos(540,1415)}sin creértelo nunca te va
Dialogue: 0,0:00:12.52,0:00:12.94,B,,0,0,0,,{\pos(540,1415)}a servir
Dialogue: 0,0:00:12.94,0:00:13.75,B,,0,0,0,,{\pos(540,1415)}Y encima es peor
Dialogue: 0,0:00:13.75,0:00:14.52,B,,0,0,0,,{\pos(540,1415)}porque dentro de ti
Dialogue: 0,0:00:14.52,0:00:15.78,B,,0,0,0,,{\pos(540,1415)}tu cabeza sabe que eso
Dialogue: 0,0:00:15.78,0:00:16.49,B,,0,0,0,,{\pos(540,1415)}no te lo crees
Dialogue: 0,0:00:16.49,0:00:17.53,B,,0,0,0,,{\pos(540,1415)}Y que estás forzando ser
Dialogue: 0,0:00:17.53,0:00:18.61,B,,0,0,0,,{\pos(540,1415)}alguien que no eres
Dialogue: 0,0:00:18.61,0:00:19.77,B,,0,0,0,,{\pos(540,1415)}En el penúltimo lugar
Dialogue: 0,0:00:19.77,0:00:21.31,B,,0,0,0,,{\pos(540,1415)}los libros y los vision
Dialogue: 0,0:00:21.31,0:00:22.30,B,,0,0,0,,{\pos(540,1415)}boards o los tableros
Dialogue: 0,0:00:22.30,0:00:22.74,B,,0,0,0,,{\pos(540,1415)}de sueño
Dialogue: 0,0:00:22.74,0:00:23.73,B,,0,0,0,,{\pos(540,1415)}Porque te inspiran
Dialogue: 0,0:00:23.73,0:00:24.74,B,,0,0,0,,{\pos(540,1415)}ordenan las ideas
Dialogue: 0,0:00:24.74,0:00:25.44,B,,0,0,0,,{\pos(540,1415)}pero no van a hacer
Dialogue: 0,0:00:25.44,0:00:26.31,B,,0,0,0,,{\pos(540,1415)}el trabajo por ti
Dialogue: 0,0:00:26.31,0:00:27.28,B,,0,0,0,,{\pos(540,1415)}En el segundo lugar
Dialogue: 0,0:00:27.28,0:00:28.16,B,,0,0,0,,{\pos(540,1415)}el silencio
Dialogue: 0,0:00:28.16,0:00:29.08,B,,0,0,0,,{\pos(540,1415)}Apagar la cabeza un rato
Dialogue: 0,0:00:29.08,0:00:30.09,B,,0,0,0,,{\pos(540,1415)}y empezar a centrarte
Dialogue: 0,0:00:30.09,0:00:31.29,B,,0,0,0,,{\pos(540,1415)}en lo que sientes
Dialogue: 0,0:00:31.29,0:00:32.65,B,,0,0,0,,{\pos(540,1415)}Porque ahí es cuando empieza
Dialogue: 0,0:00:32.65,0:00:33.74,B,,0,0,0,,{\pos(540,1415)}poco a poco el cambio
Dialogue: 0,0:00:33.74,0:00:34.14,B,,0,0,0,,{\pos(540,1415)}real
Dialogue: 0,0:00:34.14,0:00:34.79,B,,0,0,0,,{\pos(540,1415)}Y en el primero
Dialogue: 0,0:00:34.79,0:00:36.17,B,,0,0,0,,{\pos(540,1415)}comportarte como la persona
Dialogue: 0,0:00:36.17,0:00:37.15,B,,0,0,0,,{\pos(540,1415)}que ya se quiere
Dialogue: 0,0:00:37.15,0:00:37.70,B,,0,0,0,,{\pos(540,1415)}y que ya lo ha
Dialogue: 0,0:00:37.70,0:00:38.49,B,,0,0,0,,{\pos(540,1415)}logrado todo
Dialogue: 0,0:00:38.49,0:00:39.13,B,,0,0,0,,{\pos(540,1415)}Pensar
Dialogue: 0,0:00:39.13,0:00:40.41,B,,0,0,0,,{\pos(540,1415)}sentir y decidir como
Dialogue: 0,0:00:40.41,0:00:41.37,B,,0,0,0,,{\pos(540,1415)}lo haría ella
Dialogue: 0,0:00:41.37,0:00:42.34,B,,0,0,0,,{\pos(540,1415)}como lo haría tu mejor
Dialogue: 0,0:00:42.34,0:00:42.88,B,,0,0,0,,{\pos(540,1415)}versión
Dialogue: 0,0:00:42.88,0:00:44.17,B,,0,0,0,,{\pos(540,1415)}Porque lo que vive sintiéndolo
Dialogue: 0,0:00:44.17,0:00:44.76,B,,0,0,0,,{\pos(540,1415)}de verdad
Dialogue: 0,0:00:44.76,0:00:45.74,B,,0,0,0,,{\pos(540,1415)}Tu vida no lo distingue
Dialogue: 0,0:00:45.74,0:00:46.74,B,,0,0,0,,{\pos(540,1415)}si es algo real
Dialogue: 0,0:00:46.74,0:00:47.55,B,,0,0,0,,{\pos(540,1415)}o es ficticio
Dialogue: 0,0:00:47.55,0:00:48.83,B,,0,0,0,,{\pos(540,1415)}Así que empieza hoy diciendo
Dialogue: 0,0:00:48.83,0:00:49.74,B,,0,0,0,,{\pos(540,1415)}que no a algo
Dialogue: 0,0:00:49.74,0:00:51.19,B,,0,0,0,,{\pos(540,1415)}que no querías hacer como
Dialogue: 0,0:00:51.19,0:00:52.36,B,,0,0,0,,{\pos(540,1415)}si lo hiciera la mejor
Dialogue: 0,0:00:52.36,0:00:52.78,B,,0,0,0,,{\pos(540,1415)}versión de ti
Dialogue: 0,0:00:52.78,0:00:53.69,B,,0,0,0,,{\pos(540,1415)}que se respeta
