Dialogue: 0,0:00:00.00,0:00:01.02,B,,0,0,0,,{\pos(540,1415)}Ya lo he probado todo
Dialogue: 0,0:00:01.02,0:00:01.77,B,,0,0,0,,{\pos(540,1415)}Todo menos esto
Dialogue: 0,0:00:01.77,0:00:03.04,B,,0,0,0,,{\pos(540,1415)}Las peores y las mejores
Dialogue: 0,0:00:03.04,0:00:04.19,B,,0,0,0,,{\pos(540,1415)}formas de subir tu autoestima
Dialogue: 0,0:00:04.19,0:00:05.39,B,,0,0,0,,{\pos(540,1415)}En el último puesto
Dialogue: 0,0:00:05.39,0:00:06.74,B,,0,0,0,,{\pos(540,1415)}las afirmaciones
Dialogue: 0,0:00:06.74,0:00:08.19,B,,0,0,0,,{\pos(540,1415)}Porque repetir me quiero como
Dialogue: 0,0:00:08.19,0:00:09.31,B,,0,0,0,,{\pos(540,1415)}si fueras un puto robot
Dialogue: 0,0:00:09.31,0:00:10.88,B,,0,0,0,,{\pos(540,1415)}sin creértelo nunca te va
Dialogue: 0,0:00:10.88,0:00:11.30,B,,0,0,0,,{\pos(540,1415)}a servir
Dialogue: 0,0:00:11.30,0:00:12.11,B,,0,0,0,,{\pos(540,1415)}Y encima es peor
Dialogue: 0,0:00:12.11,0:00:12.88,B,,0,0,0,,{\pos(540,1415)}porque dentro de ti
Dialogue: 0,0:00:12.88,0:00:14.15,B,,0,0,0,,{\pos(540,1415)}tu cabeza sabe que eso
Dialogue: 0,0:00:14.15,0:00:14.84,B,,0,0,0,,{\pos(540,1415)}no te lo crees
Dialogue: 0,0:00:14.84,0:00:15.88,B,,0,0,0,,{\pos(540,1415)}Y que estás forzando ser
Dialogue: 0,0:00:15.88,0:00:16.95,B,,0,0,0,,{\pos(540,1415)}alguien que no eres
Dialogue: 0,0:00:16.95,0:00:18.12,B,,0,0,0,,{\pos(540,1415)}En el penúltimo lugar
Dialogue: 0,0:00:18.12,0:00:19.66,B,,0,0,0,,{\pos(540,1415)}los libros y los vision
Dialogue: 0,0:00:19.66,0:00:20.57,B,,0,0,0,,{\pos(540,1415)}boards o los tableros
Dialogue: 0,0:00:20.57,0:00:21.10,B,,0,0,0,,{\pos(540,1415)}de sueño
Dialogue: 0,0:00:21.10,0:00:22.08,B,,0,0,0,,{\pos(540,1415)}Porque te inspiran
Dialogue: 0,0:00:22.08,0:00:23.09,B,,0,0,0,,{\pos(540,1415)}ordenan las ideas
Dialogue: 0,0:00:23.09,0:00:23.92,B,,0,0,0,,{\pos(540,1415)}pero no van a hacer
Dialogue: 0,0:00:23.92,0:00:24.66,B,,0,0,0,,{\pos(540,1415)}el trabajo por ti
Dialogue: 0,0:00:24.66,0:00:25.63,B,,0,0,0,,{\pos(540,1415)}En el segundo lugar
Dialogue: 0,0:00:25.63,0:00:26.50,B,,0,0,0,,{\pos(540,1415)}el silencio
Dialogue: 0,0:00:26.50,0:00:27.43,B,,0,0,0,,{\pos(540,1415)}Apagar la cabeza un rato
Dialogue: 0,0:00:27.43,0:00:28.44,B,,0,0,0,,{\pos(540,1415)}y empezar a centrarte
Dialogue: 0,0:00:28.44,0:00:29.60,B,,0,0,0,,{\pos(540,1415)}en lo que sientes
Dialogue: 0,0:00:29.60,0:00:30.96,B,,0,0,0,,{\pos(540,1415)}Porque ahí es cuando empieza
Dialogue: 0,0:00:30.96,0:00:32.05,B,,0,0,0,,{\pos(540,1415)}poco a poco el cambio
Dialogue: 0,0:00:32.05,0:00:32.46,B,,0,0,0,,{\pos(540,1415)}real
Dialogue: 0,0:00:32.46,0:00:33.09,B,,0,0,0,,{\pos(540,1415)}Y en el primero
Dialogue: 0,0:00:33.09,0:00:34.48,B,,0,0,0,,{\pos(540,1415)}comportarte como la persona
Dialogue: 0,0:00:34.48,0:00:35.46,B,,0,0,0,,{\pos(540,1415)}que ya se quiere
Dialogue: 0,0:00:35.46,0:00:36.04,B,,0,0,0,,{\pos(540,1415)}y que ya lo ha
Dialogue: 0,0:00:36.04,0:00:36.76,B,,0,0,0,,{\pos(540,1415)}logrado todo
Dialogue: 0,0:00:36.76,0:00:37.40,B,,0,0,0,,{\pos(540,1415)}Pensar
Dialogue: 0,0:00:37.40,0:00:38.67,B,,0,0,0,,{\pos(540,1415)}sentir y decidir como
Dialogue: 0,0:00:38.67,0:00:39.62,B,,0,0,0,,{\pos(540,1415)}lo haría ella
Dialogue: 0,0:00:39.62,0:00:40.62,B,,0,0,0,,{\pos(540,1415)}como lo haría tu mejor
Dialogue: 0,0:00:40.62,0:00:41.14,B,,0,0,0,,{\pos(540,1415)}versión
Dialogue: 0,0:00:41.14,0:00:42.43,B,,0,0,0,,{\pos(540,1415)}Porque lo que vive sintiéndolo
Dialogue: 0,0:00:42.43,0:00:43.03,B,,0,0,0,,{\pos(540,1415)}de verdad
Dialogue: 0,0:00:43.03,0:00:44.00,B,,0,0,0,,{\pos(540,1415)}Tu vida no lo distingue
Dialogue: 0,0:00:44.00,0:00:44.99,B,,0,0,0,,{\pos(540,1415)}si es algo real
Dialogue: 0,0:00:44.99,0:00:45.83,B,,0,0,0,,{\pos(540,1415)}o es ficticio
Dialogue: 0,0:00:45.83,0:00:47.10,B,,0,0,0,,{\pos(540,1415)}Así que empieza hoy diciendo
Dialogue: 0,0:00:47.10,0:00:48.01,B,,0,0,0,,{\pos(540,1415)}que no a algo
Dialogue: 0,0:00:48.01,0:00:49.46,B,,0,0,0,,{\pos(540,1415)}que no querías hacer como
Dialogue: 0,0:00:49.46,0:00:50.63,B,,0,0,0,,{\pos(540,1415)}si lo hiciera la mejor
Dialogue: 0,0:00:50.63,0:00:51.16,B,,0,0,0,,{\pos(540,1415)}versión de ti
Dialogue: 0,0:00:51.16,0:00:51.95,B,,0,0,0,,{\pos(540,1415)}que se respeta
