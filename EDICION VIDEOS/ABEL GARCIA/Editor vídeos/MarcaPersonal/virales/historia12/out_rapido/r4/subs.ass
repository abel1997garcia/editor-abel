Dialogue: 0,0:00:00.00,0:00:00.81,B,,0,0,0,,{\pos(540,1415)}Hay una sola cosa
Dialogue: 0,0:00:00.81,0:00:01.68,B,,0,0,0,,{\pos(540,1415)}que de verdad te sube
Dialogue: 0,0:00:01.68,0:00:02.32,B,,0,0,0,,{\pos(540,1415)}la autoestima
Dialogue: 0,0:00:02.32,0:00:03.59,B,,0,0,0,,{\pos(540,1415)}Las peores y las mejores
Dialogue: 0,0:00:03.59,0:00:04.72,B,,0,0,0,,{\pos(540,1415)}formas de subir tu autoestima
Dialogue: 0,0:00:04.72,0:00:05.93,B,,0,0,0,,{\pos(540,1415)}En el último puesto
Dialogue: 0,0:00:05.93,0:00:07.26,B,,0,0,0,,{\pos(540,1415)}las afirmaciones
Dialogue: 0,0:00:07.26,0:00:08.70,B,,0,0,0,,{\pos(540,1415)}Porque repetir me quiero como
Dialogue: 0,0:00:08.70,0:00:09.83,B,,0,0,0,,{\pos(540,1415)}si fueras un puto robot
Dialogue: 0,0:00:09.83,0:00:11.40,B,,0,0,0,,{\pos(540,1415)}sin creértelo nunca te va
Dialogue: 0,0:00:11.40,0:00:11.83,B,,0,0,0,,{\pos(540,1415)}a servir
Dialogue: 0,0:00:11.83,0:00:12.63,B,,0,0,0,,{\pos(540,1415)}Y encima es peor
Dialogue: 0,0:00:12.63,0:00:13.40,B,,0,0,0,,{\pos(540,1415)}porque dentro de ti
Dialogue: 0,0:00:13.40,0:00:14.67,B,,0,0,0,,{\pos(540,1415)}tu cabeza sabe que eso
Dialogue: 0,0:00:14.67,0:00:15.35,B,,0,0,0,,{\pos(540,1415)}no te lo crees
Dialogue: 0,0:00:15.35,0:00:16.40,B,,0,0,0,,{\pos(540,1415)}Y que estás forzando ser
Dialogue: 0,0:00:16.40,0:00:17.47,B,,0,0,0,,{\pos(540,1415)}alguien que no eres
Dialogue: 0,0:00:17.47,0:00:18.64,B,,0,0,0,,{\pos(540,1415)}En el penúltimo lugar
Dialogue: 0,0:00:18.64,0:00:20.17,B,,0,0,0,,{\pos(540,1415)}los libros y los vision
Dialogue: 0,0:00:20.17,0:00:21.08,B,,0,0,0,,{\pos(540,1415)}boards o los tableros
Dialogue: 0,0:00:21.08,0:00:21.63,B,,0,0,0,,{\pos(540,1415)}de sueño
Dialogue: 0,0:00:21.63,0:00:22.61,B,,0,0,0,,{\pos(540,1415)}Porque te inspiran
Dialogue: 0,0:00:22.61,0:00:23.62,B,,0,0,0,,{\pos(540,1415)}ordenan las ideas
Dialogue: 0,0:00:23.62,0:00:24.32,B,,0,0,0,,{\pos(540,1415)}pero no van a hacer
Dialogue: 0,0:00:24.32,0:00:25.20,B,,0,0,0,,{\pos(540,1415)}el trabajo por ti
Dialogue: 0,0:00:25.20,0:00:26.16,B,,0,0,0,,{\pos(540,1415)}En el segundo lugar
Dialogue: 0,0:00:26.16,0:00:27.04,B,,0,0,0,,{\pos(540,1415)}el silencio
Dialogue: 0,0:00:27.04,0:00:27.96,B,,0,0,0,,{\pos(540,1415)}Apagar la cabeza un rato
Dialogue: 0,0:00:27.96,0:00:28.98,B,,0,0,0,,{\pos(540,1415)}y empezar a centrarte
Dialogue: 0,0:00:28.98,0:00:30.12,B,,0,0,0,,{\pos(540,1415)}en lo que sientes
Dialogue: 0,0:00:30.12,0:00:31.48,B,,0,0,0,,{\pos(540,1415)}Porque ahí es cuando empieza
Dialogue: 0,0:00:31.48,0:00:32.57,B,,0,0,0,,{\pos(540,1415)}poco a poco el cambio
Dialogue: 0,0:00:32.57,0:00:32.97,B,,0,0,0,,{\pos(540,1415)}real
Dialogue: 0,0:00:32.97,0:00:33.61,B,,0,0,0,,{\pos(540,1415)}Y en el primero
Dialogue: 0,0:00:33.61,0:00:35.00,B,,0,0,0,,{\pos(540,1415)}comportarte como la persona
Dialogue: 0,0:00:35.00,0:00:35.98,B,,0,0,0,,{\pos(540,1415)}que ya se quiere
Dialogue: 0,0:00:35.98,0:00:36.56,B,,0,0,0,,{\pos(540,1415)}y que ya lo ha
Dialogue: 0,0:00:36.56,0:00:37.28,B,,0,0,0,,{\pos(540,1415)}logrado todo
Dialogue: 0,0:00:37.28,0:00:37.91,B,,0,0,0,,{\pos(540,1415)}Pensar
Dialogue: 0,0:00:37.91,0:00:39.19,B,,0,0,0,,{\pos(540,1415)}sentir y decidir como
Dialogue: 0,0:00:39.19,0:00:40.14,B,,0,0,0,,{\pos(540,1415)}lo haría ella
Dialogue: 0,0:00:40.14,0:00:41.12,B,,0,0,0,,{\pos(540,1415)}como lo haría tu mejor
Dialogue: 0,0:00:41.12,0:00:41.65,B,,0,0,0,,{\pos(540,1415)}versión
Dialogue: 0,0:00:41.65,0:00:42.95,B,,0,0,0,,{\pos(540,1415)}Porque lo que vive sintiéndolo
Dialogue: 0,0:00:42.95,0:00:43.54,B,,0,0,0,,{\pos(540,1415)}de verdad
Dialogue: 0,0:00:43.54,0:00:44.52,B,,0,0,0,,{\pos(540,1415)}Tu vida no lo distingue
Dialogue: 0,0:00:44.52,0:00:45.52,B,,0,0,0,,{\pos(540,1415)}si es algo real
Dialogue: 0,0:00:45.52,0:00:46.34,B,,0,0,0,,{\pos(540,1415)}o es ficticio
Dialogue: 0,0:00:46.34,0:00:47.62,B,,0,0,0,,{\pos(540,1415)}Así que empieza hoy diciendo
Dialogue: 0,0:00:47.62,0:00:48.53,B,,0,0,0,,{\pos(540,1415)}que no a algo
Dialogue: 0,0:00:48.53,0:00:49.97,B,,0,0,0,,{\pos(540,1415)}que no querías hacer como
Dialogue: 0,0:00:49.97,0:00:51.14,B,,0,0,0,,{\pos(540,1415)}si lo hiciera la mejor
Dialogue: 0,0:00:51.14,0:00:51.68,B,,0,0,0,,{\pos(540,1415)}versión de ti
Dialogue: 0,0:00:51.68,0:00:52.47,B,,0,0,0,,{\pos(540,1415)}que se respeta
