Dialogue: 0,0:00:00.04,0:00:01.48,B,,0,0,0,,{\pos(540,1415)}Nunca me sale nada bien
Dialogue: 0,0:00:01.48,0:00:02.33,B,,0,0,0,,{\pos(540,1415)}Mira lo que le estás
Dialogue: 0,0:00:02.33,0:00:03.46,B,,0,0,0,,{\pos(540,1415)}enseñando a tu espejo cada
Dialogue: 0,0:00:03.46,0:00:03.67,B,,0,0,0,,{\pos(540,1415)}día
Dialogue: 0,0:00:03.67,0:00:04.98,B,,0,0,0,,{\pos(540,1415)}Si te levantas despeinado
Dialogue: 0,0:00:04.98,0:00:05.91,B,,0,0,0,,{\pos(540,1415)}¿peinas el espejo
Dialogue: 0,0:00:05.91,0:00:06.66,B,,0,0,0,,{\pos(540,1415)}o te peinas tú?
Dialogue: 0,0:00:06.66,0:00:07.48,B,,0,0,0,,{\pos(540,1415)}Parece una tontería
Dialogue: 0,0:00:07.48,0:00:07.63,B,,0,0,0,,{\pos(540,1415)}pero
Dialogue: 0,0:00:07.63,0:00:08.63,B,,0,0,0,,{\pos(540,1415)}es lo que tú haces
Dialogue: 0,0:00:08.63,0:00:09.73,B,,0,0,0,,{\pos(540,1415)}cada día cuando quieres
Dialogue: 0,0:00:09.73,0:00:10.57,B,,0,0,0,,{\pos(540,1415)}que cambie tu vida
Dialogue: 0,0:00:10.57,0:00:11.33,B,,0,0,0,,{\pos(540,1415)}sin cambiar tú
Dialogue: 0,0:00:11.33,0:00:12.14,B,,0,0,0,,{\pos(540,1415)}El espejo es como
Dialogue: 0,0:00:12.14,0:00:13.46,B,,0,0,0,,{\pos(540,1415)}la vida y solamente
Dialogue: 0,0:00:13.46,0:00:14.62,B,,0,0,0,,{\pos(540,1415)}te puede devolver aquello
Dialogue: 0,0:00:14.62,0:00:15.46,B,,0,0,0,,{\pos(540,1415)}que le enseñas
Dialogue: 0,0:00:15.46,0:00:16.97,B,,0,0,0,,{\pos(540,1415)}Fulano quiere estar mejor
Dialogue: 0,0:00:16.97,0:00:17.88,B,,0,0,0,,{\pos(540,1415)}pero se pasa todo
Dialogue: 0,0:00:17.88,0:00:19.14,B,,0,0,0,,{\pos(540,1415)}el día agobiado
Dialogue: 0,0:00:19.14,0:00:20.59,B,,0,0,0,,{\pos(540,1415)}de mala hostia y quejándose
Dialogue: 0,0:00:20.59,0:00:21.77,B,,0,0,0,,{\pos(540,1415)}Mirando lo que le falta
Dialogue: 0,0:00:21.77,0:00:22.53,B,,0,0,0,,{\pos(540,1415)}de si la gente
Dialogue: 0,0:00:22.53,0:00:24.11,B,,0,0,0,,{\pos(540,1415)}de que si sus compañeros
Dialogue: 0,0:00:24.11,0:00:25.10,B,,0,0,0,,{\pos(540,1415)}de que si el trabajo
Dialogue: 0,0:00:25.10,0:00:25.69,B,,0,0,0,,{\pos(540,1415)}de que esto está muy
Dialogue: 0,0:00:25.69,0:00:26.12,B,,0,0,0,,{\pos(540,1415)}caro
Dialogue: 0,0:00:26.12,0:00:26.99,B,,0,0,0,,{\pos(540,1415)}Quiere que su vida cambie
Dialogue: 0,0:00:26.99,0:00:27.67,B,,0,0,0,,{\pos(540,1415)}pero llega a casa
Dialogue: 0,0:00:27.67,0:00:28.55,B,,0,0,0,,{\pos(540,1415)}y le muestra la vida
Dialogue: 0,0:00:28.55,0:00:29.67,B,,0,0,0,,{\pos(540,1415)}de alguien desesperado
Dialogue: 0,0:00:29.67,0:00:30.63,B,,0,0,0,,{\pos(540,1415)}de alguien agobiado
Dialogue: 0,0:00:30.63,0:00:31.47,B,,0,0,0,,{\pos(540,1415)}de mala hostia
Dialogue: 0,0:00:31.47,0:00:33.12,B,,0,0,0,,{\pos(540,1415)}y la vida simplemente refleja
Dialogue: 0,0:00:33.12,0:00:33.63,B,,0,0,0,,{\pos(540,1415)}eso mismo
Dialogue: 0,0:00:33.63,0:00:34.93,B,,0,0,0,,{\pos(540,1415)}Pero Mengano pilló el juego
Dialogue: 0,0:00:34.93,0:00:35.86,B,,0,0,0,,{\pos(540,1415)}y empezó a aplicarlo
Dialogue: 0,0:00:35.86,0:00:36.51,B,,0,0,0,,{\pos(540,1415)}a su favor
Dialogue: 0,0:00:36.51,0:00:37.57,B,,0,0,0,,{\pos(540,1415)}Empezó a cuidarse
Dialogue: 0,0:00:37.57,0:00:38.88,B,,0,0,0,,{\pos(540,1415)}empezó a hablarse bien
Dialogue: 0,0:00:38.88,0:00:39.50,B,,0,0,0,,{\pos(540,1415)}y empezó a dejar
Dialogue: 0,0:00:39.50,0:00:40.17,B,,0,0,0,,{\pos(540,1415)}de quejarse
Dialogue: 0,0:00:40.17,0:00:41.29,B,,0,0,0,,{\pos(540,1415)}por lo que la vida
Dialogue: 0,0:00:41.29,0:00:41.96,B,,0,0,0,,{\pos(540,1415)}no le daba
Dialogue: 0,0:00:41.96,0:00:43.11,B,,0,0,0,,{\pos(540,1415)}Y empezó a comportarse como
Dialogue: 0,0:00:43.11,0:00:44.54,B,,0,0,0,,{\pos(540,1415)}alguien que se siente capaz
Dialogue: 0,0:00:44.54,0:00:45.26,B,,0,0,0,,{\pos(540,1415)}y que ya se siente
Dialogue: 0,0:00:45.26,0:00:45.96,B,,0,0,0,,{\pos(540,1415)}suficiente
Dialogue: 0,0:00:45.96,0:00:47.36,B,,0,0,0,,{\pos(540,1415)}Y el espejo no tuvo
Dialogue: 0,0:00:47.36,0:00:49.29,B,,0,0,0,,{\pos(540,1415)}más remedio que devolverle esa
Dialogue: 0,0:00:49.29,0:00:50.07,B,,0,0,0,,{\pos(540,1415)}misma imagen
Dialogue: 0,0:00:50.07,0:00:50.98,B,,0,0,0,,{\pos(540,1415)}El espejo o la vida
Dialogue: 0,0:00:50.98,0:00:51.80,B,,0,0,0,,{\pos(540,1415)}no entienden nada
Dialogue: 0,0:00:51.80,0:00:53.16,B,,0,0,0,,{\pos(540,1415)}simplemente te reflejan
Dialogue: 0,0:00:53.16,0:00:54.31,B,,0,0,0,,{\pos(540,1415)}y te devuelven todo aquello
Dialogue: 0,0:00:54.31,0:00:55.38,B,,0,0,0,,{\pos(540,1415)}que tú das y emanas
Dialogue: 0,0:00:55.38,0:00:55.87,B,,0,0,0,,{\pos(540,1415)}Por tanto
Dialogue: 0,0:00:55.87,0:00:56.77,B,,0,0,0,,{\pos(540,1415)}cambia por dentro
Dialogue: 0,0:00:56.77,0:00:57.53,B,,0,0,0,,{\pos(540,1415)}y lo de fuera
Dialogue: 0,0:00:57.53,0:00:58.32,B,,0,0,0,,{\pos(540,1415)}se tiene que adaptar
Dialogue: 0,0:00:58.32,0:00:59.14,B,,0,0,0,,{\pos(540,1415)}por consecuencia
Dialogue: 0,0:00:59.14,0:00:59.69,B,,0,0,0,,{\pos(540,1415)}Así que hoy
Dialogue: 0,0:00:59.69,0:01:00.61,B,,0,0,0,,{\pos(540,1415)}cada vez que te pilles
Dialogue: 0,0:01:00.61,0:01:01.18,B,,0,0,0,,{\pos(540,1415)}quejándote
Dialogue: 0,0:01:01.18,0:01:02.08,B,,0,0,0,,{\pos(540,1415)}Cámbialo por algo
Dialogue: 0,0:01:02.08,0:01:03.31,B,,0,0,0,,{\pos(540,1415)}que realmente agradezcas
