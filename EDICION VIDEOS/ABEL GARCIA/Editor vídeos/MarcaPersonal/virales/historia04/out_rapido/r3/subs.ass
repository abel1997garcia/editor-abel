Dialogue: 0,0:00:00.00,0:00:00.85,B,,0,0,0,,{\pos(540,1415)}Quejarte de todo
Dialogue: 0,0:00:00.85,0:00:01.43,B,,0,0,0,,{\pos(540,1415)}es lo que hace
Dialogue: 0,0:00:01.43,0:00:02.57,B,,0,0,0,,{\pos(540,1415)}que tu vida siga siendo
Dialogue: 0,0:00:02.57,0:00:03.04,B,,0,0,0,,{\pos(540,1415)}igual
Dialogue: 0,0:00:03.04,0:00:04.35,B,,0,0,0,,{\pos(540,1415)}Si te levantas despeinado
Dialogue: 0,0:00:04.35,0:00:05.27,B,,0,0,0,,{\pos(540,1415)}¿peinas el espejo
Dialogue: 0,0:00:05.27,0:00:06.02,B,,0,0,0,,{\pos(540,1415)}o te peinas tú?
Dialogue: 0,0:00:06.02,0:00:06.83,B,,0,0,0,,{\pos(540,1415)}Parece una tontería
Dialogue: 0,0:00:06.83,0:00:07.08,B,,0,0,0,,{\pos(540,1415)}pero
Dialogue: 0,0:00:07.08,0:00:07.99,B,,0,0,0,,{\pos(540,1415)}es lo que tú haces
Dialogue: 0,0:00:07.99,0:00:09.10,B,,0,0,0,,{\pos(540,1415)}cada día cuando quieres
Dialogue: 0,0:00:09.10,0:00:09.94,B,,0,0,0,,{\pos(540,1415)}que cambie tu vida
Dialogue: 0,0:00:09.94,0:00:10.69,B,,0,0,0,,{\pos(540,1415)}sin cambiar tú
Dialogue: 0,0:00:10.69,0:00:11.50,B,,0,0,0,,{\pos(540,1415)}El espejo es como
Dialogue: 0,0:00:11.50,0:00:12.82,B,,0,0,0,,{\pos(540,1415)}la vida y solamente
Dialogue: 0,0:00:12.82,0:00:13.98,B,,0,0,0,,{\pos(540,1415)}te puede devolver aquello
Dialogue: 0,0:00:13.98,0:00:14.83,B,,0,0,0,,{\pos(540,1415)}que le enseñas
Dialogue: 0,0:00:14.83,0:00:16.33,B,,0,0,0,,{\pos(540,1415)}Fulano quiere estar mejor
Dialogue: 0,0:00:16.33,0:00:17.27,B,,0,0,0,,{\pos(540,1415)}pero se pasa todo
Dialogue: 0,0:00:17.27,0:00:18.52,B,,0,0,0,,{\pos(540,1415)}el día agobiado
Dialogue: 0,0:00:18.52,0:00:19.94,B,,0,0,0,,{\pos(540,1415)}de mala hostia y quejándose
Dialogue: 0,0:00:19.94,0:00:21.12,B,,0,0,0,,{\pos(540,1415)}Mirando lo que le falta
Dialogue: 0,0:00:21.12,0:00:22.04,B,,0,0,0,,{\pos(540,1415)}de si la gente
Dialogue: 0,0:00:22.04,0:00:23.46,B,,0,0,0,,{\pos(540,1415)}de que si sus compañeros
Dialogue: 0,0:00:23.46,0:00:24.45,B,,0,0,0,,{\pos(540,1415)}de que si el trabajo
Dialogue: 0,0:00:24.45,0:00:25.04,B,,0,0,0,,{\pos(540,1415)}de que esto está muy
Dialogue: 0,0:00:25.04,0:00:25.46,B,,0,0,0,,{\pos(540,1415)}caro
Dialogue: 0,0:00:25.46,0:00:26.33,B,,0,0,0,,{\pos(540,1415)}Quiere que su vida cambie
Dialogue: 0,0:00:26.33,0:00:27.01,B,,0,0,0,,{\pos(540,1415)}pero llega a casa
Dialogue: 0,0:00:27.01,0:00:27.90,B,,0,0,0,,{\pos(540,1415)}y le muestra la vida
Dialogue: 0,0:00:27.90,0:00:29.01,B,,0,0,0,,{\pos(540,1415)}de alguien desesperado
Dialogue: 0,0:00:29.01,0:00:29.97,B,,0,0,0,,{\pos(540,1415)}de alguien agobiado
Dialogue: 0,0:00:29.97,0:00:30.81,B,,0,0,0,,{\pos(540,1415)}de mala hostia
Dialogue: 0,0:00:30.81,0:00:32.46,B,,0,0,0,,{\pos(540,1415)}y la vida simplemente refleja
Dialogue: 0,0:00:32.46,0:00:32.99,B,,0,0,0,,{\pos(540,1415)}eso mismo
Dialogue: 0,0:00:32.99,0:00:34.27,B,,0,0,0,,{\pos(540,1415)}Pero Mengano pilló el juego
Dialogue: 0,0:00:34.27,0:00:35.21,B,,0,0,0,,{\pos(540,1415)}y empezó a aplicarlo
Dialogue: 0,0:00:35.21,0:00:35.85,B,,0,0,0,,{\pos(540,1415)}a su favor
Dialogue: 0,0:00:35.85,0:00:36.92,B,,0,0,0,,{\pos(540,1415)}Empezó a cuidarse
Dialogue: 0,0:00:36.92,0:00:38.24,B,,0,0,0,,{\pos(540,1415)}empezó a hablarse bien
Dialogue: 0,0:00:38.24,0:00:38.85,B,,0,0,0,,{\pos(540,1415)}y empezó a dejar
Dialogue: 0,0:00:38.85,0:00:39.52,B,,0,0,0,,{\pos(540,1415)}de quejarse
Dialogue: 0,0:00:39.52,0:00:40.64,B,,0,0,0,,{\pos(540,1415)}por lo que la vida
Dialogue: 0,0:00:40.64,0:00:41.31,B,,0,0,0,,{\pos(540,1415)}no le daba
Dialogue: 0,0:00:41.31,0:00:42.46,B,,0,0,0,,{\pos(540,1415)}Y empezó a comportarse como
Dialogue: 0,0:00:42.46,0:00:43.89,B,,0,0,0,,{\pos(540,1415)}alguien que se siente capaz
Dialogue: 0,0:00:43.89,0:00:44.62,B,,0,0,0,,{\pos(540,1415)}y que ya se siente
Dialogue: 0,0:00:44.62,0:00:45.31,B,,0,0,0,,{\pos(540,1415)}suficiente
Dialogue: 0,0:00:45.31,0:00:46.71,B,,0,0,0,,{\pos(540,1415)}Y el espejo no tuvo
Dialogue: 0,0:00:46.71,0:00:48.64,B,,0,0,0,,{\pos(540,1415)}más remedio que devolverle esa
Dialogue: 0,0:00:48.64,0:00:49.41,B,,0,0,0,,{\pos(540,1415)}misma imagen
Dialogue: 0,0:00:49.41,0:00:50.33,B,,0,0,0,,{\pos(540,1415)}El espejo o la vida
Dialogue: 0,0:00:50.33,0:00:51.14,B,,0,0,0,,{\pos(540,1415)}no entienden nada
Dialogue: 0,0:00:51.14,0:00:52.50,B,,0,0,0,,{\pos(540,1415)}simplemente te reflejan
Dialogue: 0,0:00:52.50,0:00:53.65,B,,0,0,0,,{\pos(540,1415)}y te devuelven todo aquello
Dialogue: 0,0:00:53.65,0:00:54.74,B,,0,0,0,,{\pos(540,1415)}que tú das y emanas
Dialogue: 0,0:00:54.74,0:00:55.22,B,,0,0,0,,{\pos(540,1415)}Por tanto
Dialogue: 0,0:00:55.22,0:00:56.12,B,,0,0,0,,{\pos(540,1415)}cambia por dentro
Dialogue: 0,0:00:56.12,0:00:56.88,B,,0,0,0,,{\pos(540,1415)}y lo de fuera
Dialogue: 0,0:00:56.88,0:00:57.67,B,,0,0,0,,{\pos(540,1415)}se tiene que adaptar
Dialogue: 0,0:00:57.67,0:00:58.49,B,,0,0,0,,{\pos(540,1415)}por consecuencia
Dialogue: 0,0:00:58.49,0:00:59.04,B,,0,0,0,,{\pos(540,1415)}Así que hoy
Dialogue: 0,0:00:59.04,0:00:59.96,B,,0,0,0,,{\pos(540,1415)}cada vez que te pilles
Dialogue: 0,0:00:59.96,0:01:00.54,B,,0,0,0,,{\pos(540,1415)}quejándote
Dialogue: 0,0:01:00.54,0:01:01.43,B,,0,0,0,,{\pos(540,1415)}Cámbialo por algo
Dialogue: 0,0:01:01.43,0:01:02.66,B,,0,0,0,,{\pos(540,1415)}que realmente agradezcas
