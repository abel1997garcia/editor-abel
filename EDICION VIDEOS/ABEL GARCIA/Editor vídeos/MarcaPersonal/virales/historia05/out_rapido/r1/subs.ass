Dialogue: 0,0:00:00.02,0:00:01.05,B,,0,0,0,,{\pos(540,1415)}Voy a cambiarte la vida
Dialogue: 0,0:00:01.05,0:00:02.19,B,,0,0,0,,{\pos(540,1415)}con 5 preguntas
Dialogue: 0,0:00:02.19,0:00:03.31,B,,0,0,0,,{\pos(540,1415)}Imagínate que tienes delante
Dialogue: 0,0:00:03.31,0:00:04.22,B,,0,0,0,,{\pos(540,1415)}de ti la persona
Dialogue: 0,0:00:04.22,0:00:04.99,B,,0,0,0,,{\pos(540,1415)}que tú quieres ser
Dialogue: 0,0:00:04.99,0:00:05.60,B,,0,0,0,,{\pos(540,1415)}en el futuro
Dialogue: 0,0:00:05.60,0:00:06.37,B,,0,0,0,,{\pos(540,1415)}que ya se quiere
Dialogue: 0,0:00:06.37,0:00:07.56,B,,0,0,0,,{\pos(540,1415)}que es tu mejor versión
Dialogue: 0,0:00:07.56,0:00:08.29,B,,0,0,0,,{\pos(540,1415)}y a partir de ahí
Dialogue: 0,0:00:08.29,0:00:09.10,B,,0,0,0,,{\pos(540,1415)}contesta estas cinco
Dialogue: 0,0:00:09.10,0:00:09.80,B,,0,0,0,,{\pos(540,1415)}preguntas
Dialogue: 0,0:00:09.80,0:00:10.64,B,,0,0,0,,{\pos(540,1415)}Pregunta 1
Dialogue: 0,0:00:10.64,0:00:12.05,B,,0,0,0,,{\pos(540,1415)}¿Cuánto gana en un año?
Dialogue: 0,0:00:12.05,0:00:13.30,B,,0,0,0,,{\pos(540,1415)}Pon la cifra exacta
Dialogue: 0,0:00:13.30,0:00:14.19,B,,0,0,0,,{\pos(540,1415)}no te quedes corto
Dialogue: 0,0:00:14.19,0:00:15.07,B,,0,0,0,,{\pos(540,1415)}Pregunta número 2
Dialogue: 0,0:00:15.07,0:00:15.84,B,,0,0,0,,{\pos(540,1415)}¿Cómo se viste?
Dialogue: 0,0:00:15.84,0:00:16.87,B,,0,0,0,,{\pos(540,1415)}¿Qué colores lleva?
Dialogue: 0,0:00:16.87,0:00:17.65,B,,0,0,0,,{\pos(540,1415)}Y sobre todo
Dialogue: 0,0:00:17.65,0:00:18.42,B,,0,0,0,,{\pos(540,1415)}¿cómo se mueve?
Dialogue: 0,0:00:18.42,0:00:19.81,B,,0,0,0,,{\pos(540,1415)}Pregunta número 3
Dialogue: 0,0:00:19.81,0:00:21.00,B,,0,0,0,,{\pos(540,1415)}¿Dónde vive?
Dialogue: 0,0:00:21.00,0:00:22.04,B,,0,0,0,,{\pos(540,1415)}Y quiero que lo describas
Dialogue: 0,0:00:22.04,0:00:23.44,B,,0,0,0,,{\pos(540,1415)}con todo lujo de detalles
Dialogue: 0,0:00:23.44,0:00:24.86,B,,0,0,0,,{\pos(540,1415)}Pregunta número 4
Dialogue: 0,0:00:24.86,0:00:25.61,B,,0,0,0,,{\pos(540,1415)}¿De qué habla?
Dialogue: 0,0:00:25.61,0:00:26.30,B,,0,0,0,,{\pos(540,1415)}De viajes
Dialogue: 0,0:00:26.30,0:00:27.03,B,,0,0,0,,{\pos(540,1415)}de negocios
Dialogue: 0,0:00:27.03,0:00:28.06,B,,0,0,0,,{\pos(540,1415)}de nuevos proyectos
Dialogue: 0,0:00:28.06,0:00:29.17,B,,0,0,0,,{\pos(540,1415)}de nuevas ilusiones
Dialogue: 0,0:00:29.17,0:00:30.38,B,,0,0,0,,{\pos(540,1415)}Y pregunta número 5
Dialogue: 0,0:00:30.38,0:00:31.49,B,,0,0,0,,{\pos(540,1415)}y la más importante
Dialogue: 0,0:00:31.49,0:00:32.90,B,,0,0,0,,{\pos(540,1415)}¿Cómo reacciona cuando algo
Dialogue: 0,0:00:32.90,0:00:33.73,B,,0,0,0,,{\pos(540,1415)}le sale mal?
Dialogue: 0,0:00:33.73,0:00:35.07,B,,0,0,0,,{\pos(540,1415)}Se hunde o sabe dentro
Dialogue: 0,0:00:35.07,0:00:35.72,B,,0,0,0,,{\pos(540,1415)}de sí que lo va
Dialogue: 0,0:00:35.72,0:00:36.69,B,,0,0,0,,{\pos(540,1415)}a arreglar cueste
Dialogue: 0,0:00:36.69,0:00:37.51,B,,0,0,0,,{\pos(540,1415)}lo que cueste y pase
Dialogue: 0,0:00:37.51,0:00:37.93,B,,0,0,0,,{\pos(540,1415)}lo que pase
Dialogue: 0,0:00:37.93,0:00:39.36,B,,0,0,0,,{\pos(540,1415)}Y ahora lo más importante
Dialogue: 0,0:00:39.36,0:00:40.40,B,,0,0,0,,{\pos(540,1415)}vive tu vida como si
Dialogue: 0,0:00:40.40,0:00:42.02,B,,0,0,0,,{\pos(540,1415)}esas cinco preguntas ya
Dialogue: 0,0:00:42.02,0:00:43.52,B,,0,0,0,,{\pos(540,1415)}estuvieran realizadas y ya
Dialogue: 0,0:00:43.52,0:00:44.11,B,,0,0,0,,{\pos(540,1415)}fueran verdad
Dialogue: 0,0:00:44.11,0:00:45.09,B,,0,0,0,,{\pos(540,1415)}En cómo te hablas
Dialogue: 0,0:00:45.09,0:00:46.03,B,,0,0,0,,{\pos(540,1415)}en lo que decides
Dialogue: 0,0:00:46.03,0:00:46.93,B,,0,0,0,,{\pos(540,1415)}en qué haces
Dialogue: 0,0:00:46.93,0:00:47.87,B,,0,0,0,,{\pos(540,1415)}en qué te centras
Dialogue: 0,0:00:47.87,0:00:48.78,B,,0,0,0,,{\pos(540,1415)}Me suda los huevos
Dialogue: 0,0:00:48.78,0:00:49.38,B,,0,0,0,,{\pos(540,1415)}que tu vida de hoy
Dialogue: 0,0:00:49.38,0:00:50.53,B,,0,0,0,,{\pos(540,1415)}sea otra completamente
Dialogue: 0,0:00:50.53,0:00:51.10,B,,0,0,0,,{\pos(540,1415)}diferente
Dialogue: 0,0:00:51.10,0:00:52.25,B,,0,0,0,,{\pos(540,1415)}Hazlo durante un mes
Dialogue: 0,0:00:52.25,0:00:53.19,B,,0,0,0,,{\pos(540,1415)}Y mira lo que pasa
