Dialogue: 0,0:00:00.01,0:00:00.90,B,,0,0,0,,{\pos(540,1415)}Vives como la versión
Dialogue: 0,0:00:00.90,0:00:01.87,B,,0,0,0,,{\pos(540,1415)}de ti que realmente no
Dialogue: 0,0:00:01.87,0:00:02.37,B,,0,0,0,,{\pos(540,1415)}se quiere
Dialogue: 0,0:00:02.37,0:00:03.50,B,,0,0,0,,{\pos(540,1415)}Imagínate que tienes delante
Dialogue: 0,0:00:03.50,0:00:04.41,B,,0,0,0,,{\pos(540,1415)}de ti la persona
Dialogue: 0,0:00:04.41,0:00:05.16,B,,0,0,0,,{\pos(540,1415)}que tú quieres ser
Dialogue: 0,0:00:05.16,0:00:05.78,B,,0,0,0,,{\pos(540,1415)}en el futuro
Dialogue: 0,0:00:05.78,0:00:06.55,B,,0,0,0,,{\pos(540,1415)}que ya se quiere
Dialogue: 0,0:00:06.55,0:00:07.75,B,,0,0,0,,{\pos(540,1415)}que es tu mejor versión
Dialogue: 0,0:00:07.75,0:00:08.46,B,,0,0,0,,{\pos(540,1415)}y a partir de ahí
Dialogue: 0,0:00:08.46,0:00:09.29,B,,0,0,0,,{\pos(540,1415)}contesta estas cinco
Dialogue: 0,0:00:09.29,0:00:09.99,B,,0,0,0,,{\pos(540,1415)}preguntas
Dialogue: 0,0:00:09.99,0:00:10.83,B,,0,0,0,,{\pos(540,1415)}Pregunta 1
Dialogue: 0,0:00:10.83,0:00:12.23,B,,0,0,0,,{\pos(540,1415)}¿Cuánto gana en un año?
Dialogue: 0,0:00:12.23,0:00:13.47,B,,0,0,0,,{\pos(540,1415)}Pon la cifra exacta
Dialogue: 0,0:00:13.47,0:00:14.37,B,,0,0,0,,{\pos(540,1415)}no te quedes corto
Dialogue: 0,0:00:14.37,0:00:15.25,B,,0,0,0,,{\pos(540,1415)}Pregunta número 2
Dialogue: 0,0:00:15.25,0:00:16.03,B,,0,0,0,,{\pos(540,1415)}¿Cómo se viste?
Dialogue: 0,0:00:16.03,0:00:17.05,B,,0,0,0,,{\pos(540,1415)}¿Qué colores lleva?
Dialogue: 0,0:00:17.05,0:00:17.83,B,,0,0,0,,{\pos(540,1415)}Y sobre todo
Dialogue: 0,0:00:17.83,0:00:18.56,B,,0,0,0,,{\pos(540,1415)}¿cómo se mueve?
Dialogue: 0,0:00:18.56,0:00:19.96,B,,0,0,0,,{\pos(540,1415)}Pregunta número 3
Dialogue: 0,0:00:19.96,0:00:21.15,B,,0,0,0,,{\pos(540,1415)}¿Dónde vive?
Dialogue: 0,0:00:21.15,0:00:22.19,B,,0,0,0,,{\pos(540,1415)}Y quiero que lo describas
Dialogue: 0,0:00:22.19,0:00:23.58,B,,0,0,0,,{\pos(540,1415)}con todo lujo de detalles
Dialogue: 0,0:00:23.58,0:00:25.00,B,,0,0,0,,{\pos(540,1415)}Pregunta número 4
Dialogue: 0,0:00:25.00,0:00:25.74,B,,0,0,0,,{\pos(540,1415)}¿De qué habla?
Dialogue: 0,0:00:25.74,0:00:26.43,B,,0,0,0,,{\pos(540,1415)}De viajes
Dialogue: 0,0:00:26.43,0:00:27.17,B,,0,0,0,,{\pos(540,1415)}de negocios
Dialogue: 0,0:00:27.17,0:00:28.19,B,,0,0,0,,{\pos(540,1415)}de nuevos proyectos
Dialogue: 0,0:00:28.19,0:00:29.30,B,,0,0,0,,{\pos(540,1415)}de nuevas ilusiones
Dialogue: 0,0:00:29.30,0:00:30.51,B,,0,0,0,,{\pos(540,1415)}Y pregunta número 5
Dialogue: 0,0:00:30.51,0:00:31.64,B,,0,0,0,,{\pos(540,1415)}y la más importante
Dialogue: 0,0:00:31.64,0:00:33.04,B,,0,0,0,,{\pos(540,1415)}¿Cómo reacciona cuando algo
Dialogue: 0,0:00:33.04,0:00:33.90,B,,0,0,0,,{\pos(540,1415)}le sale mal?
Dialogue: 0,0:00:33.90,0:00:35.25,B,,0,0,0,,{\pos(540,1415)}Se hunde o sabe dentro
Dialogue: 0,0:00:35.25,0:00:35.90,B,,0,0,0,,{\pos(540,1415)}de sí que lo va
Dialogue: 0,0:00:35.90,0:00:36.87,B,,0,0,0,,{\pos(540,1415)}a arreglar cueste
Dialogue: 0,0:00:36.87,0:00:37.59,B,,0,0,0,,{\pos(540,1415)}lo que cueste y pase
Dialogue: 0,0:00:37.59,0:00:38.11,B,,0,0,0,,{\pos(540,1415)}lo que pase
Dialogue: 0,0:00:38.11,0:00:39.55,B,,0,0,0,,{\pos(540,1415)}Y ahora lo más importante
Dialogue: 0,0:00:39.55,0:00:40.58,B,,0,0,0,,{\pos(540,1415)}vive tu vida como si
Dialogue: 0,0:00:40.58,0:00:42.20,B,,0,0,0,,{\pos(540,1415)}esas cinco preguntas ya
Dialogue: 0,0:00:42.20,0:00:43.70,B,,0,0,0,,{\pos(540,1415)}estuvieran realizadas y ya
Dialogue: 0,0:00:43.70,0:00:44.29,B,,0,0,0,,{\pos(540,1415)}fueran verdad
Dialogue: 0,0:00:44.29,0:00:45.28,B,,0,0,0,,{\pos(540,1415)}En cómo te hablas
Dialogue: 0,0:00:45.28,0:00:46.21,B,,0,0,0,,{\pos(540,1415)}en lo que decides
Dialogue: 0,0:00:46.21,0:00:47.05,B,,0,0,0,,{\pos(540,1415)}en qué haces
Dialogue: 0,0:00:47.05,0:00:48.05,B,,0,0,0,,{\pos(540,1415)}en qué te centras
Dialogue: 0,0:00:48.05,0:00:48.97,B,,0,0,0,,{\pos(540,1415)}Me suda los huevos
Dialogue: 0,0:00:48.97,0:00:49.57,B,,0,0,0,,{\pos(540,1415)}que tu vida de hoy
Dialogue: 0,0:00:49.57,0:00:50.65,B,,0,0,0,,{\pos(540,1415)}sea otra completamente
Dialogue: 0,0:00:50.65,0:00:51.29,B,,0,0,0,,{\pos(540,1415)}diferente
Dialogue: 0,0:00:51.29,0:00:52.44,B,,0,0,0,,{\pos(540,1415)}Hazlo durante un mes
Dialogue: 0,0:00:52.44,0:00:53.37,B,,0,0,0,,{\pos(540,1415)}Y mira lo que pasa
