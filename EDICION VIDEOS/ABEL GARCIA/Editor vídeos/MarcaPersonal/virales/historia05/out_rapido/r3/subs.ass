Dialogue: 0,0:00:00.00,0:00:01.53,B,,0,0,0,,{\pos(540,1415)}Contesta estas 5 preguntas
Dialogue: 0,0:00:01.53,0:00:01.94,B,,0,0,0,,{\pos(540,1415)}y verás
Dialogue: 0,0:00:01.94,0:00:02.93,B,,0,0,0,,{\pos(540,1415)}por qué tu vida sigue
Dialogue: 0,0:00:02.93,0:00:03.16,B,,0,0,0,,{\pos(540,1415)}igual
Dialogue: 0,0:00:03.16,0:00:04.28,B,,0,0,0,,{\pos(540,1415)}Imagínate que tienes delante
Dialogue: 0,0:00:04.28,0:00:05.19,B,,0,0,0,,{\pos(540,1415)}de ti la persona
Dialogue: 0,0:00:05.19,0:00:05.95,B,,0,0,0,,{\pos(540,1415)}que tú quieres ser
Dialogue: 0,0:00:05.95,0:00:06.57,B,,0,0,0,,{\pos(540,1415)}en el futuro
Dialogue: 0,0:00:06.57,0:00:07.33,B,,0,0,0,,{\pos(540,1415)}que ya se quiere
Dialogue: 0,0:00:07.33,0:00:08.53,B,,0,0,0,,{\pos(540,1415)}que es tu mejor versión
Dialogue: 0,0:00:08.53,0:00:09.24,B,,0,0,0,,{\pos(540,1415)}y a partir de ahí
Dialogue: 0,0:00:09.24,0:00:10.07,B,,0,0,0,,{\pos(540,1415)}contesta estas cinco
Dialogue: 0,0:00:10.07,0:00:10.77,B,,0,0,0,,{\pos(540,1415)}preguntas
Dialogue: 0,0:00:10.77,0:00:11.61,B,,0,0,0,,{\pos(540,1415)}Pregunta 1
Dialogue: 0,0:00:11.61,0:00:13.07,B,,0,0,0,,{\pos(540,1415)}¿Cuánto gana en un año?
Dialogue: 0,0:00:13.07,0:00:14.34,B,,0,0,0,,{\pos(540,1415)}Pon la cifra exacta
Dialogue: 0,0:00:14.34,0:00:15.21,B,,0,0,0,,{\pos(540,1415)}no te quedes corto
Dialogue: 0,0:00:15.21,0:00:16.09,B,,0,0,0,,{\pos(540,1415)}Pregunta número 2
Dialogue: 0,0:00:16.09,0:00:16.86,B,,0,0,0,,{\pos(540,1415)}¿Cómo se viste?
Dialogue: 0,0:00:16.86,0:00:17.89,B,,0,0,0,,{\pos(540,1415)}¿Qué colores lleva?
Dialogue: 0,0:00:17.89,0:00:18.66,B,,0,0,0,,{\pos(540,1415)}Y sobre todo
Dialogue: 0,0:00:18.66,0:00:19.41,B,,0,0,0,,{\pos(540,1415)}¿cómo se mueve?
Dialogue: 0,0:00:19.41,0:00:20.81,B,,0,0,0,,{\pos(540,1415)}Pregunta número 3
Dialogue: 0,0:00:20.81,0:00:22.00,B,,0,0,0,,{\pos(540,1415)}¿Dónde vive?
Dialogue: 0,0:00:22.00,0:00:23.04,B,,0,0,0,,{\pos(540,1415)}Y quiero que lo describas
Dialogue: 0,0:00:23.04,0:00:24.44,B,,0,0,0,,{\pos(540,1415)}con todo lujo de detalles
Dialogue: 0,0:00:24.44,0:00:25.86,B,,0,0,0,,{\pos(540,1415)}Pregunta número 4
Dialogue: 0,0:00:25.86,0:00:26.61,B,,0,0,0,,{\pos(540,1415)}¿De qué habla?
Dialogue: 0,0:00:26.61,0:00:27.30,B,,0,0,0,,{\pos(540,1415)}De viajes
Dialogue: 0,0:00:27.30,0:00:28.03,B,,0,0,0,,{\pos(540,1415)}de negocios
Dialogue: 0,0:00:28.03,0:00:29.05,B,,0,0,0,,{\pos(540,1415)}de nuevos proyectos
Dialogue: 0,0:00:29.05,0:00:30.17,B,,0,0,0,,{\pos(540,1415)}de nuevas ilusiones
Dialogue: 0,0:00:30.17,0:00:31.38,B,,0,0,0,,{\pos(540,1415)}Y pregunta número 5
Dialogue: 0,0:00:31.38,0:00:32.49,B,,0,0,0,,{\pos(540,1415)}y la más importante
Dialogue: 0,0:00:32.49,0:00:33.89,B,,0,0,0,,{\pos(540,1415)}¿Cómo reacciona cuando algo
Dialogue: 0,0:00:33.89,0:00:34.77,B,,0,0,0,,{\pos(540,1415)}le sale mal?
Dialogue: 0,0:00:34.77,0:00:36.12,B,,0,0,0,,{\pos(540,1415)}Se hunde o sabe dentro
Dialogue: 0,0:00:36.12,0:00:36.76,B,,0,0,0,,{\pos(540,1415)}de sí que lo va
Dialogue: 0,0:00:36.76,0:00:37.63,B,,0,0,0,,{\pos(540,1415)}a arreglar cueste
Dialogue: 0,0:00:37.63,0:00:38.56,B,,0,0,0,,{\pos(540,1415)}lo que cueste y pase
Dialogue: 0,0:00:38.56,0:00:38.98,B,,0,0,0,,{\pos(540,1415)}lo que pase
Dialogue: 0,0:00:38.98,0:00:40.41,B,,0,0,0,,{\pos(540,1415)}Y ahora lo más importante
Dialogue: 0,0:00:40.41,0:00:41.45,B,,0,0,0,,{\pos(540,1415)}vive tu vida como si
Dialogue: 0,0:00:41.45,0:00:43.07,B,,0,0,0,,{\pos(540,1415)}esas cinco preguntas ya
Dialogue: 0,0:00:43.07,0:00:44.57,B,,0,0,0,,{\pos(540,1415)}estuvieran realizadas y ya
Dialogue: 0,0:00:44.57,0:00:45.16,B,,0,0,0,,{\pos(540,1415)}fueran verdad
Dialogue: 0,0:00:45.16,0:00:46.14,B,,0,0,0,,{\pos(540,1415)}En cómo te hablas
Dialogue: 0,0:00:46.14,0:00:47.08,B,,0,0,0,,{\pos(540,1415)}en lo que decides
Dialogue: 0,0:00:47.08,0:00:47.91,B,,0,0,0,,{\pos(540,1415)}en qué haces
Dialogue: 0,0:00:47.91,0:00:48.92,B,,0,0,0,,{\pos(540,1415)}en qué te centras
Dialogue: 0,0:00:48.92,0:00:49.81,B,,0,0,0,,{\pos(540,1415)}Me suda los huevos
Dialogue: 0,0:00:49.81,0:00:50.43,B,,0,0,0,,{\pos(540,1415)}que tu vida de hoy
Dialogue: 0,0:00:50.43,0:00:51.58,B,,0,0,0,,{\pos(540,1415)}sea otra completamente
Dialogue: 0,0:00:51.58,0:00:52.16,B,,0,0,0,,{\pos(540,1415)}diferente
Dialogue: 0,0:00:52.16,0:00:53.31,B,,0,0,0,,{\pos(540,1415)}Hazlo durante un mes
Dialogue: 0,0:00:53.31,0:00:54.24,B,,0,0,0,,{\pos(540,1415)}Y mira lo que pasa
