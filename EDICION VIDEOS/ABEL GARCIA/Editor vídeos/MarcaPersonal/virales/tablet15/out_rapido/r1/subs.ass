Dialogue: 0,0:00:00.08,0:00:01.27,B,,0,0,0,,{\pos(540,1415)}Sigues repitiendo afirmaciones
Dialogue: 0,0:00:01.27,0:00:01.85,B,,0,0,0,,{\pos(540,1415)}y no te sirven
Dialogue: 0,0:00:01.85,0:00:02.21,B,,0,0,0,,{\pos(540,1415)}de nada
Dialogue: 0,0:00:02.21,0:00:03.74,B,,0,0,0,,{\pos(540,1415)}Las afirmaciones no importan
Dialogue: 0,0:00:03.74,0:00:04.61,B,,0,0,0,,{\pos(540,1415)}si no te las crees
Dialogue: 0,0:00:04.61,0:00:05.07,B,,0,0,0,,{\pos(540,1415)}Lo que manda
Dialogue: 0,0:00:05.07,0:00:05.80,B,,0,0,0,,{\pos(540,1415)}es lo que sientes cuando
Dialogue: 0,0:00:05.80,0:00:06.35,B,,0,0,0,,{\pos(540,1415)}las dices
Dialogue: 0,0:00:06.35,0:00:07.35,B,,0,0,0,,{\pos(540,1415)}Sentir la emoción en vez
Dialogue: 0,0:00:07.35,0:00:08.00,B,,0,0,0,,{\pos(540,1415)}de taparla
Dialogue: 0,0:00:08.00,0:00:08.37,B,,0,0,0,,{\pos(540,1415)}muy
Dialogue: 0,0:00:08.37,0:00:09.42,B,,0,0,0,,{\pos(540,1415)}pero que muy importante
Dialogue: 0,0:00:09.42,0:00:10.04,B,,0,0,0,,{\pos(540,1415)}Porque lo que tapas
Dialogue: 0,0:00:10.04,0:00:10.79,B,,0,0,0,,{\pos(540,1415)}se queda dentro
Dialogue: 0,0:00:10.79,0:00:11.67,B,,0,0,0,,{\pos(540,1415)}y te sigue controlando
Dialogue: 0,0:00:11.67,0:00:12.30,B,,0,0,0,,{\pos(540,1415)}Pensar en positivo
Dialogue: 0,0:00:12.30,0:00:13.51,B,,0,0,0,,{\pos(540,1415)}a la fuerza no importa
Dialogue: 0,0:00:13.51,0:00:14.57,B,,0,0,0,,{\pos(540,1415)}Porque si sonríes por fuera
Dialogue: 0,0:00:14.57,0:00:15.44,B,,0,0,0,,{\pos(540,1415)}pero por dentro estás hecho
Dialogue: 0,0:00:15.44,0:00:15.92,B,,0,0,0,,{\pos(540,1415)}una mierda
Dialogue: 0,0:00:15.92,0:00:16.74,B,,0,0,0,,{\pos(540,1415)}tu energía no cambia
Dialogue: 0,0:00:16.74,0:00:17.76,B,,0,0,0,,{\pos(540,1415)}Cumplir lo que prometes
Dialogue: 0,0:00:17.76,0:00:18.71,B,,0,0,0,,{\pos(540,1415)}muy importante
Dialogue: 0,0:00:18.71,0:00:19.97,B,,0,0,0,,{\pos(540,1415)}Cuando cumples con tu palabra
Dialogue: 0,0:00:19.97,0:00:21.12,B,,0,0,0,,{\pos(540,1415)}empiezas a tener más confianza
Dialogue: 0,0:00:21.12,0:00:21.32,B,,0,0,0,,{\pos(540,1415)}en ti
Dialogue: 0,0:00:21.32,0:00:22.17,B,,0,0,0,,{\pos(540,1415)}Leer más libros
Dialogue: 0,0:00:22.17,0:00:23.12,B,,0,0,0,,{\pos(540,1415)}no importa si no aplicas
Dialogue: 0,0:00:23.12,0:00:23.38,B,,0,0,0,,{\pos(540,1415)}nada
Dialogue: 0,0:00:23.38,0:00:24.81,B,,0,0,0,,{\pos(540,1415)}Saberlo no implica cambiarlo
Dialogue: 0,0:00:24.81,0:00:25.74,B,,0,0,0,,{\pos(540,1415)}Lo que consumes
Dialogue: 0,0:00:25.74,0:00:26.69,B,,0,0,0,,{\pos(540,1415)}muy importante
Dialogue: 0,0:00:26.69,0:00:27.60,B,,0,0,0,,{\pos(540,1415)}Porque las noticias
Dialogue: 0,0:00:27.60,0:00:28.73,B,,0,0,0,,{\pos(540,1415)}el scroll y donde pones
Dialogue: 0,0:00:28.73,0:00:30.03,B,,0,0,0,,{\pos(540,1415)}tu atención se queda dentro
Dialogue: 0,0:00:30.03,0:00:30.25,B,,0,0,0,,{\pos(540,1415)}de ti
Dialogue: 0,0:00:30.25,0:00:31.35,B,,0,0,0,,{\pos(540,1415)}Que te aprueben los demás
Dialogue: 0,0:00:31.35,0:00:32.00,B,,0,0,0,,{\pos(540,1415)}no importa
Dialogue: 0,0:00:32.00,0:00:32.86,B,,0,0,0,,{\pos(540,1415)}Si tu valor depende
Dialogue: 0,0:00:32.86,0:00:33.60,B,,0,0,0,,{\pos(540,1415)}de cuántos me gustas
Dialogue: 0,0:00:33.60,0:00:34.54,B,,0,0,0,,{\pos(540,1415)}o cuántos seguidores tienes
Dialogue: 0,0:00:34.54,0:00:35.21,B,,0,0,0,,{\pos(540,1415)}o si agradas
Dialogue: 0,0:00:35.21,0:00:35.71,B,,0,0,0,,{\pos(540,1415)}a los demás
Dialogue: 0,0:00:35.71,0:00:36.62,B,,0,0,0,,{\pos(540,1415)}Todo tu valor depende
Dialogue: 0,0:00:36.62,0:00:37.26,B,,0,0,0,,{\pos(540,1415)}de lo externo
Dialogue: 0,0:00:37.26,0:00:38.07,B,,0,0,0,,{\pos(540,1415)}Mover tu cuerpo
Dialogue: 0,0:00:38.07,0:00:38.98,B,,0,0,0,,{\pos(540,1415)}muy importante
Dialogue: 0,0:00:38.98,0:00:39.55,B,,0,0,0,,{\pos(540,1415)}El ejercicio
