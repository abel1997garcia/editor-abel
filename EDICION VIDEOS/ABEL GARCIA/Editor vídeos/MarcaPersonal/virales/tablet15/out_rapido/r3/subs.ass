Dialogue: 0,0:00:00.01,0:00:00.33,B,,0,0,0,,{\pos(540,1415)}La mitad
Dialogue: 0,0:00:00.33,0:00:00.81,B,,0,0,0,,{\pos(540,1415)}de lo que haces
Dialogue: 0,0:00:00.81,0:00:01.73,B,,0,0,0,,{\pos(540,1415)}para quererte no sirve
Dialogue: 0,0:00:01.73,0:00:02.16,B,,0,0,0,,{\pos(540,1415)}de nada
Dialogue: 0,0:00:02.16,0:00:03.69,B,,0,0,0,,{\pos(540,1415)}Las afirmaciones no importan
Dialogue: 0,0:00:03.69,0:00:04.56,B,,0,0,0,,{\pos(540,1415)}si no te las crees
Dialogue: 0,0:00:04.56,0:00:05.02,B,,0,0,0,,{\pos(540,1415)}Lo que manda
Dialogue: 0,0:00:05.02,0:00:05.74,B,,0,0,0,,{\pos(540,1415)}es lo que sientes cuando
Dialogue: 0,0:00:05.74,0:00:06.31,B,,0,0,0,,{\pos(540,1415)}las dices
Dialogue: 0,0:00:06.31,0:00:07.31,B,,0,0,0,,{\pos(540,1415)}Sentir la emoción en vez
Dialogue: 0,0:00:07.31,0:00:07.95,B,,0,0,0,,{\pos(540,1415)}de taparla
Dialogue: 0,0:00:07.95,0:00:08.32,B,,0,0,0,,{\pos(540,1415)}muy
Dialogue: 0,0:00:08.32,0:00:09.37,B,,0,0,0,,{\pos(540,1415)}pero que muy importante
Dialogue: 0,0:00:09.37,0:00:10.00,B,,0,0,0,,{\pos(540,1415)}Porque lo que tapas
Dialogue: 0,0:00:10.00,0:00:10.72,B,,0,0,0,,{\pos(540,1415)}se queda dentro
Dialogue: 0,0:00:10.72,0:00:11.61,B,,0,0,0,,{\pos(540,1415)}y te sigue controlando
Dialogue: 0,0:00:11.61,0:00:12.25,B,,0,0,0,,{\pos(540,1415)}Pensar en positivo
Dialogue: 0,0:00:12.25,0:00:13.46,B,,0,0,0,,{\pos(540,1415)}a la fuerza no importa
Dialogue: 0,0:00:13.46,0:00:14.52,B,,0,0,0,,{\pos(540,1415)}Porque si sonríes por fuera
Dialogue: 0,0:00:14.52,0:00:15.38,B,,0,0,0,,{\pos(540,1415)}pero por dentro estás hecho
Dialogue: 0,0:00:15.38,0:00:15.87,B,,0,0,0,,{\pos(540,1415)}una mierda
Dialogue: 0,0:00:15.87,0:00:16.69,B,,0,0,0,,{\pos(540,1415)}tu energía no cambia
Dialogue: 0,0:00:16.69,0:00:17.72,B,,0,0,0,,{\pos(540,1415)}Cumplir lo que prometes
Dialogue: 0,0:00:17.72,0:00:18.65,B,,0,0,0,,{\pos(540,1415)}muy importante
Dialogue: 0,0:00:18.65,0:00:19.92,B,,0,0,0,,{\pos(540,1415)}Cuando cumples con tu palabra
Dialogue: 0,0:00:19.92,0:00:21.07,B,,0,0,0,,{\pos(540,1415)}empiezas a tener más confianza
Dialogue: 0,0:00:21.07,0:00:21.27,B,,0,0,0,,{\pos(540,1415)}en ti
