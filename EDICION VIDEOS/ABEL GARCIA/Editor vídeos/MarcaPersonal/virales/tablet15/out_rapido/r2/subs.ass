Dialogue: 0,0:00:00.10,0:00:00.62,B,,0,0,0,,{\pos(540,1415)}Lo que importa
Dialogue: 0,0:00:00.62,0:00:01.16,B,,0,0,0,,{\pos(540,1415)}y lo que no importa
Dialogue: 0,0:00:01.16,0:00:01.86,B,,0,0,0,,{\pos(540,1415)}para quererte
Dialogue: 0,0:00:01.86,0:00:03.39,B,,0,0,0,,{\pos(540,1415)}Las afirmaciones no importan
Dialogue: 0,0:00:03.39,0:00:04.26,B,,0,0,0,,{\pos(540,1415)}si no te las crees
Dialogue: 0,0:00:04.26,0:00:04.72,B,,0,0,0,,{\pos(540,1415)}Lo que manda
Dialogue: 0,0:00:04.72,0:00:05.44,B,,0,0,0,,{\pos(540,1415)}es lo que sientes cuando
Dialogue: 0,0:00:05.44,0:00:06.01,B,,0,0,0,,{\pos(540,1415)}las dices
Dialogue: 0,0:00:06.01,0:00:07.01,B,,0,0,0,,{\pos(540,1415)}Sentir la emoción en vez
Dialogue: 0,0:00:07.01,0:00:07.65,B,,0,0,0,,{\pos(540,1415)}de taparla
Dialogue: 0,0:00:07.65,0:00:08.02,B,,0,0,0,,{\pos(540,1415)}muy
Dialogue: 0,0:00:08.02,0:00:09.07,B,,0,0,0,,{\pos(540,1415)}pero que muy importante
Dialogue: 0,0:00:09.07,0:00:09.69,B,,0,0,0,,{\pos(540,1415)}Porque lo que tapas
Dialogue: 0,0:00:09.69,0:00:10.44,B,,0,0,0,,{\pos(540,1415)}se queda dentro
Dialogue: 0,0:00:10.44,0:00:11.31,B,,0,0,0,,{\pos(540,1415)}y te sigue controlando
Dialogue: 0,0:00:11.31,0:00:11.95,B,,0,0,0,,{\pos(540,1415)}Pensar en positivo
Dialogue: 0,0:00:11.95,0:00:13.16,B,,0,0,0,,{\pos(540,1415)}a la fuerza no importa
Dialogue: 0,0:00:13.16,0:00:14.22,B,,0,0,0,,{\pos(540,1415)}Porque si sonríes por fuera
Dialogue: 0,0:00:14.22,0:00:15.10,B,,0,0,0,,{\pos(540,1415)}pero por dentro estás hecho
Dialogue: 0,0:00:15.10,0:00:15.57,B,,0,0,0,,{\pos(540,1415)}una mierda
Dialogue: 0,0:00:15.57,0:00:16.38,B,,0,0,0,,{\pos(540,1415)}tu energía no cambia
Dialogue: 0,0:00:16.38,0:00:17.42,B,,0,0,0,,{\pos(540,1415)}Cumplir lo que prometes
Dialogue: 0,0:00:17.42,0:00:18.35,B,,0,0,0,,{\pos(540,1415)}muy importante
Dialogue: 0,0:00:18.35,0:00:19.61,B,,0,0,0,,{\pos(540,1415)}Cuando cumples con tu palabra
Dialogue: 0,0:00:19.61,0:00:20.77,B,,0,0,0,,{\pos(540,1415)}empiezas a tener más confianza
Dialogue: 0,0:00:20.77,0:00:20.96,B,,0,0,0,,{\pos(540,1415)}en ti
Dialogue: 0,0:00:20.96,0:00:21.78,B,,0,0,0,,{\pos(540,1415)}Leer más libros
Dialogue: 0,0:00:21.78,0:00:22.76,B,,0,0,0,,{\pos(540,1415)}no importa si no aplicas
Dialogue: 0,0:00:22.76,0:00:23.03,B,,0,0,0,,{\pos(540,1415)}nada
Dialogue: 0,0:00:23.03,0:00:24.45,B,,0,0,0,,{\pos(540,1415)}Saberlo no implica cambiarlo
Dialogue: 0,0:00:24.45,0:00:25.38,B,,0,0,0,,{\pos(540,1415)}Lo que consumes
Dialogue: 0,0:00:25.38,0:00:26.33,B,,0,0,0,,{\pos(540,1415)}muy importante
Dialogue: 0,0:00:26.33,0:00:27.23,B,,0,0,0,,{\pos(540,1415)}Porque las noticias
Dialogue: 0,0:00:27.23,0:00:28.36,B,,0,0,0,,{\pos(540,1415)}el scroll y donde pones
Dialogue: 0,0:00:28.36,0:00:29.54,B,,0,0,0,,{\pos(540,1415)}tu atención se queda dentro
Dialogue: 0,0:00:29.54,0:00:29.90,B,,0,0,0,,{\pos(540,1415)}de ti
Dialogue: 0,0:00:29.90,0:00:31.01,B,,0,0,0,,{\pos(540,1415)}Que te aprueben los demás
Dialogue: 0,0:00:31.01,0:00:31.65,B,,0,0,0,,{\pos(540,1415)}no importa
Dialogue: 0,0:00:31.65,0:00:32.51,B,,0,0,0,,{\pos(540,1415)}Si tu valor depende
Dialogue: 0,0:00:32.51,0:00:33.25,B,,0,0,0,,{\pos(540,1415)}de cuántos me gustas
Dialogue: 0,0:00:33.25,0:00:34.19,B,,0,0,0,,{\pos(540,1415)}o cuántos seguidores tienes
Dialogue: 0,0:00:34.19,0:00:34.85,B,,0,0,0,,{\pos(540,1415)}o si agradas
Dialogue: 0,0:00:34.85,0:00:35.36,B,,0,0,0,,{\pos(540,1415)}a los demás
