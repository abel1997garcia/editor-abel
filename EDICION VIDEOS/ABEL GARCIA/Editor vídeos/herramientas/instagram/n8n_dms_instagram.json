   "name": "OK a Meta",
   "type": "n8n-nodes-base.respondToWebhook",
   "typeVersion": 1.1,
   "position": [
    240,
    120
   ]
  },
  {
   "parameters": {
    "jsCode": "// Cada DM que te llega (no los que envías tú): fecha, quién (solo su id), texto y, si comparte un reel, cuál.\n// Acepta los dos formatos de Meta: DMs reales (entry.messaging) y el botón «Test» del panel (entry.changes.value)\nconst out = [];\nfor (const e of ($json.body?.entry || [])) {\n  const eventos = [...(e.messaging || []), ...(e.changes || []).filter(c => c.field === 'messages').map(c => c.value)];\n  for (const m of eventos) {\n    const msg = m?.message; if (!msg || msg.is_echo) continue;\n    const ts = Number(m.timestamp); const fecha = new Date(ts < 1e12 ? ts * 1000 : ts);\n    const reel = (msg.attachments || []).find(a => ['ig_reel', 'reel', 'share', 'story_mention'].includes(a.type));\n    out.push({ json: { fecha: fecha.toISOString().slice(0, 16).replace('T', ' '), persona_id: String(m.sender?.id || ''),\n      mensaje: (msg.text || (reel ? '[comparte una publicación]' : '[adjunto]')).slice(0, 300),\n      reel_compartido: reel ? (reel.payload?.reel_video_id || reel.payload?.url || reel.payload?.title || reel.type) : '', mid: msg.mid || '' } });\n  }\n}\nreturn out;"
   },
   "name": "Leer el DM",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    480,
    120
   ]
  },
