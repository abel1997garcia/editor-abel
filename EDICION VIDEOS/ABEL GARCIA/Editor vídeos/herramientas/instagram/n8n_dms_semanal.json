  },
  {
   "parameters": {
    "jsCode": "// DMs por reel (conversaciones que empezaron gracias a ese reel) -> columna DMs de la pestaña Reels\nconst n = {};\nfor (const it of $('DMs de cada conversación').all()) if (it.json._reel) n[it.json._reel] = (n[it.json._reel] || 0) + 1;\nconst reels = $('Mis reels').all().map(i => i.json).flatMap(j => j.data || []).filter(m => m.media_product_type === 'REELS');\nreturn reels.map(m => ({ json: { id: 'ig_' + m.id, DMs: n['ig_' + m.id] || 0 } }));"
   },
