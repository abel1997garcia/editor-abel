{
 "segmentos": [
  {
   "start": 0.0,
   "end": 0.36,
   "text": "Da miedo."
  },
  {
   "start": 0.54,
   "end": 2.2,
   "text": "Y hay alguien que va con ella en la ambulancia."
  },
  {
   "start": 2.24,
   "end": 2.48,
   "text": "¿Es así?"
  },
  {
   "start": 3.36,
   "end": 3.72,
   "text": "Sí."
  },
  {
   "start": 4.02,
   "end": 5.06,
   "text": "Esa es la mano, ¿no?"
  },
  {
   "start": 5.58,
   "end": 7.54,
   "text": "Mi hija fue con ella en la ambulancia."
  },
  {
   "start": 7.7,
   "end": 9.5,
   "text": "También hay una mano que la tranquiliza."
  },
  {
   "start": 9.56,
   "end": 9.88,
   "text": "Eso es."
  },
  {
   "start": 10.0,
   "end": 11.84,
   "text": "Ella, Elsa, te sonríe."
  },
  {
   "start": 11.88,
   "end": 13.04,
   "text": "Dice que ella está muy bien."
  },
  {
   "start": 13.9,
   "end": 14.66,
   "text": "No sé por qué."
  },
  {
   "start": 14.72,
   "end": 17.38,
   "text": "Me dice que te hable de flores, que te diga algo de flores."
  },
  {
   "start": 17.4,
   "end": 18.94,
   "text": "Muchas flores, como que le encuentran."
  },
  {
   "start": 18.96,
   "end": 20.3,
   "text": "Pero ella no pudo despedirse."
  },
  {
   "start": 20.44,
   "end": 24.34,
   "text": "Y dice que le dio mucha pena, como mucha tristeza no poder despedir."
  },
  {
   "start": 24.36,
   "end": 25.8,
   "text": "Ella no pudo decir nada."
  },
  {
   "start": 25.8,
   "end": 32.92,
   "text": "hay un momento en el que ella es sedada o inducida a algo porque ella me dice como que ya no recuerda"
  },
  {
   "start": 32.92,
   "end": 39.92,
   "text": "a partir de no recuerda y un día antes le pusieron una una sonda naso no son astrid"
  },
  {
   "start": 42.48,
   "end": 51.66,
   "text": "y ya no pudimos conversar con ella eso fue en la noche y en la mañana falleció hay un momento en"
  },
  {
   "start": 51.66,
   "end": 55.26,
   "text": "en el que ella ya es inducida a algo y ella ya no puede, ya no puede despedirse."
  }
 ],
