{
 "segmentos": [
  {
   "start": 0.0,
   "end": 2.28,
   "text": "Me ha mostrado un pájaro muy pequeño, muy redondito."
  },
  {
   "start": 2.4,
   "end": 5.02,
   "text": "No sé, me lo ha mostrado él y está posado en algún sitio."
  },
  {
   "start": 5.3,
   "end": 10.04,
   "text": "Fui a la Virgen de Lourdes y me pasó eso en las manos de la Virgen."
  },
  {
   "start": 10.28,
   "end": 12.06,
   "text": "Se posó un pajarito."
  },
  {
   "start": 12.1,
   "end": 12.66,
   "text": "Era él."
  },
  {
   "start": 13.24,
   "end": 15.52,
   "text": "Sí, tiene que ver con él, tiene que ver con él."
  },
  {
   "start": 15.6,
   "end": 16.44,
   "text": "Está muy bien."
  },
  {
   "start": 16.84,
   "end": 18.82,
   "text": "Dice él, hay que seguir adelante, dice esa frase."
  },
  {
   "start": 18.88,
   "end": 20.16,
   "text": "Hay que seguir adelante, hay que seguir adelante."
  },
  {
   "start": 20.74,
   "end": 22.24,
   "text": "Era una figura muy importante."
  },
  {
   "start": 22.46,
   "end": 25.44,
   "text": "Él es como un pilar muy importante que ayudaba a todos."
  },
  {
   "start": 26.02,
   "end": 28.18,
   "text": "Y él me dice que, bueno, que hay que seguir adelante."
  },
  {
   "start": 28.18,
   "end": 34.24,
   "text": "pero que él está bien insiste mucho que está muy bien que él está intentando ayudar os intenta"
  },
  {
   "start": 34.24,
   "end": 40.66,
   "text": "visitar o sea es bastante activo él se mueve bastante y hace bastantes cosas y me gustan"
  },
  {
   "start": 40.66,
   "end": 46.06,
   "text": "mucho los niños es que es como los pequeños es como sus debilidades él quiere acomodarte"
  },
  {
   "start": 46.06,
   "end": 49.7,
   "text": "ese abrazo no como que te intentarte ese abrazo para que te quedes tranquila"
  },
  {
   "start": 51.36,
   "end": 53.14,
   "text": "su pedacito de cielo"
  },
  {
   "start": 53.14,
   "end": 54.18,
   "text": "es Josefina"
  },
  {
   "start": 54.18,
   "end": 57.02,
   "text": "que nosotros sabemos que venía"
  },
  {
   "start": 57.02,
   "end": 58.64,
   "text": "le habéis puesto varias velas"
  },
  {
   "start": 58.64,
   "end": 60.42,
   "text": "veo como dos velas"
  },
  {
   "start": 60.42,
   "end": 63.2,
   "text": "dos o tres velitas juntas"
  },
  {
   "start": 63.86,
   "end": 65.22,
   "text": "y él está contento"
  },
  {
   "start": 65.22,
   "end": 65.9,
   "text": "con sus velas"
  },
  {
   "start": 65.9,
   "end": 68.52,
   "text": "a él le gustan mucho esas cosas"
  }
 ],
