 "subtitulos": [
  {
   "t0": 0.0,
   "txt": "Realmente no somos humanos",
   "a": 820,
   "b": 823,
   "t1": 2.033333333333333
  },
  {
   "t0": 2.033333333333333,
   "txt": "somos almas",
   "a": 825,
   "b": 826,
   "t1": 3.2333333333333334
  },
  {
   "t0": 3.2333333333333334,
   "txt": "viviendo en un cuerpo",
   "a": 827,
   "b": 830,
   "t1": 4.9
  },
  {
   "t0": 4.9,
   "txt": "Y es muy normal",
   "a": 726,
   "b": 729,
   "t1": 6.466666666666667
  },
  {
   "t0": 6.466666666666667,
   "txt": "el no entender",
   "a": 730,
   "b": 732,
   "t1": 6.9
  },
  {
   "t0": 6.9,
   "txt": "por qué permiten",
   "a": 733,
   "b": 735,
   "t1": 7.833333333333333
  },
  {
   "t0": 7.833333333333333,
   "txt": "que sucedan cosas",
   "a": 736,
   "b": 738,
   "t1": 8.9
  },
  {
   "t0": 8.9,
   "txt": "o desgracias en las familias",
   "a": 739,
   "b": 743,
   "t1": 10.566666666666666
  },
  {
   "t0": 10.566666666666666,
   "txt": "Pero ahí tenemos que hablar",
   "a": 744,
   "b": 748,
   "t1": 11.366666666666667
  },
  {
   "t0": 11.366666666666667,
   "txt": "del libre albedrío",
   "a": 749,
   "b": 751,
   "t1": 12.466666666666667
  },
  {
   "t0": 12.466666666666667,
   "txt": "Hay una especie de contrato",
   "a": 761,
   "b": 765,
   "t1": 14.133333333333333
  },
  {
   "t0": 14.133333333333333,
   "txt": "no plasmado pero sí existente",
   "a": 766,
   "b": 770,
   "t1": 16.9
  },
  {
   "t0": 16.9,
   "txt": "donde no pueden interferir",
   "a": 771,
   "b": 774,
   "t1": 19.133333333333333
  },
  {
   "t0": 19.133333333333333,
   "txt": "en lo que tenga que ocurrirnos",
   "a": 775,
   "b": 780,
   "t1": 20.966666666666665
  },
  {
   "t0": 20.966666666666665,
   "txt": "o el aprendizaje",
   "a": 781,
   "b": 783,
   "t1": 21.633333333333333
  },
  {
   "t0": 21.633333333333333,
   "txt": "por el que tengamos",
   "a": 784,
   "b": 787,
   "t1": 22.233333333333334
  },
  {
   "t0": 22.233333333333334,
   "txt": "que atravesar",
   "a": 788,
   "b": 789,
   "t1": 23.2
  },
  {
   "t0": 23.2,
   "txt": "Nosotros vemos la vida",
   "a": 790,
   "b": 793,
   "t1": 24.566666666666666
  },
  {
   "t0": 24.566666666666666,
   "txt": "como si esto fuese lo único",
   "a": 794,
   "b": 799,
   "t1": 27.133333333333333
  },
  {
   "t0": 27.133333333333333,
   "txt": "o como si el ser humano",
   "a": 800,
   "b": 805,
   "t1": 29.0
  },
  {
   "t0": 29.0,
   "txt": "es lo único que existe",
   "a": 806,
   "b": 810,
   "t1": 31.033333333333335
  },
  {
   "t0": 31.033333333333335,
   "txt": "no hay nada más",
   "a": 811,
   "b": 814,
   "t1": 32.1
  },
  {
   "t0": 32.1,
   "txt": "pero para nada es así",
   "a": 815,
   "b": 819,
   "t1": 33.36666666666667
  },
  {
   "t0": 33.36666666666667,
   "txt": "Tenemos que tener",
   "a": 846,
   "b": 848,
   "t1": 33.86666666666667
  },
  {
   "t0": 33.86666666666667,
   "txt": "un cuerpo material",
   "a": 849,
   "b": 851,
   "t1": 34.766666666666666
  },
  {
   "t0": 34.766666666666666,
   "txt": "porque si no",
   "a": 852,
   "b": 854,
   "t1": 35.2
  },
  {
   "t0": 35.2,
   "txt": "no podríamos vivir",
   "a": 855,
   "b": 857,
   "t1": 36.0
  },
  {
   "t0": 36.0,
   "txt": "esta experiencia",
   "a": 858,
   "b": 859,
   "t1": 37.233333333333334
  },
  {
   "t0": 37.233333333333334,
   "txt": "Entonces se nos olvida",
   "a": 860,
   "b": 863,
   "t1": 38.833333333333336
  },
  {
   "t0": 38.833333333333336,
   "txt": "que realmente la importancia",
   "a": 864,
   "b": 867,
   "t1": 39.96666666666667
  },
  {
   "t0": 39.96666666666667,
   "txt": "es el alma",
   "a": 868,
   "b": 870,
   "t1": 40.766666666666666
  },
  {
   "t0": 40.766666666666666,
   "txt": "y no es la funda",
   "a": 871,
   "b": 875,
   "t1": 41.733333333333334
  },
  {
   "t0": 41.733333333333334,
   "txt": "el cuerpo",
   "a": 876,
   "b": 877,
   "t1": 42.4
  },
  {
   "t0": 42.4,
   "txt": "Por eso muchas veces",
   "a": 887,
   "b": 890,
   "t1": 43.833333333333336
  },
  {
   "t0": 43.833333333333336,
   "txt": "si el camino del alma",
   "a": 891,
   "b": 895,
   "t1": 45.03333333333333
  },
  {
   "t0": 45.03333333333333,
   "txt": "es un camino corto",
   "a": 896,
   "b": 899,
   "t1": 46.233333333333334
  },
  {
   "t0": 46.233333333333334,
   "txt": "tiene que ser así",
   "a": 901,
   "b": 904,
   "t1": 47.4
  },
  {
   "t0": 47.4,
   "txt": "porque ese alma ya lo pactó",
   "a": 905,
   "b": 910,
   "t1": 49.0
  },
  {
   "t0": 49.0,
   "txt": "o porque es mejor así",
   "a": 911,
   "b": 915,
   "t1": 50.3
  },
  {
   "t0": 50.3,
   "txt": "si de alguna forma",
   "a": 916,
   "b": 919,
   "t1": 51.63333333333333
  },
  {
   "t0": 51.63333333333333,
   "txt": "el aprendizaje",
   "a": 920,
   "b": 921,
   "t1": 52.766666666666666
  },
  {
   "t0": 52.766666666666666,
   "txt": "o lo que ese alma",
