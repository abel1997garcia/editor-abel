 "subtitulos": [
  {
   "t0": 0.0,
   "txt": "Tú un día vas a ser médium",
   "a": 1616,
   "b": 1622,
   "t1": 1.4666666666666666
  },
  {
   "t0": 1.4666666666666666,
   "txt": "y vas a ayudar a otras personas",
   "a": 1623,
   "b": 1629,
   "t1": 3.533333333333333
  },
  {
   "t0": 3.533333333333333,
   "txt": "Vas a dejar tu trabajo",
   "a": 1630,
   "b": 1634,
   "t1": 4.3
  },
  {
   "t0": 4.3,
   "txt": "y te vas a dedicar a esto",
   "a": 1635,
   "b": 1641,
   "t1": 5.433333333333334
  },
  {
   "t0": 5.433333333333334,
   "txt": "En esos días también descubrí a Raúl",
   "a": 1318,
   "b": 1324,
   "t1": 8.5
  },
  {
   "t0": 8.5,
   "txt": "por Instagram Raúl Vaquero",
   "a": 1325,
   "b": 1328,
   "t1": 10.433333333333334
  },
  {
   "t0": 10.433333333333334,
   "txt": "que hoy en día es mi amigo y maestro",
   "a": 1329,
   "b": 1337,
   "t1": 12.633333333333333
  },
  {
   "t0": 12.633333333333333,
   "txt": "Fui a conocerlo",
   "a": 1341,
   "b": 1343,
   "t1": 13.533333333333333
  },
  {
   "t0": 13.533333333333333,
   "txt": "fui a que me firmase un libro",
   "a": 1344,
   "b": 1350,
   "t1": 15.266666666666667
  },
  {
   "t0": 15.266666666666667,
   "txt": "Y yo llegué allí con mi libro",
   "a": 1402,
   "b": 1408,
   "t1": 16.966666666666665
  },
  {
   "t0": 16.966666666666665,
   "txt": "y recuerdo que tuve",
   "a": 1409,
   "b": 1412,
   "t1": 17.9
  },
  {
   "t0": 17.9,
   "txt": "una sensación por el camino",
   "a": 1413,
   "b": 1417,
   "t1": 19.6
  },
  {
   "t0": 19.6,
   "txt": "una energía que me atravesaba el pecho",
   "a": 1418,
   "b": 1424,
   "t1": 21.766666666666666
  },
  {
   "t0": 21.766666666666666,
   "txt": "Y dije",
   "a": 1429,
   "b": 1430,
   "t1": 22.5
  },
  {
   "t0": 22.5,
   "txt": "si esto es lo que estoy esperando",
   "a": 1431,
   "b": 1437,
   "t1": 24.466666666666665
  },
  {
   "t0": 24.466666666666665,
   "txt": "o aquí hay alguna pista",
   "a": 1438,
   "b": 1442,
   "t1": 25.866666666666667
  },
  {
   "t0": 25.866666666666667,
   "txt": "de qué es lo que me pasa",
   "a": 1443,
   "b": 1449,
   "t1": 26.933333333333334
  },
  {
   "t0": 26.933333333333334,
   "txt": "y qué tengo que hacer",
   "a": 1450,
   "b": 1454,
   "t1": 27.933333333333334
  },
  {
   "t0": 27.933333333333334,
   "txt": "por favor le pedí a Dios",
   "a": 1457,
   "b": 1462,
   "t1": 29.233333333333334
  },
  {
   "t0": 29.233333333333334,
   "txt": "por favor mándame la señal",
   "a": 1463,
   "b": 1467,
   "t1": 31.1
  },
  {
   "t0": 31.1,
   "txt": "que yo pueda comprender",
   "a": 1468,
   "b": 1471,
   "t1": 32.36666666666667
  },
  {
   "t0": 32.36666666666667,
   "txt": "que pueda entender",
   "a": 1472,
   "b": 1474,
   "t1": 33.5
  },
  {
   "t0": 33.5,
   "txt": "Y sucedió la magia",
   "a": 1477,
   "b": 1480,
   "t1": 34.63333333333333
  },
  {
   "t0": 34.63333333333333,
   "txt": "Y recuerdo que entré",
   "a": 1505,
   "b": 1508,
   "t1": 35.733333333333334
  },
  {
   "t0": 35.733333333333334,
   "txt": "y se dio la vuelta y me miró",
   "a": 1509,
   "b": 1516,
   "t1": 37.9
  },
  {
   "t0": 37.9,
   "txt": "y vino y me dijo",
   "a": 1517,
   "b": 1521,
   "t1": 39.06666666666667
  },
  {
   "t0": 39.06666666666667,
   "txt": "¿nos conocemos de algo?",
   "a": 1522,
   "b": 1525,
   "t1": 40.5
  },
  {
   "t0": 40.5,
   "txt": "Yo le dije no yo no",
   "a": 1526,
   "b": 1531,
   "t1": 41.666666666666664
  },
  {
   "t0": 41.666666666666664,
   "txt": "pero yo a ti sí",
   "a": 1539,
   "b": 1543,
   "t1": 42.4
  },
  {
   "t0": 42.4,
   "txt": "te veo en redes sociales",
   "a": 1544,
   "b": 1548,
   "t1": 43.43333333333333
  },
  {
   "t0": 43.43333333333333,
   "txt": "Me firmó el libro",
   "a": 1558,
   "b": 1561,
   "t1": 44.06666666666667
  },
  {
   "t0": 44.06666666666667,
   "txt": "y me dijo quédate con nosotros",
   "a": 1562,
   "b": 1567,
   "t1": 45.5
  },
  {
   "t0": 45.5,
   "txt": "no te vayas",
   "a": 1568,
   "b": 1570,
   "t1": 46.166666666666664
  },
  {
   "t0": 46.166666666666664,
   "txt": "Yo la verdad que me sorprendí mucho",
   "a": 1642,
   "b": 1648,
   "t1": 47.93333333333333
  },
  {
   "t0": 47.93333333333333,
   "txt": "y tengo que confesar que no le creí",
   "a": 1649,
   "b": 1656,
   "t1": 49.8
  },
  {
   "t0": 49.8,
   "txt": "porque yo pensé que se había",
   "a": 1657,
   "b": 1662,
   "t1": 51.13333333333333
  },
  {
   "t0": 51.13333333333333,
   "txt": "confundido con otra persona",
   "a": 1663,
   "b": 1666,
   "t1": 52.46666666666667
  },
  {
   "t0": 52.46666666666667,
   "txt": "que no era yo",
   "a": 1667,
   "b": 1670,
   "t1": 53.2
  },
  {
   "t0": 53.2,
   "txt": "Yo le dije que yo sentía cosas",
   "a": 1671,
   "b": 1677,
   "t1": 54.733333333333334
  },
  {
   "t0": 54.733333333333334,
   "txt": "que había sentido alguna vez",
   "a": 1678,
   "b": 1682,
   "t1": 56.0
  },
  {
   "t0": 56.0,
   "txt": "Él se reía",
   "a": 1697,
   "b": 1699,
   "t1": 57.0
  },
  {
   "t0": 57.0,
   "txt": "Me dijo que le hiciese caso",
   "a": 1700,
   "b": 1705,
   "t1": 59.5
  },
  {
   "t0": 59.5,
   "txt": "Y la verdad que le hice caso",
