   "b": 1265,
   "t1": 2.9
  },
  {
   "t0": 2.9,
   "txt": "que un sueño",
   "a": 1266,
   "b": 1268,
   "t1": 3.8333333333333335
  },
  {
   "t0": 3.8333333333333335,
   "txt": "donde hablamos con ellos",
   "a": 1269,
   "b": 1272,
   "t1": 4.966666666666667
  },
  {
   "t0": 4.966666666666667,
   "txt": "y donde podemos recordar",
   "a": 1273,
   "b": 1276,
   "t1": 6.1
  },
  {
   "t0": 6.1,
   "txt": "exactamente todo",
   "a": 1277,
   "b": 1278,
   "t1": 7.6
  },
  {
   "t0": 7.6,
   "txt": "todas las palabras",
   "a": 1281,
   "b": 1283,
   "t1": 9.166666666666666
  },
  {
   "t0": 9.166666666666666,
   "txt": "todo lo que se ve",
   "a": 1284,
   "b": 1288,
   "t1": 10.5
  },
  {
   "t0": 10.5,
   "txt": "todo lo que se siente",
   "a": 1289,
   "b": 1293,
   "t1": 11.233333333333333
  },
  {
   "t0": 11.233333333333333,
   "txt": "en el sueño",
   "a": 1294,
   "b": 1296,
   "t1": 11.833333333333334
  },
  {
   "t0": 11.833333333333334,
   "txt": "incluso la temperatura el olor",
   "a": 1297,
   "b": 1301,
   "t1": 14.3
  },
  {
   "t0": 14.3,
   "txt": "la textura",
   "a": 1302,
   "b": 1303,
   "t1": 15.2
  },
  {
   "t0": 15.2,
   "txt": "Eso nos indica",
   "a": 1306,
   "b": 1308,
   "t1": 16.233333333333334
  },
  {
   "t0": 16.233333333333334,
   "txt": "que realmente no es un sueño",
   "a": 1309,
   "b": 1314,
   "t1": 18.4
  },
  {
   "t0": 18.4,
   "txt": "sino que es",
   "a": 1325,
   "b": 1327,
   "t1": 19.433333333333334
  },
  {
   "t0": 19.433333333333334,
   "txt": "una experiencia de encuentro",
   "a": 1328,
   "b": 1331,
   "t1": 21.533333333333335
  },
  {
   "t0": 21.533333333333335,
   "txt": "donde ellos se acercan",
   "a": 1332,
   "b": 1335,
   "t1": 23.266666666666666
  },
  {
   "t0": 23.266666666666666,
   "txt": "y nos hablan o nos ayudan",
   "a": 1336,
   "b": 1341,
   "t1": 25.966666666666665
  },
  {
   "t0": 25.966666666666665,
   "txt": "No siempre",
   "a": 1168,
   "b": 1169,
   "t1": 26.366666666666667
  },
  {
   "t0": 26.366666666666667,
   "txt": "que soñemos con ellos",
   "a": 1170,
   "b": 1173,
   "t1": 27.133333333333333
  },
  {
   "t0": 27.133333333333333,
   "txt": "quiere decir que son",
   "a": 1174,
   "b": 1177,
   "t1": 28.7
  },
  {
   "t0": 28.7,
   "txt": "ellos realmente",
   "a": 1178,
   "b": 1179,
   "t1": 29.6
  },
  {
   "t0": 29.6,
   "txt": "Y tenemos esos",
   "a": 1222,
   "b": 1224,
   "t1": 30.0
  },
  {
   "t0": 30.0,
   "txt": "sueños tan extraños",
   "a": 1225,
   "b": 1227,
   "t1": 31.133333333333333
  },
  {
   "t0": 31.133333333333333,
   "txt": "donde les vemos sufriendo",
