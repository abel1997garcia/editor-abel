 "subtitulos": [
  {
   "t0": 0.0,
   "txt": "Cuando hay sueños",
   "a": 1257,
   "b": 1259,
   "t1": 1.5333333333333334
  },
  {
   "t0": 1.5333333333333334,
   "txt": "que sabemos que es más real",
