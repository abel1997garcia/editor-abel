   "b": 1247,
   "t1": 36.5
  },
  {
   "t0": 36.5,
   "txt": "preocupaciones",
   "a": 1248,
   "b": 1248,
   "t1": 37.1
  },
  {
   "t0": 37.1,
   "txt": "y nuestros miedos",
   "a": 1249,
